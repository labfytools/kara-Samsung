#!/usr/bin/python3 -B
"""Classe des fichiers audio dans Artiste/Album à partir de leurs tags."""
import argparse
from collections import defaultdict
from contextlib import closing, contextmanager, nullcontext
import json
from errno import EXDEV
from hashlib import file_digest
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
from tempfile import TemporaryDirectory
from time import time

from _kara_import_local import stamp
from _kara_import_resources import ImportPause, ImportSuspended, checkpoint, lease, run_checked
from _musique_oz import (INBOX, UNKNOWN_ALBUM, UNKNOWN_ARTIST, album_groups, audio_file, audio_files,
                         canonical_album_artist, component, index_file, manual_album_artist, mutation_report,
                         probe, share_file, shared_mutation, SHARED_LIBRARY, source_video, title_pair)
from _parole_artist_tags import WRITABLE as TAG_WRITABLE, has_preparation, remux, save_original, verify_audio
from _parole_index import document, revision


def same_content(first, second):
    if not second.is_file() or second.is_symlink():
        return False
    if first.stat().st_size != second.stat().st_size:
        return False
    with first.open("rb") as source, second.open("rb") as target:
        return file_digest(source, "sha256").digest() == file_digest(target, "sha256").digest()


def same_import_track(source, target, tags):
    url = tags.get("purl")
    if not url or not target.is_file() or target.is_symlink():
        return False
    try:
        target_tags, _ = probe(target)
        if target_tags.get("purl") != url:
            return False
        hashes = []
        for track in (source, target):
            result = run_checked(
                ("ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "file,pipe",
                 "-i", str(track), "-map", "0:a:0", "-c", "copy", "-f", "hash", "-hash", "sha256", "pipe:1"),
                capture_output=True, check=True, timeout=30,
            )
            hashes.append(result.stdout)
        return bool(hashes[0]) and hashes[0] == hashes[1]
    except (OSError, ValueError, subprocess.SubprocessError):
        return False


def indexed_tags(root, folder):
    database = index_file(root)
    try:
        with closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=.15)) as db:
            return {path: (token, json.loads(info).get("tags", {})) for path, token, info in db.execute(
                "SELECT path,token,info FROM songs WHERE path>=? AND path<?",
                (str(folder) + "/", str(folder) + "0"))}
    except (ValueError, sqlite3.Error):
        return {}


def publish_import(draft, target):
    # The recovery receipt is recorded before publication. Sync the audio and
    # directory before removing its staging source so a power loss can replay it.
    os.link(draft, target)
    sync_dir(target.parent)
    sync_dir(target.parent.parent)
    sync_dir(target.parent.parent.parent)


def sync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def sync_file(path):
    with open(path, "rb") as media:
        os.fsync(media.fileno())


def move_track(source, target, recover=False, *, admission):
    if not target.is_relative_to(SHARED_LIBRARY):
        try:
            with admission():
                os.link(source, target)
                source.unlink()
        except OSError as error:
            if error.errno != EXDEV:
                raise
        else:
            return
    with TemporaryDirectory(dir=target.parent, prefix=".tri-") as temporary:
        draft = Path(temporary) / target.name
        if target.is_relative_to(SHARED_LIBRARY):
            shutil.copyfile(source, draft)
            share_file(draft, target)
        else:
            shutil.copy2(source, draft)
        if recover:
            sync_file(draft)
        with admission():
            (publish_import if recover else os.link)(draft, target)
            # Unlink the staging name before taking the receipt's ctime.
            draft.unlink()
            source.unlink()


def number(tag):
    match = re.fullmatch(r"(\d{1,3})(?:/\d{1,3})?", tag or "")
    return int(match[1]) if match else 0


def album_artists(items, root):
    credits = defaultdict(set)
    for _, tags in items:
        artist, album = title_pair(tags)
        if artist and album:
            credits[album].add(artist)

    existing = {}
    for album in credits:
        directory = component(album, UNKNOWN_ALBUM)
        existing[album] = {
            artist.name.casefold()
            for artist in root.iterdir()
            if not artist.is_symlink()
            and (artist / directory).is_dir()
            and not (artist / directory).is_symlink()
        }

    resolved = {}
    for track, tags in items:
        artist, album = title_pair(tags)
        if artist and album and not tags.get("albumartist"):
            # Garde les collaborations permanentes et ne déduit un featuring
            # que si le crédit de base est attesté pour ce même album.
            parts = artist.split(", ")
            def known_credit(credit):
                return (credit in credits[album] or
                        component(credit, UNKNOWN_ARTIST).casefold() in existing[album])

            prefixes = (", ".join(parts[:end]) for end in range(1, len(parts)))
            prefix = next((credit for credit in prefixes if known_credit(credit)), None)
            if prefix is not None:
                artist = prefix
            else:
                # Certains crédits placent l’invité en tête. Le crédit de
                # fin doit être unique et attesté pour ce même album.
                suffixes = (", ".join(parts[start:]) for start in range(1, len(parts)))
                matches = {credit for credit in suffixes if known_credit(credit)}
                if len(matches) == 1:
                    artist = matches.pop()
        resolved[track] = canonical_album_artist(artist, album, artist_id=tags.get("musicbrainzalbumartistid"))
    return resolved


def write_tags(source, target, tags, updates, recover=False, *, admission, approved=False, backup=False):
    token = revision(source.lstat())
    if backup and has_preparation(source):
        raise ValueError("une préparation liée à ce fichier doit être préservée")
    with TemporaryDirectory(dir=target.parent, prefix=".tri-") as temp:
        draft = Path(temp) / source.name
        new_tags = remux(source, draft, tags, updates)
        if approved or backup:
            pcm = verify_audio(source, draft, preserve_all=backup)
            if backup:
                save_original(source, draft, token, pcm)
        shutil.copymode(source, draft)
        share_file(draft, target)
        if source == target or recover:
            sync_file(draft)
        with admission(new_tags):
            if revision(source.lstat()) != token:
                raise ValueError("fichier modifié pendant la vérification")
            if backup and has_preparation(source):
                raise ValueError("une préparation a été publiée pendant la vérification")
            if source == target:
                os.replace(draft, target)
                sync_dir(target.parent)
            else:
                (publish_import if recover else os.link)(draft, target)
                draft.unlink()
                source.unlink()
        return new_tags


def target_parts(source, tags, artist, album):
    title = component(tags.get("title") or source.stem, "Titre sans nom")
    track = number(tags.get("track") or tags.get("tracknumber"))
    disc = number(tags.get("disc") or tags.get("discnumber"))
    prefix = f"{track:02d} - " if track else ""
    if track and disc > 1:
        prefix = f"{disc:02d}-{prefix}"
    return (component(artist, UNKNOWN_ARTIST), component(album, UNKNOWN_ALBUM),
            prefix + title, source.suffix.lower())


def classify(source, tags, album_artist, album_title, root, preview, reserved, importing,
             receipt=None, preserve_tags=False, folder_hint=None, filing_artist=None, approved_artist=None,
             source_version=None, committed=None):
    album_artist = approved_artist or album_artist
    artist, album, name, extension = target_parts(source, tags, album_artist, album_title)
    updates = {}
    if album_title != tags.get("album"):
        if extension not in TAG_WRITABLE:
            raise ValueError("renommage de l’album indisponible pour ce format")
        updates["album"] = album_title
    if album_artist and album_title and tags.get("albumartist") != album_artist:
        if approved_artist and extension not in TAG_WRITABLE:
            raise ValueError("format non réinscriptible pour le regroupement validé")
        if (approved_artist or not preserve_tags) and extension in TAG_WRITABLE:
            updates["albumartist"] = album_artist
    if folder_hint:
        # An equivalent supplier is adding positions to the already published
        # edition. Routing through its folder must not rewrite source credits.
        if approved_artist and folder_hint[0] != artist:
            raise ValueError("L’édition déjà publiée contredit le classement manuel.")
        artist, album = folder_hint
    if filing_artist and not approved_artist:
        artist = component(filing_artist, artist)
    artist_dir = root / artist
    folder = artist_dir / album
    with shared_mutation(root, not preview):
        if artist_dir.is_symlink() or folder.is_symlink():
            raise ValueError("dossier de destination symbolique")
        if not preview:
            folder.mkdir(parents=True, exist_ok=True)
            folder_id = stamp(folder.lstat())[:2]
    video = source_video(tags.get("purl")) if importing and not preview and not preserve_tags else ""
    position = (number(tags.get("disc") or tags.get("discnumber")) or 1,
                number(tags.get("track") or tags.get("tracknumber")))
    def remember(target):
        if receipt is None:
            return
        # Record the exact staged filename and intended destination before
        # touching either. Recovery verifies the destination against the source.
        with receipt.open("a+", encoding="utf-8") as journal:
            journal.write("\n" + json.dumps([source.name, str(target), video, *position]) + "\n")
            journal.flush()
            os.fsync(journal.fileno())
        sync_dir(receipt.parent)

    @contextmanager
    def admission(target, published_tags=None, *, existing=None, record=False):
        # Decode, copy and remux outside the library mutex. A move, retag or
        # change of classification invalidates the draft before publication.
        with shared_mutation(root):
            if source.resolve() != source or stamp(source.lstat()) != source_version:
                raise ValueError("fichier modifié pendant le tri")
            if folder.resolve() != folder or stamp(folder.lstat())[:2] != folder_id:
                raise ValueError("dossier de destination modifié pendant le tri")
            if manual_album_artist(album_groups(index_file(root)), tags) != approved_artist:
                raise ValueError("classement manuel modifié pendant le tri")
            if existing is not None and (target.is_symlink() or stamp(target.lstat()) != existing):
                raise ValueError("destination existante modifiée pendant le tri")
            if record:
                remember(target)
            yield
            if committed is not None:
                committed(target, published_tags)

    def keep_existing(target, version):
        verified = None
        if approved_artist:
            verified, _ = probe(target, include_duration=True, include_codec=True)
        retag = verified is not None and verified.get("albumartist") != approved_artist
        if retag and manual_album_artist(album_groups(index_file(root)), verified) != approved_artist:
            raise ValueError("le fichier existant ne relève pas du regroupement validé")
        if retag:
            @contextmanager
            def replace_duplicate(new_tags):
                with admission(target, new_tags, existing=version, record=True):
                    yield
                    source.unlink()
            verified = write_tags(target, target, verified, {"albumartist": approved_artist},
                                  admission=replace_duplicate, approved=True, backup=True)
        else:
            with admission(target, verified, existing=version, record=True):
                source.unlink()
        mutation_report(f"Déjà dans la bibliothèque : {target.relative_to(root)}")
        return target, False, verified

    if video:
        # The per-video lease protects another import of the same recording
        # even if its codec or title would give it a different filename.
        indexed = indexed_tags(root, folder)
        for existing in sorted(audio_files(folder)):
            if existing == source or not position[1] and existing.stem != name:
                continue
            try:
                version = stamp(existing.lstat())
                token, existing_tags = indexed.get(str(existing), (None, {}))
                if token != document(version):
                    existing_tags, _ = probe(existing)
            except (OSError, ValueError, subprocess.SubprocessError):
                continue
            if source_video(existing_tags.get("purl")) == video:
                disc = number(existing_tags.get("disc") or existing_tags.get("discnumber")) or 1
                track = number(existing_tags.get("track") or existing_tags.get("tracknumber"))
                if (disc, track) == position:
                    return keep_existing(existing, version)
    for attempt in range(1, 10_000):
        suffix = "" if attempt == 1 else f" [{attempt}]"
        target = folder / (name + suffix + extension)
        if source == target:
            if updates:
                if not preview:
                    new_tags = write_tags(source, target, tags, updates, approved=bool(approved_artist), backup=True,
                                          admission=lambda new_tags: admission(target, new_tags))
                else:
                    new_tags = None
                mutation_report(f"{source.name} · tags de l’album : {album_artist} / {album_title}")
                return target, False, new_tags
            return target, False, None
        if target in reserved or target.exists() or target.is_symlink():
            version = stamp(target.lstat()) if importing and not preview else None
            if version is not None and (same_content(source, target)
                    or not preserve_tags and same_import_track(source, target, tags)):
                return keep_existing(target, version)
            if same_content(source, reserved.get(target, target)):
                mutation_report(f"Identique, conservé à la source : {source.name}")
                return (target if target.is_file() else None), False, None
            continue
        published_tags = None
        if not preview:
            try:
                def publish_admission(published_tags=tags):
                    return admission(target, published_tags, record=True)
                if updates:
                    published_tags = write_tags(source, target, tags, updates, receipt is not None,
                                                approved=bool(approved_artist),
                                                backup=not importing and source.is_relative_to(root),
                                                admission=publish_admission)
                else:
                    move_track(source, target, receipt is not None, admission=publish_admission)
                    published_tags = tags
            except FileExistsError:
                continue
        if preview:
            reserved[target] = source
        mutation_report(f"{source.name} → {target.relative_to(root)}")
        return target, not preview, published_tags
    raise ValueError("aucun nom de fichier libre")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("sources", nargs="*", type=Path,
                        help="fichiers ou dossiers, par défaut A_trier et YouTube s'il existe")
    parser.add_argument("--bibliotheque", type=Path, default=SHARED_LIBRARY)
    parser.add_argument("--apercu", "--dry-run", action="store_true",
                        help="affiche les destinations sans déplacer les fichiers")
    parser.add_argument("--artiste-album", help="impose l’artiste de l’album pour les sources sélectionnées")
    parser.add_argument("--nom-album", help="impose le titre de l’album pour les sources sélectionnées")
    parser.add_argument("--rapport", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--rapport-detaille", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--reprise-interne", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--garder-tags-import", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--dossier-import", nargs=2, metavar=("ARTISTE", "ALBUM"), help=argparse.SUPPRESS)
    parser.add_argument("--classement-artiste", help=argparse.SUPPRESS)
    parser.add_argument("--liste-import", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--credits-partiels", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--suivi-publication", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if (args.credits_partiels or args.suivi_publication) and (not args.reprise_interne or args.apercu):
        parser.error("suivi réservé aux publications d’import")
    if args.classement_artiste and (not args.reprise_interne or args.dossier_import or args.apercu or
            component(args.classement_artiste, "") in {"", INBOX, "YouTube"}
            or component(args.classement_artiste, "").startswith(".")):
        parser.error("artiste de classement interne invalide")
    if args.dossier_import and (not args.garder_tags_import or not args.reprise_interne or args.apercu
            or any(value != component(value, "") or value.startswith(".") or value in {INBOX, "YouTube"}
                   for value in args.dossier_import)):
        parser.error("destination interne d’import invalide")
    for option, value in (("--artiste-album", args.artiste_album), ("--nom-album", args.nom_album)):
        if value is not None and (not args.sources or not value.strip()):
            parser.error(f"{option} demande des sources explicites et un nom")
    root = args.bibliotheque.expanduser().resolve()
    if not root.is_dir():
        parser.error(f"bibliothèque absente : {root}")
    sources = args.sources or [path for path in (root / INBOX, root / "YouTube") if path.is_dir()]
    staged = None
    if args.liste_import:
        # The private importer can publish a bounded subset of staged
        # originals. Unlisted files remain available for the next attempt.
        try:
            if (not args.reprise_interne or len(sources) != 1 or not sources[0].is_dir()
                    or args.liste_import.stat().st_size > 1024**2):
                raise ValueError
            names = json.loads(args.liste_import.read_text(encoding="utf-8"))
            if isinstance(names, dict):
                names, staged = names.get("paths"), names.get("proof")
            if (not isinstance(names, list) or not 0 < len(names) <= 4096
                    or any(not isinstance(name, str) or Path(name).name != name or name.startswith(".")
                           for name in names)):
                raise ValueError
            if staged is not None and (not isinstance(staged, list) or len(staged) != 3 or names != [staged[0]]
                    or not isinstance(staged[1], list) or len(staged[1]) != 5
                    or any(type(value) is not int for value in staged[1]) or not isinstance(staged[2], dict)):
                raise ValueError
            sources = [sources[0] / name for name in names]
            if any(path.is_symlink() or not audio_file(path) for path in sources):
                raise ValueError
        except (OSError, ValueError):
            parser.error("liste interne d’import invalide")
    if any(not path.expanduser().exists() for path in sources):
        parser.error("au moins un chemin source est introuvable")
    tracks = sorted({track.resolve() for source in sources
                     for track in audio_files(source.expanduser().absolute())})
    if not tracks:
        mutation_report("Aucun fichier audio à classer.")
    failures = 0
    prepared = []
    # FFprobe can run in parallel with a different album's publication. The
    # exact input version must still match when the shared lock is obtained.
    for track in tracks:
        checkpoint()
        try:
            token = stamp(track.lstat())
            # The receiver can reuse its already verified tags only for the
            # exact staging version. Publication checks that version again.
            tags = staged[2] if staged and staged[:2] == [track.name, token] else None
            if tags is None:
                tags, _ = probe(track, include_duration=True, include_codec=True)
            prepared.append((track, tags, token))
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            failures += 1
            mutation_report(f"Erreur pour {track.name} : {error}", file=sys.stderr)
    with shared_mutation(root, not args.apercu):
        items = []
        for track, tags, token in prepared:
            try:
                if track.resolve() != track or stamp(track.lstat()) != token:
                    raise ValueError("fichier modifié depuis la lecture des métadonnées")
                items.append((track, tags))
            except (OSError, ValueError) as error:
                failures += 1
                mutation_report(f"Erreur pour {track.name} : {error}", file=sys.stderr)
        artists = album_artists(items, root)
    reserved = {}
    destinations = set()
    verified = {}
    released = {}
    added = 0
    versions = {track: token for track, _, token in prepared}
    for track, tags in items:
        # An incomplete set cannot establish which credit in a collaboration
        # belongs to this album. Leave those tracks for the final sorted subset.
        if (args.credits_partiels and not args.artiste_album
                and not tags.get("albumartist") and ", " in tags.get("artist", "")):
            continue
        checkpoint()
        try:
            artist = args.artiste_album.strip() if args.artiste_album else artists[track]
            album = args.nom_album.strip() if args.nom_album else tags.get("album")
            importing = (args.rapport is not None and track.parent.parent == root / INBOX
                         and track.parent.name.startswith(".kara-"))
            if importing and args.artiste_album:
                artist = canonical_album_artist(artist, album, artist_id=tags.get("musicbrainzalbumartistid"))
            def committed(target, published_tags):
                version = stamp(target.lstat())
                released[track.name] = [str(target), version]
                if published_tags is not None:
                    verified[str(target)] = {"token": document(version), "tags": published_tags, "published": time()}

            rules = album_groups(index_file(root))
            video = source_video(tags.get("purl")) if importing and not args.apercu and not args.garder_tags_import else ""
            with (lease(root / INBOX / ".kara-reprises" / f"video-{video[:2]}.lock") if video else nullcontext()):
                target, moved, _ = classify(
                    track, tags, artist, album, root, args.apercu, reserved, importing,
                    args.reprise_interne if importing else None,
                    preserve_tags=args.garder_tags_import,
                    folder_hint=args.dossier_import if importing else None,
                    filing_artist=args.classement_artiste if importing else None,
                    approved_artist=manual_album_artist(rules, tags), source_version=versions[track],
                    committed=committed if args.rapport_detaille else None)
            if target is not None:
                path = str(target)
                destinations.add(path)
                if args.suivi_publication:
                    event = json.dumps([path, verified.get(path)])
                    # The progress protocol uses bounded lines. The final
                    # report still carries tags too large for this transport.
                    if len(event) <= 60_000:
                        mutation_report("KARA_PUBLICATION " + event)
            added += moved
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            failures += 1
            mutation_report(f"Erreur pour {track.name} : {error}", file=sys.stderr)
    if args.rapport:
        tracks = sorted(destinations)
        report = ({"tracks": tracks, "added": added, "verified": verified, "sources": released}
                  if args.rapport_detaille else tracks)
        args.rapport.write_text(json.dumps(report), encoding="utf-8")
    return int(failures != 0)


if __name__ == "__main__":
    if os.environ.get("KARA_IMPORT_COOPERATIVE_SORT") == "1":
        from _kara_import_queue import ImportQueue

        queue = ImportQueue()
        try:
            with ImportPause(queue.pause_requested) as pause, pause.scope():
                if queue.pause_requested():
                    raise ImportSuspended
                raise SystemExit(main())
        except ImportSuspended:
            raise SystemExit(75)
    raise SystemExit(main())
