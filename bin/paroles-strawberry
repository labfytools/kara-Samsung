    def start_maintenance(self, *, background=False):
        if not self.maintenance:
            self.maintenance = Maintenance(LIBRARY, COLLECTION, import_queue=self.album_import.queue,
                                           background=background)
            self.album_import.provider_enabled = self.maintenance.index.source_enabled
            self.album_import.measure_index = self.maintenance.index
            self.album_import.enrichment_activity = lambda: (
                *self.maintenance.import_activity,
                self.maintenance.import_enrichment_count())
            self.album_import.refresh_providers()
            self.maintenance.set_priority(self.maintenance_busy(), kara=self.kara_busy())
            self.maintenance.start()
        elif not background:
            self.maintenance.show()

    def open_parole(self):
        self.start_maintenance()
        if not self.parole_ui:
            self.parole_ui = ParoleView(self, self.maintenance)
            header = self.parole_ui.header()
            header.pack_start(self.timing_menu)
            header.pack_start(self.blackbox_button)
            self.set_titlebar(header)
            self.set_child(self.parole_ui.root)
            self.timers.append(GLib.timeout_add(350, self.parole_ui.refresh))
        self.present()

    def open_import(self, _button=None):
        if self.import_window is None:
            # The desktop stylesheet can override GTK's accent at user
            # priority. Keep the requested palette local to the import panel.
            accent = Gtk.CssProvider()
            accent.load_from_data(IMPORT_ACCENT)
            Gtk.StyleContext.add_provider_for_display(self.get_display(), accent, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
            self.import_window = Gtk.Window(title="Importer des albums", transient_for=self,
                                            destroy_with_parent=True, hide_on_close=True,
                                            default_width=980, default_height=630)
            self.import_window.set_child(self.album_import)
        self.import_toggle.set_active(True)
        self.import_window.present()

    def maintenance_busy(self):
        # The maintenance owner already yields heavy preparation to pending
        # imports. Import activity itself must not block their enrichment.
        return self.kara_busy() or self.playback_state == "Playing"

    def kara_busy(self):
        return bool(self.party.active is not None or self.remote_party.locked)

    def turn_context(self):
        player = self.party.active
        return {"turn": self.bb_turn, "player": player.name, "song": player.song.title} if player else {}


    def search_missing(self, _button, option, title):
        self.open_import()
        self.album_import.start_maintenance(option, title)

    def show_players(self, _button):
        self.ensure_players_window()
        self.players_window.present()

    def ensure_players_window(self):
        if self.players_window is None:
            self.players_window = PlayersWindow(self, COLLECTION, LIBRARY.resolve())

    def show_admin_code(self, _button):
        if self.receiver is None:
            Gtk.AlertDialog(message="Ouvre d’abord la salle Kara.").show(self)
            return
        code = self.receiver.room.issue_admin_code()
        dialog = Gtk.AlertDialog(message=f"Code organisateur · {code}",
                                 detail="À saisir dans Admin sur ton téléphone. Valable cinq minutes.")
        dialog.show(self)

    def start_blackbox(self, consent, voice=False, tracks=None, mode=None):
        if voice and tracks is None:
            tracks = ["wifi", "return", "monitor"]
        if tracks is not None and (not isinstance(tracks, (tuple, list))
                                   or any(track not in ("wifi", "return", "monitor", "witness") for track in tracks)):
            raise ValueError("Piste BlackBox indisponible pour une nouvelle collecte Kara.")
        self.blackbox.start(consent=consent, voice=voice, tracks=tracks, configuration={
            "capture": "diagnostics", "lyric_offset_s": self.timing_offset,
        }, identity={"room": self.bb_room, "party": self.remote_party.identity}, mode=mode)
        self.bb_line = None
        self.blackbox.emit("party", "recording-start", mode=self.blackbox.status(storage=True)["mode"])
        if self.party.active and self.turn_phase == "playing":
            self.log_playback_reference(self.party.active.song.path)

    def stop_blackbox(self, reason="manual", *, wait=False):
        self.acoustic.update()
        self.blackbox.stop(reason, wait=wait)

    def show_blackbox_studio(self, _button):
        from _kara_blackbox_studio import BlackBoxStudio

        if self.blackbox_studio is None:
            self.blackbox_studio = BlackBoxStudio(self)
        self.blackbox_studio.show_studio()

    def toggle_blackbox(self, _button, *, parent=None):
        parent = parent or self
        status = self.blackbox.status()
        if status["active"]:
            self.stop_blackbox()
        elif not status["finalizing"]:
            detail = "Confirme l’accord des participants et des responsables des mineurs. "
            detail += "Le mode diagnostics enregistre les événements de lecture et de retour microphone. "
            detail += ("La collecte audio enregistre le microphone du joueur et la sortie PipeWire pendant les tours. "
                       "Le micro témoin peut être sélectionné explicitement depuis Admin sur mobile. "
                       "Obtiens l’accord explicite de chaque participant. Prévois 6 Go par heure de jeu.")
            detail += "\n\n" + "\n".join(
                f"{label} · {state}" for label, state in self.blackbox_preflight().items())
            if status["latest"]:
                detail += f"\n\nDernière session : {status['latest']['session']}"
            dialog = Gtk.AlertDialog(message="Activer BlackBox ?", detail=detail,
                                     buttons=["Annuler", "Diagnostic léger", "Collecte audio"],
                                     cancel_button=0, default_button=0)

            def confirmed(source, result):
                try:
                    choice = source.choose_finish(result)
                    modes = ("diagnostic_light", "deep_analysis")
                    if 1 <= choice <= len(modes):
                        self.start_blackbox(True, voice=choice > 1, mode=modes[choice - 1])
                except (OSError, ValueError, GLib.Error) as error:
                    Gtk.AlertDialog(message="BlackBox indisponible", detail=str(error)).show(parent)

            dialog.choose(parent, None, confirmed)

    def blackbox_preflight(self):
        from _kara_blackbox import MIN_FREE

        status = self.blackbox.status(storage=True)
        free = status["free_bytes"]
        mobile = self.room_audio.status()["available"]
        received = self.room_audio.receiving(recent=True)
        sink = self.room_audio.selected_sink()
        references = bool(self.lyric_source)
        tv = self.receiver and time.monotonic() - self.receiver.tv_seen < 4
        return {
            "Espace disque": ("À vérifier" if free is None else "Prêt" if free >= MIN_FREE + 65536 else "Bloquant"),
            "Serveur micro": "Prêt" if mobile else "Indisponible",
            "Microphone du tour": ("Prêt" if received and self.room_audio.consented() else
                                   "Accord à donner" if received else "À connecter"),
            "Paroles minutées": "LRC disponible" if references else "LRC absent",
            "Sortie PipeWire": "Route choisie" if sink else "À vérifier au tour",
            "Tizen": "Connecté" if tv else "Facultatif · non connecté",
        }

    def update_party_services(self):
        state = self.blackbox.status()
        now = time.monotonic()
        if (not state["active"] and now >= self.blackbox_disk_check
                and (self.blackbox_disk_task is None or self.blackbox_disk_task.done())):
            self.blackbox_disk_check = now + 15.
            self.blackbox_disk_task = self.tag_reader.submit(self.blackbox.disk_available)
        label = ("● BlackBox active" if state["active"] else "Finalisation BlackBox…"
                 if state["finalizing"] else "BlackBox")
        if (label, state["error"], state["latest"]) != self.blackbox_ui:
            self.blackbox_ui = label, state["error"], state["latest"]
            self.blackbox_button.set_label(label)
            if state["active"]:
                self.blackbox_button.add_css_class("destructive-action")
            else:
                self.blackbox_button.remove_css_class("destructive-action")
            self.blackbox_button.set_tooltip_text(state["error"] or (state["latest"] or {}).get("session")
                                                   or "Enregistrer les diagnostics de la partie")
        self.album_import.launch_next()
        if self.maintenance:
            self.maintenance.set_priority(self.maintenance_busy(), kara=self.kara_busy())
        return GLib.SOURCE_CONTINUE

    def set_remote_music_volume(self, percent):
        if type(percent) is not int or not 0 <= percent <= 100:
            raise ValueError("Volume musical invalide.")
        if self.turn_music_restore is not None:
            self.turn_music_restore = percent / 100
            if self.party.active is not None:
                self.apply_player_mix(self.party.active)
        else:
            self.write_music_volume(percent / 100)
        self.blackbox.emit("audio", "music-volume", **self.turn_context(), percent=percent)

    def write_music_volume(self, level, callback=None, *, stage=False):
        if not stage:
            self.music_volume = level
        self.bus.call(PLAYER, OBJECT, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", (INTERFACE, "Volume", GLib.Variant("d", level))),
                      None, Gio.DBusCallFlags.NO_AUTO_START, 4000, None, callback)

    def apply_player_mix(self, player, *, callback=None):
        if self.turn_music_restore is None or self.turn_phase not in ("opening", "playing"):
            return
        # The original music shares the sink with the protected microphone.
        # Their gains have separate controls and a bounded sum of peaks.
        ceiling = round(100 * min(1., self.turn_music_restore))
        music = player.music_volume if player.music_volume is not None else 100
        gain = ROOM_MUSIC_BUDGET * min(music, ceiling) / 100
        self.write_music_volume(gain, callback, stage=True)
        self.blackbox.emit("audio", "original-mix", **self.turn_context(), music_requested=music,
                           music_applied=min(music, ceiling), music_gain=gain)

    def refresh_after_import(self, task, jobs):
        self.import_refresh_tasks[task.identity] = (task, jobs)
        if self.import_refresh_timer is None and not self.import_refresh_active:
            self.import_refresh_timer = GLib.timeout_add(250, self.reload_after_import)

    def report_import_update(self, job, kind, payload):
        self.mobile_imports.update(job, kind, payload)
        if kind in {"queue", "suspended"} and getattr(self, "maintenance", None):
            self.maintenance.journal.emit("DOWNLOAD", payload["message"])
            self.maintenance.wake.set()
        if kind == "album" and payload.get("tracks"):
            self.import_published_paths.update(map(Path, payload["tracks"]))
            if self.import_refresh_timer is None and not self.import_refresh_active:
                self.import_refresh_timer = GLib.timeout_add_seconds(3, self.reload_after_import)
            if self.maintenance:
                self.maintenance.index_wake.set()
            if payload.get("enrichment") and self.maintenance:
                self.maintenance.wake.set()
        if getattr(self, "maintenance", None) and payload.get("provider"):
            if kind == "provider":
                self.maintenance.journal.emit("DOWNLOAD", payload["message"])
            elif kind == "album":
                level = "WARNING" if payload["status"] in {"failure", "partial"} else "INFO"
                rate = payload.get("measured_bytes_per_second")
                throughput = f" · {rate / (1024**2):.2f} Mio/s mesurés" if rate else ""
                self.maintenance.journal.emit(
                    "DOWNLOAD", f"{payload['provider']} · {payload['title']} · {payload['message']}{throughput}", level)

    def artist_group_changed(self, plan, *, reverse=False):
        old, new = set(), set()
        for row in plan["moves"]:
            source, target = (LIBRARY.resolve() / row[key] for key in ("source", "destination"))
            if reverse:
                source, target = target, source
            for name in row["file_names"]:
                if Path(name).suffix.lower() in AUDIO:
                    old.add(source / name)
                    new.add(target / name)
        self.import_removed_paths.update(old)
        self.import_published_paths.update(new)
        if self.import_refresh_timer is None and not self.import_refresh_active:
            self.import_refresh_timer = GLib.timeout_add(250, self.reload_after_import)
        self.maintenance.index_wake.set()

    def reload_after_import(self):
        self.import_refresh_timer = None
        if self.closed:
            return GLib.SOURCE_REMOVE
        pending, self.import_refresh_tasks = self.import_refresh_tasks, {}
        published, self.import_published_paths = self.import_published_paths, set()
        removed, self.import_removed_paths = self.import_removed_paths, set()
        generations = [(task.identity, task.refresh_generation) for task, _ in pending.values()]
        receiver = self.receiver
        jobs = [job for _, linked in pending.values() for job in linked]
        paths = {Path(path) for task, _ in pending.values()
                 for outcome in task.outcomes.values() for path in outcome.get("tracks", [])}
        paths.update(Path(path) for job in jobs for outcome in job["results"].values()
                     for path in outcome.get("tracks", []))
        paths.update(published)

        def reload():
            index = self.maintenance.index if getattr(self, "maintenance", None) else None
            root = index.root if index is not None else LIBRARY.resolve()
            rows, indexed = [], {}
            try:
                if index is not None:
                    with index.db(wait=.15) as db:
                        ordered = sorted(paths)
                        for start in range(0, len(ordered), 128):
                            indexed.update(path_rows(db, ordered[start:start+128]))
            except sqlite3.Error:
                pass
            for path in sorted(paths):
                if not path.is_relative_to(root) or not path.is_file() or path.resolve() != path:
                    continue
                if row := indexed.get(str(path)):
                    song = Song(path, row["title"], row["artist"], row["album"], row["duration"])
                else:
                    try:
                        tags, _ = probe(path, include_duration=True)
                        song = Song(path, tags.get("title") or path.stem, tags.get("artist", ""),
                                    tags.get("album", ""), tags.get("duration_seconds"))
                    except (OSError, ValueError, subprocess.SubprocessError):
                        continue
                rows.append((song, search_key(f"{song.title} {song.artist} {song.album}")))
            visible_lrc = {song.path for song, _ in rows if song.path.with_suffix('.lrc').is_file()}
            if receiver is not None and self.receiver is receiver:
                if removed:
                    receiver.room.remove_catalogue_paths(removed)
                receiver.room.update_catalogue(rows, incremental=True)
            return rows, visible_lrc

        def done(future):
            self.import_refresh_active = False
            if self.closed:
                return GLib.SOURCE_REMOVE
            try:
                rows, visible_lrc = future.result()
                linked = receiver if self.receiver is receiver else None
                visible = {song.path for song, _ in rows}
                for task, _ in pending.values():
                    missing = [url for url, outcome in task.outcomes.items()
                               if outcome.get("audio_complete") and
                               not {Path(path) for path in outcome.get("tracks", [])} <= visible]
                    if missing:
                        self.album_import.queue.integration_failed(task.identity, task.refresh_generation, missing)
                        task.outcomes = self.album_import.queue.outcomes(task.identity)
                self.mobile_imports.integrated(jobs, linked, visible)
                self.album_import.acknowledge_refresh(generations)
                if pending and getattr(self, "maintenance", None):
                    self.maintenance.journal.emit("DOWNLOAD", f"{len(paths)} pistes signalées après import")
                if self.music_window:
                    self.music_window.publish_rows(rows, visible_lrc, removed)
            except (OSError, sqlite3.Error, RoomError, ValueError) as error:
                self.album_import.release_refresh(generations)
                self.blackbox.emit("imports", "error", stage="library-refresh", error=str(error))
            if self.import_refresh_tasks or self.import_published_paths or self.import_removed_paths:
                self.import_refresh_timer = GLib.timeout_add(250 if self.import_refresh_tasks else 3000,
                                                            self.reload_after_import)
            return GLib.SOURCE_REMOVE

        self.import_refresh_active = True
        self.tag_reader.submit(reload).add_done_callback(lambda future: GLib.idle_add(done, future))
        return GLib.SOURCE_REMOVE

    def show_library(self, _button):
        if self.music_window is None:
            self.music_window = MusicLibraryWindow(self, COLLECTION, LIBRARY.resolve())
        self.music_window.present()
        if self.music_window.publications:
            self.music_window.apply_publications()
        self.music_window.refresh_queue(force=True)

    def player_command(self, method, parameters=None, callback=None):
        if os.environ.get("KARA_SILENT") == "1" and method in ("Play", "PlayPause", "OpenUri", "Next", "Previous"):
            return
        self.bus.call(PLAYER, OBJECT, INTERFACE, method, parameters, None,
                      Gio.DBusCallFlags.NO_AUTO_START, 4000, None, callback)

    def player_seeked(self, _bus, _sender, _path, _interface, _member, parameters):
        # Seeked supplies a position on the player timeline. Reception anchors
        # it on the Linux monotonic clock without involving phone or TV clocks.
        position, = parameters.unpack()
        self.seek_revision += 1
        self.base_position = max(0., position / 1_000_000)
        self.updated = time.monotonic()
        self.next_tv_update = 0.
        self.blackbox.emit("lyrics", "seek", turn=self.bb_turn, position=self.base_position)

    def party_choice(self):
        return tuple((player, player.song) for player in self.party.players)

    def open_party(self, _button):
        if self.receiver is None:
            self.players_window.message.set_text("Active Salle / TV pour ouvrir le salon.")
            return
        try:
            self.remote_party.open()
        except RoomError as error:
            self.players_window.message.set_text(str(error))
        else:
            self.players_window.refresh()

    def validate_party(self, _button):
        self.begin_preparation([p.song for p in self.party.players if p.song], for_party=True)

    def can_skip_failed(self):
        return (not self.party_ready and bool(self.failed_alignments) and bool(self.party_available)
                and self.party_choice() == self.party_selection)

    def skip_failed(self, _button):
        if self.can_skip_failed():
            self.party.excluded = set(self.failed_alignments)
            self.party_ready = True

    def begin_preparation(self, songs, *, for_party):
        # The legacy organiser action checks the selected files only.
        if self.closed or self.party.active is not None or not for_party:
            return False
        paths = {song.path for song in songs}
        available = {path for path in paths if local_track(path.as_uri()) == path}
        self.party_selection = self.party_choice()
        self.party_available = available
        self.failed_alignments = dict.fromkeys(paths - available, "Fichier audio local introuvable.")
        self.party.excluded.clear()
        self.party_ready = bool(available) and not self.failed_alignments
        if self.receiver is not None:
            self.receiver.room.set_prepared(available, failures=self.failed_alignments)
        if self.players_window is not None:
            detail = ("Sélection prête." if self.party_ready else "Un fichier audio est indisponible.")
            self.players_window.message.set_text(detail)
            self.players_window.refresh()
        self.remote_party.prepared()
        return True

    def build_timing_controls(self):
        self.timing_menu = Gtk.MenuButton(label="Minutage", tooltip_text="Ajuster le défilement PC et TV")
        popover = Gtk.Popover()
        self.timing_menu.set_popover(popover)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                          margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        popover.set_child(content)
        content.append(Gtk.Label(label="Décalage des paroles en secondes", xalign=0))
        row = Gtk.Box(spacing=6)
        earlier = Gtk.Button(label="Avancer")
        later = Gtk.Button(label="Retarder")
        self.timing_spin = Gtk.SpinButton.new_with_range(-30, 30, .5)
        self.timing_spin.set_digits(1)
        self.timing_spin.connect("value-changed", self.change_timing)
        earlier.connect("clicked", lambda *_: self.timing_spin.spin(Gtk.SpinType.STEP_BACKWARD, .5))
        later.connect("clicked", lambda *_: self.timing_spin.spin(Gtk.SpinType.STEP_FORWARD, .5))
        row.append(earlier)
        row.append(self.timing_spin)
        row.append(later)
        content.append(row)
        reset = Gtk.Button(label="Remettre le décalage à zéro")
        reset.connect("clicked", lambda *_: self.timing_spin.set_value(0))
        content.append(reset)
        self.timing_message = Gtk.Label(xalign=0, wrap=True, css_classes=["lyrics-info"])
        content.append(self.timing_message)
        return self.timing_menu

    def view_anchor(self, position):
        return bisect_right(self.times, position) - 1

    def apply_timing(self):
        # Apply the manual offset only to the view. The file and its
        # original line and word clocks are preserved.
        self.timing_offset = self.timing.offset(self.track)
        self.times = [stamp + self.timing_offset for stamp, _, _ in self.raw_lines]
        self.word_marks = tuple(marks for _, _, marks in self.raw_lines)
        self.highlight = -1
        self.next_tv_update = 0
        self.timing_spin.set_sensitive(bool(self.track and self.raw_lines))
        self.syncing_offset = True
        self.timing_spin.set_value(self.timing_offset)
        self.syncing_offset = False
        marked = sum(bool(marks) for marks in self.word_marks)
        detail = f"Repères LRC par mot sur {marked} ligne(s)." if marked else "Minutage du fichier LRC."
        self.timing_message.set_text(detail)

    def change_timing(self, spin):
        if self.syncing_offset or self.track is None or not self.raw_lines:
            return
        try:
            self.timing.set_offset(self.track, spin.get_value())
        except OSError:
            self.timing_message.set_text("Impossible d’enregistrer le décalage.")
            return
        self.apply_timing()

    def song_available(self, song):
        return local_track(song.path.as_uri()) == song.path

    def start_turn(self, player, *, independent=False):
        if self.party.active is not None or player.song is None or not (independent or self.party_ready):
            return
        if os.environ.get("KARA_SILENT") == "1":
            self.players_window.message.set_text("La lecture et le microphone sont désactivés pour cette séance.")
            return
        if player.song.path in self.party.excluded or not self.song_available(player.song):
            self.players_window.message.set_text("Le fichier du morceau est indisponible.")
            return
        self.bb_turn = self.remote_party.turn_id or token_hex(8)
        if player.mobile_id:
            try:
                self.room_audio.open_turn(player.mobile_id, player.name, self.bb_turn, player.song.title)
            except RoomError as error:
                self.bb_turn = None
                self.players_window.message.set_text(str(error))
                self.blackbox.emit("audio", "error", operation="turn-route", player=player.name)
                return
        self.party.active = player
        self.turn_opened = False
        self.turn_phase = "awaiting-mic" if player.mobile_id else "opening"
        self.blackbox.emit("party", "turn-start", **self.turn_context(),
                           identity={"room": self.bb_room, "party": self.remote_party.identity})
        self.players_window.message.set_text("Essai microphone sur le téléphone." if player.mobile_id else "")
        self.players_window.refresh()
        if player.mobile_id:
            self.room_audio.record_test(True)
            if self.playback_state == "Playing":
                self.player_command("Pause")
        else:
            self.begin_playback(player)

    def countdown(self):
        return max(0, ceil(self.countdown_end - time.monotonic())) if self.turn_phase == "countdown" else 0

    def request_turn_start(self):
        if self.turn_phase in ("countdown", "opening", "playing"):
            return
        if (self.turn_phase != "awaiting-mic" or not self.room_audio.receiving(recent=True)
                or not self.room_audio.test_passed()):
            raise RoomError("Confirme que tu entends ton retour avant de démarrer.", 409)
        if self.music_volume is None or time.monotonic() - self.player_seen > 2:
            raise RoomError("Le lecteur musical est indisponible.", 503)
        if self.remote_party.opened_early and time.monotonic() - self.receiver.secure_tv_seen >= 4:
            raise RoomError("La télévision Kara est déconnectée.", 409)
        player = self.party.active
        if not self.song_available(player.song):
            raise RoomError("Le fichier audio est indisponible.", 409)
        self.turn_phase = "countdown"
        self.countdown_end = time.monotonic() + 3.
        self.blackbox.emit("party", "countdown", turn=self.bb_turn, player=player.name, seconds=3)

    def begin_playback(self, player):
        self.turn_phase = "opening"
        self.turn_deadline = time.monotonic() + 12.0
        if self.music_volume is None:
            self.finish_turn(error="Le volume de Strawberry est indisponible.")
            return
        self.room_audio.record_test(False)
        self.turn_music_restore = self.music_volume

        def opened(bus, result):
            if player is not self.party.active or self.turn_phase != "opening":
                return
            try:
                bus.call_finish(result)
            except GLib.Error:
                self.finish_turn(error="Impossible d’ouvrir le morceau dans Strawberry.")
            else:
                self.turn_opened = True

        def music_set(bus, result):
            if player is not self.party.active or self.turn_phase != "opening":
                return
            try:
                bus.call_finish(result)
            except GLib.Error:
                self.finish_turn(error="Impossible de régler le volume musical dans Strawberry.")
                return
            self.player_command("OpenUri", GLib.Variant("(s)", (player.song.path.as_uri(),)), opened)

        self.apply_player_mix(player, callback=music_set)

    def observe_turn(self, playback):
        player = self.party.active
        if player is None:
            return
        song = player.song.path
        if self.turn_phase == "opening" and self.turn_opened:
            if self.track == song and playback == "Playing":
                self.turn_phase = "playing"
                self.log_playback_reference(song)
        elif self.turn_phase == "playing":
            if self.track != song:
                # Strawberry may start its next queued song on natural EOF.
                # Pause it until the next player explicitly starts their turn.
                if playback == "Playing":
                    self.player_command("Pause")
                self.finish_turn()
            elif playback == "Stopped":
                self.finish_turn()

    def advance_turn(self, now):
        player = self.party.active
        if player is None:
            return
        if self.turn_phase == "opening" and now >= self.turn_deadline:
            self.finish_turn(error="Strawberry n’a pas démarré la chanson sélectionnée.")
        elif self.turn_phase == "countdown":
            if (not self.room_audio.receiving(recent=True) or not self.room_audio.test_passed()
                    or self.remote_party.opened_early and now - self.receiver.secure_tv_seen >= 4
                    or now - self.player_seen > 2 or not self.song_available(player.song)):
                self.turn_phase = "awaiting-mic"
            elif now >= self.countdown_end:
                self.begin_playback(player)

    def finish_turn(self, *, pause=False, error=""):
        player = self.party.active
        if player is None:
            return
        self.acoustic.update()
        self.room_audio.record_playing(False)
        self.bb_audio_playing = False
        if pause and self.track == player.song.path and self.playback_state == "Playing":
            self.player_command("Pause")
        played = self.turn_phase == "playing"
        if played:
            player.done = True
        detail = error or ("Tour terminé." if played else "Tour annulé.")
        self.blackbox.emit("party", "turn-end", **self.turn_context(), played=played, detail=detail)
        self.remote_party.turn_completed(player, detail, played=played)
        self.bb_turn = None
        self.room_audio.close_turn()
        self.party.active = None
        if self.turn_music_restore is not None:
            self.write_music_volume(self.turn_music_restore)
            self.turn_music_restore = None
        if player.mobile_id in self.mobile_leaving:
            self.mobile_leaving.discard(player.mobile_id)
            self.room_audio.forget_player(player.mobile_id)
            self.party.players = [p for p in self.party.players if p is not player]
            self.mobile_players.pop(player.mobile_id, None)
            self.party_ready = False
        self.turn_phase = ""
        if self.players_window is not None:
            self.players_window.message.set_text(detail)
            self.players_window.refresh()

    def mobile_event(self, action, member):
        """Mise à jour du jeu UNIQUEMENT depuis la boucle GTK principale."""
        if self.closed or self.receiver is None:
            return GLib.SOURCE_REMOVE
        if action in ('join', 'reconnect'):
            self.receiver.resume_tv_display()
            if action == 'reconnect':
                # A heartbeat can reopen the TV without changing the party plan.
                return GLib.SOURCE_REMOVE
        token = member.get('token')
        player = self.mobile_players.get(token)
        if action == 'join':
            if player is None:
                player = Singer(member['name'], mobile_id=token)
                defaults = self.remote_party.defaults
                player.music_volume = defaults["music"]
                if defaults["voice"] is not None:
                    self.room_audio.default_player_volume(token, defaults["voice"])
                self.mobile_players[token] = player
                self.party.players.append(player)
                self.party_ready = False
        elif action == 'choose':
            if player is not None and player is not self.party.active:
                song = self.receiver.room.song_for(member.get('song'))
                if song is not None:
                    player.song = song
                    player.done = False
                    self.party_ready = False
        elif action == 'clear':
            if player is not None and player is not self.party.active:
                player.song = None
                player.done = False
                self.party_ready = False
        elif action == 'leave':
            self.remote_party.eligible.discard(token)
            if player is self.party.active:
                self.mobile_leaving.add(token)
            elif player is not None:
                self.room_audio.forget_player(token)
                self.party.players = [p for p in self.party.players if p is not player]
                self.mobile_players.pop(token, None)
                self.party_ready = False
        if self.players_window is not None:
            self.players_window.refresh()
        if player is not None and action in ("choose", "clear"):
            self.remote_party.revised_selection(player)
        self.remote_party.changed_selection()
        self.next_tv_update = 0.0
        return GLib.SOURCE_REMOVE

    def remove_mobile(self, player):
        if self.party.active is player:
            if self.players_window is not None:
                self.players_window.message.set_text('Termine le tour avant de retirer le joueur.')
            return
        if self.receiver is not None:
            self.receiver.room.kick(player.mobile_id)
        else:
            self.party.players = [p for p in self.party.players if p is not player]
            self.mobile_players.pop(player.mobile_id, None)
            self.party_ready = False
            if self.players_window is not None:
                self.players_window.refresh()

    def mobile_catalogue_loaded(self, future, receiver):
        if self.closed or self.receiver is not receiver:
            return GLib.SOURCE_REMOVE
        try:
            receiver.room.update_catalogue(future.result())
        except (OSError, ValueError, sqlite3.Error) as error:
            self.tv_address.set_text(f'Bibliothèque inaccessible : {error}')
        return GLib.SOURCE_REMOVE

    def toggle_tv(self, button):
        if not button.get_active():
            if self.receiver is not None:
                self.receiver.close()
                self.receiver = None
                # Les identités liées aux téléphones sont valables pour cette
                # salle uniquement. Les joueurs créés sur PC sont préservés.
                active = self.party.active
                self.party.players = [p for p in self.party.players
                                      if p.mobile_id is None or p is active]
                self.mobile_players = ({active.mobile_id: active}
                                       if active is not None and active.mobile_id else {})
                if active is not None and active.mobile_id:
                    self.mobile_leaving.add(active.mobile_id)
                self.party_ready = False
                if self.players_window is not None:
                    self.players_window.refresh()
            self.tv_row.set_visible(False)
            return
        try:
            self.receiver = start_receiver(
                on_mobile=self.mobile_event,
                reserved_names=(p.name for p in self.party.players if p.mobile_id is None),
                diagnostics=self.blackbox, commands=self.remote_party.dispatch,
                imports=self.mobile_imports, audio=self.room_audio)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.tv_address.set_text(str(error))
            self.tv_copy.set_visible(False)
        else:
            self.bb_room = token_hex(16)
            self.tv_address.set_text(
                f"TV : {self.receiver.url} · Joueurs : {self.receiver.join_url}")
            if self.receiver.qr:
                try:
                    qr_texture = Gdk.Texture.new_from_bytes(GLib.Bytes.new(self.receiver.qr))
                    self.tv_qr_image.set_paintable(qr_texture)
                except GLib.Error:
                    self.tv_qr_image.set_paintable(None)
            else:
                self.tv_qr_image.set_paintable(None)
            self.tv_qr_link.set_text(self.receiver.join_url)
            self.next_tv_update = 0.0
            self.tv_copy.set_visible(True)
            receiver = self.receiver
            self.tag_reader.submit(catalogue, COLLECTION, LIBRARY.resolve()).add_done_callback(
                lambda future: GLib.idle_add(self.mobile_catalogue_loaded, future, receiver))
        self.tv_row.set_visible(True)

    def copy_tv_url(self, _button):
        if self.receiver is not None:
            self.get_display().get_clipboard().set(self.receiver.join_url)

    def refresh_tv_display(self, _button):
        if self.receiver is None:
            self.tv_address.set_text("Active d’abord Salle / TV pour actualiser l’écran.")
            return
        self.receiver.request_tv_reload()
        self.tv_refresh_button.set_label("Demande envoyée ✓")
        GLib.timeout_add(1800, self.reset_tv_refresh_button)

    def reset_tv_refresh_button(self):
        if not self.closed:
            self.tv_refresh_button.set_label("↻ Actualiser TV")
        return GLib.SOURCE_REMOVE

    def close_tv_display(self, _button):
        if self.receiver is None:
            self.tv_address.set_text("Active d’abord Salle / TV pour fermer l’écran.")
            return
        self.receiver.request_tv_close()
        self.tv_close_button.set_label("Fermeture demandée ✓")
        GLib.timeout_add(1800, self.reset_tv_close_button)

    def reset_tv_close_button(self):
        if not self.closed:
            self.tv_close_button.set_label("Fermer TV")
        return GLib.SOURCE_REMOVE

    def update_tv(self, position, now):
        if self.receiver is None or now < self.next_tv_update:
            return
        self.next_tv_update = now + 0.12
        self.receiver.room.set_mode(
            locked=self.party.active is not None or self.remote_party.locked,
            game_mode=self.remote_party.phase == "running",
            current=(self.party.active.name if self.party.active is not None else self.title.get_label()),
            editable=self.remote_party.editable_players())
        connected = self.receiver.room.public_roster()
        self.remote_party.publish()
        active = self.view_anchor(position)
        lines = [self.view_lyrics[i] if 0 <= i < len(self.view_lyrics) else "" for i in range(active - 1, active + 3)]
        fraction = self.display_progress(position, active, utf16=True) if active >= 0 else 0.0
        count = round(fraction * len(lines[1].encode("utf-16-le")) / 2)
        display_mode = "game" if self.remote_party.phase == "running" else "music"
        engine = "lrc-original"
        if (self.track, active, self.playback_state, engine) != self.bb_line:
            self.bb_line = self.track, active, self.playback_state, engine
            self.tv_line_revision += 1
            self.blackbox.emit("lyrics", "tv-line", turn=self.bb_turn, position=position,
                               revision=self.tv_line_revision, line=active, lines=lines, playback=self.playback_state,
                               timing_engine=engine)
        if self.title.get_label():
            notice = "Paroles minutées indisponibles" if not self.times else " "
        else:
            notice = "En attente de Strawberry…"
        self.receiver.update({
            "title": self.title.get_label(), "artist": self.artist.get_label(),
            "lines": lines, "progress": fraction, "highlight_chars": count, "notice": notice,
            "display_mode": display_mode, "playback_state": self.playback_state,
            "plain_lyrics": self.tag_text[:5000] if not self.times else "",
            "status": self.remote_party.notice,
            "players": self.party.board(), "connected": connected,
            "recording": self.blackbox.status()["active"],
            "party_phase": self.remote_party.phase, "turn": self.bb_turn, "turn_phase": self.turn_phase,
            "position": position, "line": active,
            "countdown": self.countdown(),
            "current_player": self.party.active.name if self.party.active else "",
            "current_song": self.party.active.song.title if self.party.active else "",
            "next_turns": [{"player": player.name, "song": song.title}
                           for player, song in list(self.remote_party.queue)[:5]],
            "recent_result": self.remote_party.latest_result(),
            "line_revision": self.tv_line_revision,
        }, cover=self.tv_cover if display_mode == "music" else ("", ""))

    def close_window(self, _window, *, wait=True):
        if self.closed:
            return False
        if self.party.active is not None:
            self.finish_turn(pause=True)
        self.tv_toggle.set_active(False)
        # Managed workers own their leases and write their own result. Closing
        # the window stops scheduling and leaves any admitted import recoverable.
        if self.maintenance:
            self.maintenance.close()
        self.album_import.closing = True
        self.album_import.cancel_search()
        self.music_sync.close()
        self.stop_blackbox("window-close", wait=wait)
        self.closed = True
        for timer in self.timers:
            GLib.source_remove(timer)
        self.bus.signal_unsubscribe(self.seek_signal)
        self.tag_reader.shutdown(wait=False, cancel_futures=True)
        return False

    def clear_player(self):
        self.player_track_id = None
        self.title.set_label("")
        self.artist.set_label("")
        self.playback_state = 'Stopped'
        self.media_play.set_label('▶ Lecture')
        self.media_clock.set_text('0:00 / 0:00')
        self.rate = 0.0
        self.set_track(None)
        self.refresh_tv_cover(None)
        self.show_empty("Lance un morceau local dans Strawberry.")

    def set_track(self, track):
        if track == self.track:
            return
        self.track = track
        self.lyric_source = None
        self.file_token = None
        self.tag_token = None
        self.tag_text = ""
        self.fetch_message = ""
        self.set_lines([])

    def request_player(self):
        if not self.polling:
            self.polling = True
            self.poll_started = time.monotonic()
            self.bus.call(PLAYER, OBJECT, "org.freedesktop.DBus.Properties", "GetAll",
                          GLib.Variant("(s)", (INTERFACE,)), GLib.VariantType.new("(a{sv})"),
                          Gio.DBusCallFlags.NO_AUTO_START, 700, None, self.player_reply, self.seek_revision)
        return GLib.SOURCE_CONTINUE

    def player_reply(self, bus, result, seek_revision):
        self.polling = False
        if self.closed or seek_revision != self.seek_revision:
            return
        try:
            properties, = bus.call_finish(result).unpack()
        except GLib.Error:
            if self.party.active:
                self.finish_turn(error="Strawberry est indisponible.")
            self.clear_player()
            return
        now = time.monotonic()
        self.player_seen = now
        metadata = properties.get("Metadata", {})
        volume = properties.get("Volume")
        if self.turn_music_restore is None and type(volume) in (int, float) and isfinite(volume) and volume >= 0:
            self.music_volume = volume
        title = metadata.get("xesam:title", "")
        self.title.set_label(title)
        self.artist.set_label(" · ".join(metadata.get("xesam:artist", [])))
        self.base_position = properties.get("Position", 0) / 1_000_000
        self.updated = (self.poll_started + now) / 2
        self.duration = metadata.get("mpris:length", 0) / 1_000_000
        playback = properties.get("PlaybackStatus", "Stopped")
        self.playback_state = playback
        track_id = metadata.get("mpris:trackid")
        self.player_track_id = (track_id if isinstance(track_id, str)
                                and GLib.Variant.is_object_path(track_id) else None)
        self.media_play.set_label('⏸ Pause' if playback == 'Playing' else '▶ Lecture')
        # Ne pas changer de chanson au milieu du tour d'un joueur.
        navigation = self.party.active is None
        self.media_previous.set_sensitive(navigation)
        self.media_next.set_sensitive(navigation)
        self.rate = properties.get("Rate", 1.0) if playback == "Playing" else 0.0
        if self.music_window is not None:
            self.music_window.update_current(metadata.get('mpris:trackid'), playback)
        self.set_track(local_track(metadata.get("xesam:url")))
        self.refresh_tv_cover(metadata.get("mpris:artUrl"))
        self.load_lines()
        self.observe_turn(playback)

    def refresh_tv_cover(self, url):
        key = self.track, url if isinstance(url, str) else None
        if key != self.tv_cover_key:
            self.tv_cover_key = key
            self.tv_cover = "", ""
            self.next_tv_update = 0.
        if self.tv_cover_pending is not None:
            pending_key, future = self.tv_cover_pending
            if not future.done():
                return
            self.tv_cover_pending = None
            if pending_key == key:
                self.tv_cover = future.result()
                self.next_tv_update = 0.
                return
        if key != getattr(self, "tv_cover_requested", None):
            self.tv_cover_requested = key
            self.tv_cover_pending = key, self.tag_reader.submit(current_cover, *key)

    def load_lines(self):
        if self.track is None:
            self.show_empty("Lance un morceau de ~/Music dans Strawberry.", fetch=False)
            return
        path = self.track.with_suffix(".lrc")
        try:
            source_token = lrc_token(path)
        except (OSError, ValueError):
            source_token = None
        if (self.track, source_token) != self.file_token:
            self.file_token = self.track, source_token
            self.lyric_source = read_source(self.track) if source_token is not None else None
            if self.lyric_source:
                self.set_lines(self.lyric_source[2])
            else:
                self.set_lines([])
        if not self.rows:
            notice = ("Recherche des paroles minutées…" if self.fetching == self.track else
                      self.fetch_message or "Les paroles minutées de ce morceau sont indisponibles.")
            self.show_fallback(notice, fetch=source_token is None)

    def load_embedded(self):
        try:
            info = self.track.stat()
        except OSError:
            return ""
        token = (self.track, info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns, info.st_size,
                 sidecar_token(self.track.with_suffix(".txt")))
        if self.tag_job is not None:
            pending, future = self.tag_job
            if future.done():
                self.tag_job = None
                if pending == token:
                    self.tag_text = future.result()
                    self.tag_token = token
        if token == self.tag_token:
            return self.tag_text
        if self.tag_job is None:
            self.tag_job = token, self.tag_reader.submit(embedded_lyrics, self.track)
        return None

    def show_fallback(self, message, *, fetch=True):
        text = self.load_embedded()
        if not text:
            self.show_empty("Lecture des paroles intégrées…" if text is None else message, fetch=fetch)
            return
        if self.plain_label.get_text() != text or self.stack.get_visible_child_name() != "plain":
            self.plain_label.set_text(text)
            self.plain_scroll.get_vadjustment().set_value(0)
        status = "Paroles non synchronisées"
        if self.fetching == self.track or self.fetch_message or not fetch:
            status += f" · {message}"
        self.set_footer(status, fetch)
        self.stack.set_visible_child_name("plain")

    def set_footer(self, notice, fetch):
        self.notice.set_text(notice)
        self.notice.set_visible(bool(notice))
        self.button.set_visible(fetch)
        self.button.set_sensitive(self.fetching is None)
        self.footer.set_visible(bool(notice) or fetch)

    def show_empty(self, message, *, fetch=True):
        self.message.set_text(message)
        self.set_footer("", fetch and self.track is not None)
        self.stack.set_visible_child_name("empty")

    def fetch(self, _button):
        track = self.track
        if self.fetching is not None or track is None:
            return
        try:
            process = Gio.Subprocess.new(
                [str(BIN / "paroles-musique"), "--bibliotheque", str(LIBRARY), "--synchro", "--", str(track)],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error:
            self.fetch_message = "Impossible de lancer paroles-musique."
            self.load_lines()
            return
        self.fetch_message = ""
        self.fetching = track
        self.load_lines()
        process.communicate_utf8_async(None, None, self.fetch_complete, track)

    def fetch_complete(self, process, result, track):
        self.fetching = None
        if self.closed or track != self.track:
            return
        try:
            _, output, _ = process.communicate_utf8_finish(result)
        except GLib.Error:
            output = ""
        if not process.get_successful():
            self.fetch_message = "La recherche a échoué. Tu peux réessayer."
        elif "instrumental" in (output or "") and not self.tag_text:
            self.fetch_message = "La source indique un morceau instrumental."
        else:
            self.fetch_message = "Aucune source n’a fourni de paroles minutées vérifiables."
        self.load_lines()

    def set_lines(self, lines):
        for label in self.rows:
            self.box.remove(label)
        self.rows = []
        self.raw_lines = lines
        self.apply_timing()
        self.lyrics = [text for _, text, _ in lines]
        self.active = -1
        self.highlight = -1
        self.view_lyrics = self.lyrics
        for text in self.view_lyrics:
            label = Gtk.Label(label=text, xalign=0.5, justify=Gtk.Justification.CENTER, wrap=True,
                              css_classes=["lyric"])
            self.box.append(label)
            self.rows.append(label)
        self.scroll.get_vadjustment().set_value(0)
        if self.rows:
            self.style_lines()
            self.set_footer("", False)
            self.stack.set_visible_child_name("lyrics")

    def style_lines(self):
        anchor = max(0, self.active)
        for index, row in enumerate(self.rows):
            classes = ["lyric"]
            if index == self.active:
                classes.append("active")
            else:
                distance = abs(index - anchor) + (1 if index < anchor else 0)
                if distance >= 2:
                    classes.append(LYRIC_FADES[min(distance - 2, len(LYRIC_FADES) - 1)])
            row.set_css_classes(classes)

    def log_playback_reference(self, original):
        session = self.blackbox.status()["session"]
        if not session or not self.blackbox.active():
            return
        context = dict(self.turn_context())
        # Snapshot the owning GTK values before sending the disk read.
        source = self.lyric_source
        displayed = list(zip(self.times, self.lyrics))
        plain = self.tag_text

        def identify():
            try:
                files = {"original": {"library_path": str(original.relative_to(LIBRARY.resolve())),
                                      "sha256": digest(original)}}
            except (OSError, ValueError):
                self.blackbox.emit("audio", "error", **context, recording_session=session,
                                   operation="reference-identification")
            else:
                self.blackbox.emit("audio", "reference", **context, recording_session=session, files=files)
                original_text = source[0] if source else plain
                source_kind = "sidecar-lrc" if source else "embedded" if plain else "unavailable"
                try:
                    document = lyrics_snapshot(files, source_kind, original_text, displayed)
                    if source:
                        document["lrc_word_marks"] = [marks for _, _, marks in source[2]]
                        document["display_offset_s"] = displayed[0][0] - source[2][0][0]
                    record_lyrics(self.blackbox, session, context, document)
                except (KeyError, TypeError, ValueError):
                    self.blackbox.emit("lyrics", "reference-unavailable", **context,
                                       recording_session=session, reason="snapshot-invalid")

        self.tag_reader.submit(identify)

    def animate(self):
        now = time.monotonic()
        position = self.base_position + (now - self.updated) * self.rate
        if now >= self.media_updated:
            self.media_updated = now + .35
            def clock(seconds):
                whole = max(0,int(seconds))
                return f'{whole//60}:{whole%60:02d}'
            self.media_clock.set_text(f'{clock(position)} / {clock(self.duration)}')
        self.advance_turn(now)
        self.remote_party.tick(now)
        player = self.party.active
        context = self.turn_context()
        playing = bool(os.environ.get("KARA_SILENT") != "1" and self.turn_phase == "playing"
                       and player and self.track == player.song.path and self.rate > 0 and context)
        if playing != self.bb_audio_playing:
            self.bb_audio_playing = playing
            self.room_audio.record_playing(playing)
        testing = self.turn_phase in ("awaiting-mic", "countdown")
        if player and player.mobile_id and (playing or testing) and self.room_audio.consented():
            self.acoustic.update(context, self.room_audio.selected_sink())
        else:
            self.acoustic.update()
        if playing and now >= self.next_capture_clock and self.blackbox.active():
            self.next_capture_clock = now + 1.
            self.blackbox.emit("audio", "music-clock", **context, position=self.base_position,
                               strawberry_monotonic_ns=round(self.updated * 1_000_000_000),
                               playback_rate=self.rate)
        self.update_tv(position, now)
        if not self.rows or not self.scroll.get_mapped():
            return GLib.SOURCE_CONTINUE
        active = self.view_anchor(position)
        if active != self.active:
            if self.active >= 0:
                self.rows[self.active].set_text(self.view_lyrics[self.active])
            self.active = active
            self.highlight = -1
            self.style_lines()
            self.blackbox.emit("lyrics", "pc-line", **context, position=position, line=active,
                               timing_engine="lrc-original")

        if active >= 0:
            self.progress_line(position, active)
            self.center_line(self.rows[active])
        else:
            adjustment = self.scroll.get_vadjustment()
            adjustment.set_value(adjustment.get_value() * 0.8)
        return GLib.SOURCE_CONTINUE

    def display_progress(self, position, active, *, utf16=False):
        text = self.view_lyrics[active]
        if not text:
            return 0.0
        marks = self.word_marks[active]
        if not marks:
            # Line LRC has no trustworthy word timings. Hold the current row
            # highlighted for its actual interval.
            return 1.
        source_position = position - self.timing_offset
        shown = max((end for stamp, _, end in marks if stamp <= source_position), default=0)
        if utf16:
            prefix = int(shown)
            units = len(text[:prefix].encode("utf-16-le")) / 2
            units += (shown - prefix) * (len(text[prefix:prefix + 1].encode("utf-16-le")) / 2)
            return units / (len(text.encode("utf-16-le")) / 2)
        return shown / len(text)

    def progress_line(self, position, active):
        text = self.view_lyrics[active]
        count = int(self.display_progress(position, active) * len(text) + 1e-8)
        if count != self.highlight:
            done = GLib.markup_escape_text(text[:count])
            pending = GLib.markup_escape_text(text[count:])
            self.rows[active].set_markup(
                f'<span background="#b4befe" foreground="#181825">{done}</span>{pending}'
            )
            self.highlight = count

    def pad_lyrics(self, adjustment):
        # La première et la dernière ligne peuvent aussi atteindre le point de lecture.
        page = round(adjustment.get_page_size())
        if page:
            top = round(page * LYRIC_FOCUS)
            if self.box.get_margin_top() != top or self.box.get_margin_bottom() != page - top:
                self.box.set_margin_top(top)
                self.box.set_margin_bottom(page - top)

    def center_line(self, row):
        adjustment = self.scroll.get_vadjustment()
        found, bounds = row.compute_bounds(self.box)
        if not found or not adjustment.get_page_size():
            return
        middle = bounds.get_y() + bounds.get_height() / 2
        desired = middle + self.box.get_margin_top() - adjustment.get_page_size() * LYRIC_FOCUS
        maximum = max(0.0, adjustment.get_upper() - adjustment.get_page_size())
        desired = min(maximum, max(0.0, desired))
        old = adjustment.get_value()
        adjustment.set_value(desired if abs(desired - old) < 1 else old + (desired - old) * 0.2)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None
        self.service_owner = False
        self.add_main_option("service", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Démarre le serveur Kara de la session sans afficher Parole", None)

    def do_command_line(self, command):
        service = command.get_options_dict().contains("service")
        if service and command.get_is_remote():
            command.printerr_literal("Parole possède déjà le serveur Kara.\n")
            return 0
        if self.window is None:
            style = Gtk.CssProvider()
            style.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), style,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.window = LyricsWindow(self)
            if service:
                window = self.window
                if not window.receiver or not window.receiver.https_listener:
                    command.printerr_literal("Écouteur HTTPS Kara indisponible. Vérifie les journaux et la configuration.\n")
                    window.close_window(window)
                    window.destroy()
                    return 1
                self.service_owner = True
                # The graphical-session service keeps the existing owner and
                # its maintenance queue alive before the first window is shown.
                window.start_maintenance(background=True)

                def hide(widget):
                    widget.set_visible(False)
                    return True

                # The same D-Bus application owns the controller in both
                # modes. Closing its optional window cannot close the room.
                window.disconnect_by_func(window.close_window)
                window.connect("close-request", hide)
                GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop_service)
            else:
                self.window.connect("close-request", self.release_window)
        if not service:
            self.window.open_parole()
        return 0

    def release_window(self, _window):
        self.window = None
        return False

    def stop_service(self):
        if self.window:
            self.window.close_window(self.window, wait=False)
            GLib.timeout_add(200, self.service_finalized)
        else:
            self.quit()
        return GLib.SOURCE_REMOVE

    def service_finalized(self):
        # Keep the owner alive until BlackBox finishes its disk verification.
        # Systemd still puts a deadline on an unresponsive storage device.
        maintenance = self.window.maintenance
        if (self.window.blackbox.status()["finalizing"]
                or maintenance and maintenance.thread and maintenance.thread.is_alive()):
            return GLib.SOURCE_CONTINUE
        self.window.destroy()
        self.quit()
        return GLib.SOURCE_REMOVE


if __name__ == "__main__":
    raise SystemExit(App().run(sys.argv))
