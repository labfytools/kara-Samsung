    def start_maintenance(self, *, background=False):
        if not self.maintenance:
            self.maintenance = Maintenance(LIBRARY, COLLECTION, import_queue=self.album_import.queue,
                                           cache=self.references, background=background)
            self.album_import.provider_enabled = self.maintenance.index.source_enabled
            self.album_import.measure_index = self.maintenance.index
            self.album_import.refresh_providers()
            self.maintenance.set_priority(self.maintenance_busy())
            self.maintenance.start()
        elif not background:
            self.maintenance.show()

    def open_parole(self):
        self.start_maintenance()
        if not self.parole_ui:
            self.parole_ui = ParoleView(self, self.maintenance)
            self.set_titlebar(self.parole_ui.header())
            self.set_child(self.parole_ui.root)
            self.timers.append(GLib.timeout_add(850, self.parole_ui.refresh))
        self.present()

    def open_import(self, _button=None):
        if self.import_window is None:
            self.import_window = Gtk.Window(title="Importer des albums", transient_for=self,
                                            destroy_with_parent=True, hide_on_close=True,
                                            default_width=980, default_height=630)
            scroll = Gtk.ScrolledWindow(vexpand=True)
            scroll.set_child(self.album_import)
            self.import_window.set_child(scroll)
        self.import_toggle.set_active(True)
        self.import_window.present()

    def maintenance_busy(self):
        # The maintenance owner already yields heavy preparation to pending
        # imports. Import activity itself must not block their enrichment.
        return bool(self.validating or self.party.active is not None or self.game_score.requested
                    or self.remote_party.phase in ("preparing", "running")
                    or self.playback_state == "Playing")

    def toggle_vocal_effect(self, button):
        if self.effect_changing:
            return
        if button.get_active() and os.environ.get("KARA_SILENT") == "1":
            button.set_active(False)
            return
        if button.get_active():
            position = self.base_position + (time.monotonic() - self.updated) * self.rate
            enabled = self.vocal_effect.enable(position, self.rate > 0)
            if not enabled:
                self.effect_changing = True
                button.set_active(False)
                self.effect_changing = False
        else:
            self.vocal_effect.disable()
        self.update_vocal_effect()

    def change_vocal_strength(self, dropdown, _spec):
        self.vocal_effect.set_strength(dropdown.get_selected())
        self.update_vocal_effect()

    def update_vocal_effect(self):
        effect = self.vocal_effect
        self.effect_strength.set_sensitive(effect.active and self.party.active is None)
        self.effect_toggle.set_sensitive(self.party.active is None)
        if effect.active:
            self.effect_state.set_text(f"Mix IA · {STRENGTHS[effect.strength][0]}")
        elif effect.error:
            self.effect_state.set_text(effect.error)
        elif effect.stems:
            self.effect_state.set_text("Instrumental IA prêt · lecture normale")
        else:
            self.effect_state.set_text("Valide la partie pour préparer l'instrumental")
            if self.effect_toggle.get_active():
                self.effect_changing = True
                self.effect_toggle.set_active(False)
                self.effect_changing = False

    def poll_vocal_effect(self):
        if self.closed:
            return GLib.SOURCE_REMOVE
        if self.vocal_effect.active:
            self.vocal_effect.poll()
            self.update_vocal_effect()
        return GLib.SOURCE_CONTINUE

    def search_missing(self, _button, option, title):
        self.open_import()
        self.album_import.start_maintenance(option, title)

    def show_players(self, _button):
        self.ensure_players_window()
        self.players_window.present()

    def ensure_players_window(self):
        if self.players_window is None:
            self.players_window = PlayersWindow(self, COLLECTION, LIBRARY.resolve())

    def show_admin_code(self, _button):
        if self.receiver is None:
            Gtk.AlertDialog(message="Ouvre d’abord la salle Kara.").show(self)
            return
        code = self.receiver.room.issue_admin_code()
        dialog = Gtk.AlertDialog(message=f"Code organisateur · {code}",
                                 detail="À saisir dans Admin sur ton téléphone. Valable cinq minutes.")
        dialog.show(self)

    def start_blackbox(self, consent, voice=False, tracks=None):
        self.blackbox.start(consent=consent, voice=voice, tracks=tracks, configuration={
            "capture": "diagnostics", "score_tolerance_s": self.game_score.tolerance,
            "whisper": "large-v3-turbo", "turbo_device": os.environ.get("KARA_TURBO_DEVICE", "gpu"),
            "lyric_offset_s": self.timing_offset,
        })
        self.bb_line = None
        self.blackbox.emit("party", "recording-start", mode="diagnostics+pcm" if voice else "diagnostics")

    def stop_blackbox(self, reason="manual", *, wait=False):
        self.acoustic.update()
        self.blackbox.stop(reason, wait=wait)

    def toggle_blackbox(self, _button):
        status = self.blackbox.status()
        if status["active"]:
            self.stop_blackbox()
        elif not status["finalizing"]:
            detail = "Confirme l’accord des participants et des responsables des mineurs. "
            detail += "Le mode diagnostics enregistre les événements, les paroles et la notation. "
            detail += ("Le mode audio enregistre aussi le monitor et le micro témoin pendant la lecture des tours. "
                       "Obtiens l’accord explicite de chaque participant. Prévois environ 4 à 5 Go par heure de jeu.")
            if status["latest"]:
                detail += f"\n\nDernière session : {status['latest']['session']}"
            dialog = Gtk.AlertDialog(message="Activer BlackBox ?", detail=detail,
                                     buttons=["Annuler", "Diagnostics", "Diagnostics + audio"],
                                     cancel_button=0, default_button=0)

            def confirmed(source, result):
                try:
                    choice = source.choose_finish(result)
                    if choice in (1, 2):
                        self.start_blackbox(True, voice=choice == 2)
                except (OSError, ValueError, GLib.Error) as error:
                    Gtk.AlertDialog(message="BlackBox indisponible", detail=str(error)).show(self)

            dialog.choose(self, None, confirmed)

    def update_party_services(self):
        state = self.blackbox.status()
        now = time.monotonic()
        if (not state["active"] and now >= self.blackbox_disk_check
                and (self.blackbox_disk_task is None or self.blackbox_disk_task.done())):
            self.blackbox_disk_check = now + 15.
            self.blackbox_disk_task = self.tag_reader.submit(self.blackbox.disk_available)
        label = ("● BlackBox active" if state["active"] else "Finalisation BlackBox…"
                 if state["finalizing"] else "BlackBox")
        if (label, state["error"], state["latest"]) != self.blackbox_ui:
            self.blackbox_ui = label, state["error"], state["latest"]
            self.blackbox_button.set_label(label)
            self.blackbox_button.set_sensitive(not state["finalizing"])
            if state["active"]:
                self.blackbox_button.add_css_class("destructive-action")
            else:
                self.blackbox_button.remove_css_class("destructive-action")
            self.blackbox_button.set_tooltip_text(state["error"] or (state["latest"] or {}).get("session")
                                                   or "Enregistrer les diagnostics de la partie")
        self.album_import.launch_next()
        if self.maintenance:
            self.maintenance.set_priority(self.maintenance_busy())
        return GLib.SOURCE_CONTINUE

    def set_remote_music_volume(self, percent):
        if type(percent) is not int or not 0 <= percent <= 100:
            raise ValueError("Volume musical invalide.")
        if self.turn_music_restore is not None:
            self.turn_music_restore = percent / 100
            if self.party.active is not None:
                self.apply_player_mix(self.party.active)
        else:
            self.write_music_volume(percent / 100)
        self.blackbox.emit("audio", "music-volume", percent=percent)

    def write_music_volume(self, level, callback=None, *, stage=False):
        if not stage:
            self.music_volume = level
            self.vocal_effect.set_master(level)
        self.bus.call(PLAYER, OBJECT, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", (INTERFACE, "Volume", GLib.Variant("d", level))),
                      None, Gio.DBusCallFlags.NO_AUTO_START, 4000, None, callback)

    def apply_player_mix(self, player, *, music_changed=True, original_changed=True):
        if self.turn_music_restore is None or self.turn_phase not in ("opening", "playing"):
            return
        ceiling = round(100 * min(1., self.turn_music_restore))
        music = player.music_volume if player.music_volume is not None else 100
        self.vocal_effect.set_turn_mix(music, player.original_voice, ceiling)
        if original_changed:
            position = max(0., self.base_position + (time.monotonic() - self.updated) * self.rate)
            if self.turn_phase == "opening":
                position = 0.
            if player.original_voice and (not self.guide_intervals or self.guide_intervals[-1][1] is not None):
                if len(self.guide_intervals) >= 128:
                    self.guide_intervals[:] = [(0., None)]
                else:
                    self.guide_intervals.append((max(0., position - .25), None))
            elif (not player.original_voice and self.guide_intervals
                  and self.guide_intervals[-1][1] is None and len(self.guide_intervals) < 128):
                begin, _ = self.guide_intervals[-1]
                self.guide_intervals[-1] = (begin, max(begin, position) + 2.)
        self.blackbox.emit("audio", "stem-mix", turn=self.bb_turn, player=player.name,
                           song=player.song.title, position=self.base_position if self.turn_phase == "playing" else 0.,
                           music_requested=music, music_applied=min(music, ceiling),
                           original_applied=player.original_voice,
                           music_gain=self.vocal_effect.targets["music"], original_gain=self.vocal_effect.targets["vocal"])

    def refresh_after_import(self, task, jobs):
        self.import_refresh_tasks[task.identity] = (task, jobs)
        if self.import_refresh_timer is None and not self.import_refresh_active:
            self.import_refresh_timer = GLib.timeout_add(250, self.reload_after_import)

    def report_import_update(self, job, kind, payload):
        self.mobile_imports.update(job, kind, payload)
        if kind in {"queue", "suspended"} and getattr(self, "maintenance", None):
            self.maintenance.journal.emit("DOWNLOAD", payload["message"])
            self.maintenance.wake.set()
        if kind == "album" and payload.get("tracks"):
            self.import_published_paths.update(map(Path, payload["tracks"]))
            if self.import_refresh_timer is None and not self.import_refresh_active:
                self.import_refresh_timer = GLib.timeout_add_seconds(3, self.reload_after_import)
            if payload.get("enrichment") and self.maintenance:
                self.maintenance.wake.set()
        if getattr(self, "maintenance", None) and payload.get("provider"):
            if kind == "provider":
                self.maintenance.journal.emit("DOWNLOAD", payload["message"])
            elif kind == "album":
                level = "WARNING" if payload["status"] in {"failure", "partial"} else "INFO"
                rate = payload.get("measured_bytes_per_second")
                throughput = f" · {rate / (1024**2):.2f} Mio/s mesurés" if rate else ""
                self.maintenance.journal.emit(
                    "DOWNLOAD", f"{payload['provider']} · {payload['title']} · {payload['message']}{throughput}", level)

    def artist_group_changed(self, plan, *, reverse=False):
        old, new = set(), set()
        for row in plan["moves"]:
            source, target = (LIBRARY.resolve() / row[key] for key in ("source", "destination"))
            if reverse:
                source, target = target, source
            for name in row["file_names"]:
                if Path(name).suffix.lower() in AUDIO:
                    old.add(source / name)
                    new.add(target / name)
        if self.receiver is not None:
            self.receiver.room.remove_catalogue_paths(old)
        self.import_published_paths.update(new)
        if self.import_refresh_timer is None and not self.import_refresh_active:
            self.import_refresh_timer = GLib.timeout_add(250, self.reload_after_import)
        if self.music_window:
            GLib.timeout_add_seconds(4, self.refresh_import_library_window)
        self.maintenance.rescan()

    def reload_after_import(self):
        self.import_refresh_timer = None
        if self.closed:
            return GLib.SOURCE_REMOVE
        pending, self.import_refresh_tasks = self.import_refresh_tasks, {}
        published, self.import_published_paths = self.import_published_paths, set()
        generations = [(task.identity, task.refresh_generation) for task, _ in pending.values()]
        receiver = self.receiver
        jobs = [job for _, linked in pending.values() for job in linked]
        paths = {Path(path).resolve() for task, _ in pending.values()
                 for outcome in task.outcomes.values() for path in outcome.get("tracks", [])}
        paths.update(Path(path).resolve() for job in jobs for outcome in job["results"].values()
                     for path in outcome.get("tracks", []))
        paths.update(published)
        def reload():
            try:
                rows = catalogue(COLLECTION, LIBRARY.resolve()) if pending else []
            except (OSError, sqlite3.Error):
                rows = []
            indexed = {song.path for song, _ in rows}
            for path in sorted(paths - indexed):
                if not path.is_relative_to(LIBRARY.resolve()) or not path.is_file():
                    continue
                try:
                    tags, _ = probe(path)
                    song = Song(path, tags.get("title") or path.stem, tags.get("artist", ""),
                                tags.get("album", ""))
                    rows.append((song, search_key(f"{song.title} {song.artist} {song.album}")))
                except (OSError, ValueError, subprocess.SubprocessError):
                    continue
            return rows

        def done(future):
            self.import_refresh_active = False
            if self.closed:
                return GLib.SOURCE_REMOVE
            try:
                rows = future.result()
                linked = receiver if self.receiver is receiver else None
                visible = {song.path for song, _ in rows if song.path.is_file()}
                if linked is not None:
                    linked.room.update_catalogue(rows, incremental=not pending)
                for task, _ in pending.values():
                    missing = [url for url, outcome in task.outcomes.items()
                               if outcome.get("audio_complete") and
                               not {Path(path).resolve() for path in outcome.get("tracks", [])} <= visible]
                    if missing:
                        self.album_import.queue.integration_failed(task.identity, task.refresh_generation, missing)
                        task.outcomes = self.album_import.queue.outcomes(task.identity)
                self.mobile_imports.integrated(jobs, linked, visible)
                self.album_import.acknowledge_refresh(generations)
                if pending and getattr(self, "maintenance", None):
                    self.maintenance.rescan()
                    self.maintenance.journal.emit("DOWNLOAD", f"{len(paths)} pistes signalées après import")
                if pending and self.music_window:
                    self.music_window.load_library()
                    # Strawberry can index files shortly after publication.
                    GLib.timeout_add_seconds(4, self.refresh_import_library_window)
            except (OSError, sqlite3.Error, RoomError, ValueError) as error:
                self.album_import.release_refresh(generations)
                self.blackbox.emit("imports", "error", stage="library-refresh", error=str(error))
            if self.import_refresh_tasks or self.import_published_paths:
                self.import_refresh_timer = GLib.timeout_add(250 if self.import_refresh_tasks else 3000,
                                                            self.reload_after_import)
            return GLib.SOURCE_REMOVE

        self.import_refresh_active = True
        self.tag_reader.submit(reload).add_done_callback(lambda future: GLib.idle_add(done, future))
        return GLib.SOURCE_REMOVE

    def refresh_import_library_window(self):
        if not self.closed and self.music_window:
            self.music_window.load_library()
        return GLib.SOURCE_REMOVE

    def show_preparation(self, _button):
        if self.preparation_window is None:
            self.preparation_window = PreparationWindow(self, COLLECTION, LIBRARY.resolve())
        self.preparation_window.present()

    def show_library(self, _button):
        if self.music_window is None:
            self.music_window = MusicLibraryWindow(self, COLLECTION, LIBRARY.resolve())
        self.music_window.present()
        self.music_window.refresh_queue(force=True)

    def player_command(self, method, parameters=None, callback=None):
        if os.environ.get("KARA_SILENT") == "1" and method in ("Play", "PlayPause", "OpenUri", "Next", "Previous"):
            return
        self.bus.call(PLAYER, OBJECT, INTERFACE, method, parameters, None,
                      Gio.DBusCallFlags.NO_AUTO_START, 4000, None, callback)

    def player_seeked(self, _bus, _sender, _path, _interface, _member, parameters):
        # Seeked supplies a position on the player timeline. Reception anchors
        # it on the Linux monotonic clock without involving phone or TV clocks.
        position, = parameters.unpack()
        self.base_position = max(0., position / 1_000_000)
        self.updated = time.monotonic()
        self.game_score.mark_seek()
        self.blackbox.emit("lyrics", "seek", turn=self.bb_turn, position=self.base_position)

    def party_choice(self):
        return tuple((player, player.song) for player in self.party.players)

    def validate_party(self, _button):
        if self.validating or self.party.active is not None or not self.party.players:
            return
        songs = [player.song for player in self.party.players]
        if None in songs:
            self.players_window.message.set_text("Chaque joueur doit choisir un morceau.")
            return
        self.begin_preparation(songs, for_party=True)

    def can_skip_failed(self):
        return (not self.validating and not self.party_ready and bool(self.failed_alignments)
                and bool(self.validated_songs) and self.party_choice() == self.party_selection)

    def skip_failed(self, _button):
        if self.can_skip_failed():
            self.party.excluded = set(self.failed_alignments)
            self.party_ready = True
            self.players_window.message.set_text("Partie prête. Les morceaux en échec ont été écartés.")
            self.players_window.refresh()

    def unscored_choices(self):
        if self.validating or self.party_ready or self.party_choice() != self.party_selection:
            return set()
        return {path for path in self.failed_alignments if local_track(path.as_uri()) == path}

    def allow_unscored(self, _button):
        paths = self.unscored_choices()
        if paths:
            self.party.unscored = paths
            self.party.excluded = self.failed_alignments.keys() - paths
            self.party_ready = True
            self.players_window.message.set_text("Partie prête. Les morceaux signalés seront chantés sans note.")
            self.players_window.refresh()

    def preparation_status(self, path):
        report = self.preparation_reports.get(path)
        if path in self.validated_songs and report:
            return f"Prêt à noter · {report['word_coverage']:.0%} de mots évaluables"
        if path in self.failed_alignments:
            return (f"Référence insuffisante · {report['word_coverage']:.0%} de mots repérés"
                    if report and "word_coverage" in report else "Préparation indisponible")
        return ""

    def preload_songs(self, songs, *, force=False):
        """Prépare des chansons de la bibliothèque sans créer de partie."""
        if self.validating or self.party.active is not None or self.game_toggle.get_active():
            if self.preparation_window is not None:
                self.preparation_window.message.set_text("Termine la partie ou le traitement en cours.")
            return False
        return self.begin_preparation(songs, for_party=False, force=force)

    def cancel_preparation(self):
        self.interrupt_preload()

    def interrupt_preload(self):
        if not self.validating or not self.preparation_only or self.preload_cancelled:
            return
        self.preload_cancelled = True
        self.stem_queue.clear()
        if self.preparation_window is not None:
            self.preparation_window.message.set_text("Annulation en cours…")
            self.preparation_window.update_controls()
        processes = (self.align_job, self.stem_job[1] if self.stem_job else None)
        for process in processes:
            if process is not None:
                try:
                    process.send_signal(signal.SIGTERM)
                except GLib.Error:
                    pass
        if all(process is None for process in processes):
            self.complete_party_validation()

    def begin_preparation(self, songs, *, for_party, force=False, force_paths=()):
        if self.closed or self.validating or self.party.active is not None:
            return False
        if getattr(self, "maintenance", None) and not self.maintenance.yield_heavy():
            return False
        plan = {song.path: song.title for song in songs}
        if not plan:
            return False
        self.preparation_only = not for_party
        self.preload_cancelled = False
        self.active_plan = plan
        self.training_only = (self.remote_party.training_paths()[1]
                              if for_party and self.remote_party.phase == "preparing" else set())
        self.align_finished.clear()
        self.batch_failed = {}
        self.batch_reports = {}
        self.batch_ready = {}
        if for_party:
            self.party_selection = self.party_choice()
            self.party_ready = False
            self.party.excluded.clear()
            self.party.unscored.clear()
        self.game_toggle.set_active(False)
        self.validating = True
        retried = [str(path) for path in plan if path in force_paths]
        self.blackbox.emit("turbo", "preparation-start", count=len(plan), force=force,
                           retried=len(retried), for_party=for_party)
        self.stem_queue = {}
        self.stem_completed = 0
        self.stem_failed.clear()
        for path in plan:
            if local_track(path.as_uri()) != path:
                self.batch_failed[path] = "Fichier audio local introuvable."
                self.align_finished.add(path)
        if self.preparation_window is not None and self.preparation_only:
            self.preparation_window.set_busy(True)
        if self.players_window is not None:
            self.players_window.refresh()
        paths = [str(path) for path in plan if path not in self.batch_failed]
        if paths:
            command = ["nice", "-n", "8", sys.executable, "-B", str(BIN / "_kara_prepare.py"),
                       "--cache", str(self.references.root), "--separate-if-needed",
                       *(["--force"] if force else []),
                       *(["--trace"] if self.blackbox.status()["active"] else []),
                       *(arg for path in retried for arg in ("--force-path", path)), *paths]
            try:
                process = Gio.Subprocess.new(command, Gio.SubprocessFlags.STDOUT_PIPE |
                                             Gio.SubprocessFlags.STDERR_SILENCE)
            except GLib.Error as error:
                for path in paths:
                    self.batch_failed[Path(path)] = str(error)
            else:
                self.align_job = process
                self.show_align_status("Vérification de la préparation Turbo…", 0)
                stream = Gio.DataInputStream.new(process.get_stdout_pipe())
                stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.read_alignment, process)
                return True
        self.complete_party_validation()
        return True

    def complete_party_validation(self):
        preload = self.preparation_only
        self.validating = False
        selected = self.party_choice() == self.party_selection
        if not preload:
            # Training needs the source audio and stems. A lyric-reference
            # failure still blocks paths used by at least one scored turn.
            for path in self.training_only & self.batch_failed.keys():
                if path not in self.stem_failed and local_track(path.as_uri()) == path and cached_stems(path):
                    self.batch_failed.pop(path)
            for path in self.active_plan:
                if path in self.stem_failed:
                    self.batch_failed[path] = "Pistes séparées indisponibles pour le mixage."
            self.failed_alignments = self.batch_failed
            self.preparation_reports = self.batch_reports
            self.validated_songs = self.batch_ready
            self.party_ready = selected and not self.failed_alignments and bool(self.validated_songs or self.training_only)
            if self.receiver is not None:
                self.receiver.room.set_prepared(self.validated_songs)
        elif any(path in self.validated_songs and current != self.validated_songs[path]
                 for path, current in self.batch_ready.items()) or self.batch_failed.keys() & self.validated_songs.keys():
            self.party_ready = False
        if preload and self.remote_party.background_path is not None:
            # One preparation owns the GPU at a time. A preempted generation
            # stays eligible for retry and never publishes a failure from SIGTERM.
            path = self.remote_party.background_path
            self.remote_party.background_path = None
            if not self.preload_cancelled:
                if path in self.stem_failed:
                    self.batch_failed[path] = "Pistes séparées indisponibles pour le mixage."
                    self.prepared_stems.pop(path, None)
                else:
                    try:
                        self.prepared_stems[path] = file_token(path)
                    except (OSError, ValueError):
                        self.batch_failed[path] = "Le fichier audio est indisponible."
                self.preparation_reports.update(self.batch_reports)
                if path in self.batch_failed:
                    self.failed_alignments[path] = self.batch_failed[path]
                    self.validated_songs.pop(path, None)
                elif path in self.batch_ready:
                    self.failed_alignments.pop(path, None)
                    self.validated_songs.update(self.batch_ready)
            if self.receiver is not None:
                self.receiver.room.set_prepared(self.validated_songs, failures=self.failed_alignments)
        ready = len(self.batch_ready.keys() | (self.training_only - self.batch_failed.keys()))
        if self.preload_cancelled:
            detail = "Préparation annulée. Les morceaux terminés restent en cache."
        elif self.batch_failed:
            total = len(self.active_plan)
            errors = [f"{self.active_plan[path]} · {error}" for path, error in self.batch_failed.items()]
            detail = f"{ready}/{total} morceau(x) prêt(s). " + " / ".join(errors)
        elif not preload and self.party_ready:
            detail = f"Partie prête · {ready} morceau(x)."
        elif not preload:
            detail = "La sélection des joueurs a changé. Relance la préparation."
        else:
            detail = f"{ready} morceau(x) prêt(s) dans le cache Turbo."
        if self.stem_failed:
            detail += f" Instrumental indisponible pour {len(self.stem_failed)} morceau(x)."
        self.show_align_status(detail, round(self.align_fraction * 100) if self.preload_cancelled else 100)
        if self.preparation_window is not None and preload:
            self.preparation_window.set_busy(False)
        self.preparation_only = False
        self.preload_cancelled = False
        self.active_plan = {}
        self.blackbox.emit("turbo", "preparation-end", ready=ready, failed=len(self.batch_failed))
        self.remote_party.prepared()
        if self.players_window is not None:
            self.players_window.refresh()
        GLib.timeout_add(650, self.hide_alignment_bars)

    def start_stem_generation(self):
        if self.closed or not self.validating or self.stem_job:
            return
        while self.stem_queue:
            path = next(iter(self.stem_queue))
            title = self.stem_queue.pop(path)
            if cached_stems(path):
                self.stem_completed += 1
                if self.track == path:
                    self.vocal_effect.refresh_stems()
                    self.update_vocal_effect()
                continue
            command = ("nice", "-n", "8", sys.executable, "-B", str(BIN / "_kara_stems.py"), str(path))
            try:
                process = Gio.Subprocess.new(command, Gio.SubprocessFlags.STDOUT_PIPE |
                                             Gio.SubprocessFlags.STDERR_SILENCE)
            except GLib.Error:
                self.stem_failed.add(path)
                self.stem_completed += 1
                continue
            self.stem_job = (path, process)
            self.show_align_status(f"Demucs · {title} · chargement du modèle", 0)
            stream = Gio.DataInputStream.new(process.get_stdout_pipe())
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.read_stem_event, process)
            return
        self.complete_party_validation()

    def read_stem_event(self, stream, result, process):
        if self.closed or not self.stem_job or self.stem_job[1] is not process:
            return
        path = self.stem_job[0]
        try:
            line, _ = stream.read_line_finish_utf8(result)
            event = json.loads(line) if line else None
        except (GLib.Error, ValueError):
            event = None
        if not isinstance(event, dict):
            self.stem_job = None
            process.wait_async(None, GameScore.reaped)
            if not cached_stems(path):
                self.stem_failed.add(path)
            elif self.track == path:
                self.vocal_effect.refresh_stems()
                self.update_vocal_effect()
            self.stem_completed += 1
            self.start_stem_generation()
            return
        if event.get("event") == "progress":
            self.show_align_status(f"Demucs · {event.get('status', 'Séparation en cours')}",
                                   min(100, max(0, int(event.get("percent", 0)))))
        elif event.get("event") == "error":
            self.stem_failed.add(path)
            if self.players_window is not None:
                self.players_window.message.set_text(event.get("message", "Séparation IA indisponible"))
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.read_stem_event, process)

    def hide_alignment_bars(self):
        if not self.closed and not self.validating:
            self.align_progress.set_visible(False)
            if self.players_window is not None:
                self.players_window.align_progress.set_visible(False)
        return GLib.SOURCE_REMOVE

    def show_align_status(self, detail, progress):
        total = max(1, len(self.active_plan))
        if self.stem_job:
            total_progress = .85 + .15 * (self.stem_completed + progress / 100) / total
        else:
            total_progress = progress / 100
        self.align_fraction = max(0.0, min(1.0, total_progress))
        self.align_status = f"{detail} · {round(self.align_fraction * 100)} %"
        bars = [self.align_progress]
        if self.players_window is not None and not self.preparation_only:
            self.players_window.message.set_text(detail)
            bars.append(self.players_window.align_progress)
        if self.preparation_window is not None and self.preparation_only:
            self.preparation_window.set_progress(detail, self.align_fraction)
        for bar in bars:
            bar.set_visible(True)
            bar.set_fraction(self.align_fraction)
            bar.set_text(f"{round(self.align_fraction * 100)} %")

    def read_alignment(self, stream, result, process):
        if self.closed or self.align_job is not process:
            return
        try:
            line, _ = stream.read_line_finish_utf8(result)
            event = json.loads(line) if line else None
        except (GLib.Error, ValueError):
            event = None
        if not isinstance(event, dict):
            self.align_job = None
            process.wait_async(None, GameScore.reaped)
            if not self.preload_cancelled:
                for path in self.active_plan.keys() - self.align_finished:
                    self.batch_failed[path] = "La préparation Turbo a été interrompue."
                # Preserve instrumental preparation independently of lyric recovery.
                self.stem_queue = {path: title for path, title in self.active_plan.items()
                                   if local_track(path.as_uri()) == path and cached_stems(path) is None}
                self.stem_completed = len(self.active_plan) - len(self.stem_queue)
            self.start_stem_generation()
            return
        path = Path(event.get("path", ""))
        if path in self.active_plan:
            kind = event.get("event")
            title = self.active_plan[path]
            count = len(self.active_plan)
            done = len(self.align_finished)
            if kind == "evidence":
                self.blackbox.emit("turbo", event["kind"], song=title, evidence=event["evidence"])
            elif kind in ("error", "progress", "result"):
                self.blackbox.emit("turbo", kind, song=title,
                                   phase=event.get("phase"), progress=event.get("percent"),
                                   ready=event.get("ready"), report=event.get("report"),
                                   duration=event.get("duration"), cached=event.get("cached"))
            if kind == "progress":
                stages = {"cache": "Vérification du cache", "lyrics": "Récupération des paroles",
                          "model": "Chargement du modèle", "transcription": "Analyse audio par Turbo",
                          "comparison": "Comparaison des paroles", "correction": "Correction des timestamps",
                          "words": "Synchronisation mot par mot", "separation": "Séparation de la voix",
                          "refinement": "Analyse locale des passages incertains",
                          "vocal_refinement": "Vérification locale sur la piste vocale",
                          "saving": "Enregistrement", "cached_insufficient": "Référence insuffisante · cache",
                          "ready": "Morceau prêt", "cached": "Morceau prêt · cache"}
                stage = stages.get(event.get("phase"), "Préparation")
                progress = round(85 * (done + event.get("percent", 0) / 100) / count)
                self.show_align_status(f"Morceau {min(count, done + 1)}/{count} · {title} · {stage}", progress)
            elif kind in ("result", "error"):
                self.align_finished.add(path)
                self.batch_reports[path] = event.get("report", {})
                item = self.references.cached(path, verify=False) if event.get("ready") else None
                if item is not None:
                    self.batch_ready[path] = (item["prepared_at"], item["lrc_sha256"])
                else:
                    report = event.get("report", {})
                    message = event.get("message") or report.get("message", "Préparation Turbo indisponible.")
                    if "word_coverage" in report:
                        message += (f" {report['word_coverage']:.0%} des mots et "
                                    f"{report['line_coverage']:.0%} des débuts de ligne repérés.")
                    self.batch_failed[path] = message
                if path == self.track:
                    self.file_token = None
                    self.load_lines()
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.read_alignment, process)

    def build_timing_controls(self):
        self.timing_menu = Gtk.MenuButton(label="Minutage", tooltip_text="Ajuster le défilement PC et TV")
        popover = Gtk.Popover()
        self.timing_menu.set_popover(popover)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                          margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        popover.set_child(content)
        content.append(Gtk.Label(label="Décalage des paroles en secondes", xalign=0))
        row = Gtk.Box(spacing=6)
        earlier = Gtk.Button(label="Avancer")
        later = Gtk.Button(label="Retarder")
        self.timing_spin = Gtk.SpinButton.new_with_range(-30, 30, .5)
        self.timing_spin.set_digits(1)
        self.timing_spin.connect("value-changed", self.change_timing)
        earlier.connect("clicked", lambda *_: self.timing_spin.spin(Gtk.SpinType.STEP_BACKWARD, .5))
        later.connect("clicked", lambda *_: self.timing_spin.spin(Gtk.SpinType.STEP_FORWARD, .5))
        row.append(earlier)
        row.append(self.timing_spin)
        row.append(later)
        content.append(row)
        reset = Gtk.Button(label="Remettre le décalage à zéro")
        reset.connect("clicked", lambda *_: self.timing_spin.set_value(0))
        content.append(reset)
        self.original_timing = Gtk.CheckButton(label="Afficher le LRC d’origine")
        self.original_timing.connect("toggled", lambda *_: self.load_lines() if self.track else None)
        content.append(self.original_timing)
        self.timing_message = Gtk.Label(xalign=0, wrap=True, css_classes=["lyrics-info"])
        content.append(self.timing_message)
        return self.timing_menu

    def apply_timing(self):
        scoring = self.game_toggle.get_active() or self.party.active is not None
        show_original = self.original_timing.get_active() and not scoring
        self.timing_offset = 0. if scoring else self.timing.offset(self.track)
        if self.active_reference and not show_original:
            lines = self.active_reference["lines"]
            self.times = [line["display_start"] + self.timing_offset for line in lines]
            self.word_marks = tuple(display_marks(line) for line in lines)
            self.word_times = tuple(tuple(word["start"] for word in line["words"]) for line in lines)
            self.word_ends = tuple(line["end"] for line in lines)
        elif show_original:
            self.times = [stamp + self.timing_offset for stamp, _ in self.raw_lines]
            self.word_marks = self.word_times = self.word_ends = ()
        else:
            self.times = self.timing.times(self.track, self.raw_lines)
            self.word_marks = self.timing.marks(self.track, self.raw_lines)
            self.word_times = self.word_ends = ()
        self.highlight = -1
        self.next_tv_update = 0
        self.timing_menu.set_sensitive(bool(self.track and self.raw_lines and not scoring))
        self.syncing_offset = True
        self.timing_spin.set_value(self.timing.offset(self.track))
        self.syncing_offset = False
        calibrated = bool(self.active_reference) and not show_original
        marked = sum(bool(marks) for marks in self.word_marks)
        lyric_lines = sum(bool(words(text)) for _, text in self.raw_lines)
        if marked:
            detail = f"Repères par mot sur {marked}/{lyric_lines} lignes."
            if marked < lyric_lines:
                detail += " Les autres lignes suivent le minutage par ligne."
        else:
            detail = "Réglage par rapport au calage Turbo." if calibrated else "Réglage par rapport au fichier LRC."
        self.timing_message.set_text(detail)

    def change_timing(self, spin):
        if self.syncing_offset or self.track is None or not self.raw_lines or self.game_toggle.get_active():
            return
        try:
            self.timing.set_offset(self.track, spin.get_value())
        except OSError:
            self.timing_message.set_text("Impossible d’enregistrer le décalage.")
            return
        self.apply_timing()

    def song_available(self, song, *, unscored=False):
        # The worker validated the stems and reference. The real turn repeats
        # the full check before opening audio to catch replacement in the interim.
        path = song.path
        try:
            stems = self.prepared_stems.get(path) == file_token(path)
        except (OSError, ValueError):
            return False
        return stems and (unscored or path in self.validated_songs)

    def start_turn(self, player, *, independent=False):
        if getattr(self, "maintenance", None):
            self.maintenance.set_priority(True)
        if self.validating or self.party.active is not None or player.song is None or not (independent or self.party_ready):
            return
        if os.environ.get("KARA_SILENT") == "1":
            self.players_window.message.set_text("La lecture et le microphone sont désactivés pour cette séance.")
            return
        path = player.song.path
        if path in self.party.excluded:
            return
        scored = (not self.remote_party.unscored_for(player, player.song) if independent else
                  path not in self.party.unscored and not player.training)
        reference = self.references.cached(path, verify=False) if scored else None
        if scored and (reference is None or self.validated_songs.get(path) != (
                reference["prepared_at"], reference["lrc_sha256"])):
            self.party_ready = False
            self.validated_songs.pop(path, None)
            self.failed_alignments[path] = "Le morceau ou sa référence a changé."
            self.players_window.message.set_text("Le morceau a changé. Valide à nouveau la partie.")
            self.players_window.refresh()
            return
        if not scored and local_track(path.as_uri()) != path:
            self.party_ready = False
            self.players_window.message.set_text("Le fichier du morceau est indisponible.")
            self.players_window.refresh()
            return
        if not cached_stems(path):
            self.party_ready = False
            self.prepared_stems.pop(path, None)
            self.failed_alignments[path] = "Les pistes du mixage ne sont plus disponibles."
            self.players_window.message.set_text("Les pistes du mixage ont changé. Prépare à nouveau la partie.")
            self.players_window.refresh()
            return
        self.game_toggle.set_active(False)
        self.bb_turn = self.remote_party.turn_id or token_hex(8)
        if self.remote_party.current and player.mobile_id:
            try:
                self.game_score.network_socket = self.room_audio.open_turn(
                    player.mobile_id, player.name, self.bb_turn, player.song.title, scoring=scored,
                    require_consent=independent)
                self.vocal_effect.output_override = self.room_audio.selected_sink()
            except ValueError as error:
                self.bb_turn = None
                self.players_window.message.set_text(str(error))
                self.blackbox.emit("audio", "error", operation="turn-route", player=player.name)
                return
        self.previous_result = player.score, player.done, player.result
        player.score, player.done, player.result = None, False, None
        self.party.active = player
        self.game_score.diagnostic_turn = {"turn": self.bb_turn, "player": player.name, "song": player.song.title}
        self.blackbox.emit("party", "turn-start", **self.game_score.diagnostic_turn, scored=scored, training=player.training,
                           reference={**{key: reference.get(key) for key in ("song_id", "prepared_at", "lrc_sha256",
                                       "language", "duration", "settings")},
                                      "audio_sha256": reference["audio"]["sha256"]} if reference else None)
        self.turn_scored = scored
        self.game_toggle.set_sensitive(scored)
        self.turn_phase = "preparing"
        self.turn_tail = None
        self.record_turn = scored and not independent and self.players_window.record_next.get_active()
        self.players_window.record_next.set_active(False)
        self.turn_opened = False
        self.turn_deadline = time.monotonic() + 45.0
        if scored:
            vocabulary = LyricVocabulary(line["text"] for line in reference["lines"])
            self.game_score.set_round(vocabulary.lines, vocabulary, reference=reference)
        else:
            self.game_score.set_round()
        self.players_window.message.set_text("")
        self.players_window.refresh()
        self.update_vocal_effect()
        if scored:
            self.game_toggle.set_active(True)
            self.sync_game()
        elif self.game_score.network_socket is not None:
            self.turn_phase = "awaiting-mic"
            self.turn_deadline = time.monotonic() + 75.
        else:
            # Explicit sing-only turns use the ordinary player path. They
            # never acquire the scoring worker, capture or recording route.
            self.begin_playback(player)

    def countdown(self):
        return max(0, ceil(self.countdown_end - time.monotonic())) if self.turn_phase == "countdown" else 0

    def request_turn_start(self):
        if self.turn_phase in ("countdown", "opening", "playing"):
            return
        if self.turn_phase != "awaiting-mic" or not self.room_audio.receiving(recent=True):
            raise RoomError("Le microphone doit transmettre avant le départ.", 409)
        if self.music_volume is None or time.monotonic() - self.player_seen > 2:
            raise RoomError("Le lecteur musical est indisponible.", 503)
        if time.monotonic() - self.receiver.secure_tv_seen >= 4:
            raise RoomError("La télévision Kara est déconnectée.", 409)
        player = self.party.active
        if not self.song_available(player.song, unscored=not self.turn_scored):
            raise RoomError("La chanson doit être préparée de nouveau.", 409)
        self.turn_phase = "countdown"
        self.countdown_end = time.monotonic() + 3.
        self.blackbox.emit("party", "countdown", turn=self.bb_turn, player=player.name, seconds=3)

    def begin_playback(self, player):
        self.turn_phase = "opening"
        self.turn_deadline = time.monotonic() + 12.0
        if self.music_volume is None:
            self.finish_turn(error="Le volume de Strawberry est indisponible.")
            return
        self.room_audio.enable_return()
        self.turn_music_restore = self.music_volume
        self.guide_intervals.clear()
        self.apply_player_mix(player)

        def opened(bus, result):
            if player is not self.party.active or self.turn_phase != "opening":
                return
            try:
                bus.call_finish(result)
            except GLib.Error:
                self.finish_turn(error="Impossible d’ouvrir le morceau dans Strawberry.")
            else:
                self.turn_opened = True

        def muted(bus, result):
            if player is not self.party.active or self.turn_phase != "opening":
                return
            try:
                bus.call_finish(result)
            except GLib.Error:
                self.finish_turn(error="Impossible d’isoler la sortie originale de Strawberry.")
                return
            self.player_command("OpenUri", GLib.Variant("(s)", (player.song.path.as_uri(),)), opened)

        # Strawberry remains the song/position owner. Its native mix must
        # already be silent when OpenUri begins, including at a guide of 0 %.
        self.write_music_volume(0., muted, stage=True)
        self.refresh_game()

    def scoring_source(self):
        effect = self.vocal_effect
        if effect.active and effect.playing and effect.stems:
            if effect.turn_mix and effect.turn_mix[1] and self.guide_intervals:
                position = self.base_position + (time.monotonic() - self.updated) * self.rate
                begin, end = self.guide_intervals[-1]
                if end is None and position < begin:
                    # A backwards seek can replay guide audio at positions
                    # preceding the original fader change.
                    self.guide_intervals[-1] = (0., None)
            return str(effect.stems[0]), str(effect.song), str(effect.stems[1]), tuple(self.guide_intervals)
        return None

    def observe_turn(self, playback, previous_track, previous_position, previous_duration, previous_times,
                     previous_word_times, previous_word_ends, previous_rate, previous_source, now):
        player = self.party.active
        if player is None:
            return
        song = player.song.path
        if self.turn_phase == "opening" and self.turn_opened:
            if self.track == song and self.rate > 0 and self.base_position < 2.0:
                if not self.turn_scored:
                    if not self.enable_turn_mix():
                        return
                    self.turn_phase = "playing"
                    self.log_playback_reference(player.song.path)
                    return
                if not self.times:
                    self.finish_turn(pause=True, error="Les paroles minutées ne sont plus disponibles.")
                    return
                if not self.active_reference or self.game_score.reference["prepared_at"] != self.active_reference["prepared_at"]:
                    self.finish_turn(pause=True, error="La préparation du morceau a changé.")
                    return
                if self.record_turn:
                    start = self.updated - self.base_position / self.rate
                    self.record_turn = self.game_score.record_turn(start, player.song.title)
                if not self.enable_turn_mix():
                    return
                self.turn_phase = "playing"
                self.log_playback_reference(player.song.path)
            return
        if self.turn_phase != "playing":
            return
        if self.track == song and playback == "Playing" and not self.vocal_effect.active:
            self.finish_turn(pause=True, error="Le mixage des pistes s’est arrêté.")
            return
        if not self.turn_scored:
            if self.track != song or playback == "Stopped":
                self.finish_turn()
            return
        if self.track == song and playback != "Stopped":
            if not self.active_reference or self.game_score.reference["prepared_at"] != self.active_reference["prepared_at"]:
                self.finish_turn(pause=True, error="La préparation a changé pendant le tour.")
            return
        if self.record_turn:
            self.game_score.record_turn()
            self.record_turn = False
        self.turn_phase = "finishing"
        self.acoustic.update()
        self.room_audio.close_turn()
        self.turn_deadline = now + 12.0
        if previous_track == song and previous_duration and previous_position >= previous_duration - 1:
            rate = previous_rate or 1.0
            end_time = now + (previous_duration - previous_position) / rate
            self.turn_tail = (previous_times, previous_duration, end_time,
                              previous_word_times, previous_word_ends, rate, previous_source)
            if self.track != song and playback == "Playing":
                self.player_command("Pause")

    def enable_turn_mix(self):
        self.turn_mix_strength = self.vocal_effect.strength
        self.effect_toggle.set_active(True)
        if self.vocal_effect.active:
            return True
        self.finish_turn(pause=True, error="Impossible de mélanger les deux pistes du morceau.")
        return False

    def advance_turn(self, now):
        player = self.party.active
        if player is None:
            return
        game = self.game_score
        if self.turn_phase == "preparing":
            if game.ready:
                if game.network_socket is not None:
                    self.turn_phase = "awaiting-mic"
                    self.turn_deadline = now + 75.
                else:
                    self.begin_playback(player)
            elif game.process is None or now >= self.turn_deadline:
                self.finish_turn(error=game.message or "Le micro ne s’est pas préparé.")
        elif self.turn_phase == "opening" and now >= self.turn_deadline:
            self.finish_turn(error="Strawberry n’a pas démarré la chanson sélectionnée.")
        elif self.turn_phase == "awaiting-mic":
            if not self.remote_party.opened_early and self.room_audio.receiving():
                self.begin_playback(player)
            elif ((not self.remote_party.opened_early and now >= self.turn_deadline)
                  or self.turn_scored and game.process is None):
                self.finish_turn(error="Le microphone du joueur n’a pas démarré.")
        elif self.turn_phase == "countdown":
            if (not self.room_audio.receiving(recent=True) or now - self.receiver.secure_tv_seen >= 4
                    or now - self.player_seen > 2 or not self.song_available(player.song, unscored=not self.turn_scored)):
                self.turn_phase = "awaiting-mic"
                self.turn_deadline = now + 75.
            elif now >= self.countdown_end:
                self.begin_playback(player)
        elif self.turn_phase == "playing" and game.requested and game.process is None:
            self.finish_turn(pause=True, error=game.message or "Le moteur de score s’est arrêté.")
        elif self.turn_phase == "finishing":
            if self.turn_tail is not None:
                game.flush_round(*self.turn_tail)
            if not game.pending or now >= self.turn_deadline:
                self.finish_turn()

    def finish_turn(self, *, pause=False, error=""):
        player = self.party.active
        if player is None:
            return
        self.acoustic.update()
        if pause and self.track == player.song.path and self.rate > 0:
            self.player_command("Pause")
        played = self.turn_phase in ("playing", "finishing")
        if played:
            result = self.game_score.breakdown if self.turn_scored else None
            # Evidence from an interrupted round is still diagnostic. It
            # cannot enter the ranking as a completed performance.
            if result and error:
                result = {**result, "score": None}
            player.score = result["score"] if result else None
            if result:
                player.result = {"summary": result, "lines": dict(self.game_score.line_results)}
                if not error:
                    score = ("Score indisponible" if result["score"] is None
                             else f"Score {result['score']} %")
                    error = f"{score} · {result['coverage']} % des mots évalués."
            elif not error:
                error = "Tour chanté sans note."
            player.done = True
        else:
            player.score, player.done, player.result = self.previous_result
        self.blackbox.emit("party", "turn-end", turn=self.bb_turn, player=player.name, song=player.song.title,
                           played=played, detail=error, summary=(player.result or {}).get("summary") if played else None)
        self.remote_party.turn_completed(player, error, played=played)
        self.game_score.diagnostic_turn = {}
        self.bb_turn = None
        if self.record_turn:
            self.game_score.record_turn()
            self.record_turn = False
        self.room_audio.close_turn()
        if self.game_score.network_socket is not None:
            self.game_score.network_socket.close()
            self.game_score.network_socket = None
        self.party.active = None
        self.vocal_effect.output_override = None
        if self.turn_mix_strength is not None:
            self.effect_toggle.set_active(False)
            self.effect_strength.set_selected(self.turn_mix_strength)
            self.turn_mix_strength = None
        self.vocal_effect.clear_turn_mix()
        if self.turn_music_restore is not None:
            self.write_music_volume(self.turn_music_restore)
            self.turn_music_restore = None
        self.update_vocal_effect()
        if player.mobile_id in self.mobile_leaving:
            self.mobile_leaving.discard(player.mobile_id)
            self.room_audio.forget_player(player.mobile_id)
            self.party.players = [p for p in self.party.players if p is not player]
            self.mobile_players.pop(player.mobile_id, None)
            self.party_ready = False
        self.turn_phase = ""
        self.turn_scored = True
        self.game_toggle.set_sensitive(True)
        self.turn_tail = None
        self.game_score.set_round()
        self.apply_timing()
        self.game_toggle.set_active(False)
        self.refresh_game()
        if self.players_window is not None:
            self.players_window.message.set_text(error)
            self.players_window.refresh()
        if played and self.remote_party.phase == "lobby" and self.party_ready and not self.party.next_player():
            self.stop_blackbox("party-end")

    def toggle_game(self, button):
        if button.get_active():
            self.kara_expander.set_expanded(True)
        if not button.get_active():
            self.finish_turn()
            self.game_score.stop()
        if self.track:
            self.load_lines()
        self.apply_timing()
        self.sync_game()

    def sync_game(self):
        if os.environ.get("KARA_SILENT") == "1":
            return
        if self.party.active is None:
            source = self.active_reference
            can_score = bool(source and self.track and self.scoring_source())
        else:
            source = self.game_score.reference
            can_score = self.turn_scored and bool(source) and (
                self.turn_phase in ("preparing", "awaiting-mic", "countdown", "opening", "finishing")
                or (self.turn_phase == "playing" and self.track == self.party.active.song.path))
        if self.game_toggle.get_active() and can_score and not self.validating:
            if self.game_score.reference is not source:
                self.game_score.pause()
                self.game_score.set_round([line["text"] for line in source["lines"]], reference=source)
            self.game_score.start()
        else:
            self.game_score.pause()
        self.refresh_game()

    def refresh_game(self):
        game = self.game_score
        if not self.game_toggle.get_active() or (self.party.active is not None and not self.turn_scored):
            self.game_status = "Chant sans note" if self.party.active is not None and not self.turn_scored else ""
            self.score_label.set_text(self.game_status)
            return
        player = self.party.active
        breakdown = game.breakdown
        new_score = breakdown["score"] if breakdown is not None else game.score
        if player is not None:
            if player.score != new_score:
                player.score = new_score
                if self.players_window is not None:
                    self.players_window.refresh_scores()
        score = f"Score {new_score} %" if new_score is not None else "Score —"
        if self.turn_phase == "opening":
            status = "Ouverture dans Strawberry…"
        elif self.turn_phase == "finishing":
            status = "Calcul du score final…"
        elif game.message:
            status = game.message
        elif not self.active_reference:
            status = "Préparation Turbo nécessaire"
        elif self.rate > 0 and not self.scoring_source():
            status = "Instrumental requis pour noter la voix"
        elif not self.rate:
            status = "En pause"
        elif game.feedback:
            status = game.feedback
        else:
            status = "Micro filtré" if game.echo else "Micro actif"
        if breakdown is not None:
            status += f" · {breakdown['coverage']} % des mots évalués"
        if game.ready and game.model == "Turbo":
            status += " · Turbo"
        if game.recording:
            status += " · Enregistrement du tour"
        self.game_status = status
        if player is None:
            self.score_label.set_text(f"{score} · {status}")
        else:
            name = GLib.markup_escape_text(player.name)
            detail = GLib.markup_escape_text(status)
            self.score_label.set_markup(
                f'{name} · <span foreground="{score_color(player.score)}">{score}</span> · {detail}'
            )

    def mobile_event(self, action, member):
        """Mise à jour du jeu UNIQUEMENT depuis la boucle GTK principale."""
        if self.closed or self.receiver is None:
            return GLib.SOURCE_REMOVE
        if action in ('join', 'reconnect'):
            self.receiver.resume_tv_display()
            if action == 'reconnect':
                # A heartbeat can reopen the TV without changing the party plan.
                return GLib.SOURCE_REMOVE
        token = member.get('token')
        player = self.mobile_players.get(token)
        if action == 'join':
            if player is None:
                player = Singer(member['name'], mobile_id=token)
                defaults = self.remote_party.defaults
                player.music_volume = defaults["music"]
                player.original_voice = defaults["original"]
                if defaults["voice"] is not None:
                    self.room_audio.default_player_volume(token, defaults["voice"])
                self.mobile_players[token] = player
                self.party.players.append(player)
                self.party_ready = False
        elif action == 'choose':
            if player is not None and player is not self.party.active:
                song = self.receiver.room.song_for(member.get('song'))
                if song is not None:
                    player.song = song
                    player.score = None
                    player.done = False
                    player.result = None
                    self.party_ready = False
        elif action == 'clear':
            if player is not None and player is not self.party.active:
                player.song = None
                player.score = None
                player.done = False
                player.result = None
                self.party_ready = False
        elif action == 'leave':
            self.remote_party.eligible.discard(token)
            if player is self.party.active:
                self.mobile_leaving.add(token)
            elif player is not None:
                self.room_audio.forget_player(token)
                self.party.players = [p for p in self.party.players if p is not player]
                self.mobile_players.pop(token, None)
                self.party_ready = False
        if self.players_window is not None:
            self.players_window.refresh()
        if player is not None and action in ("choose", "clear"):
            self.remote_party.revised_selection(player)
        self.remote_party.changed_selection()
        self.next_tv_update = 0.0
        return GLib.SOURCE_REMOVE

    def remove_mobile(self, player):
        if self.party.active is player:
            if self.players_window is not None:
                self.players_window.message.set_text('Termine le tour avant de retirer le joueur.')
            return
        if self.receiver is not None:
            self.receiver.room.kick(player.mobile_id)
        else:
            self.party.players = [p for p in self.party.players if p is not player]
            self.mobile_players.pop(player.mobile_id, None)
            self.party_ready = False
            if self.players_window is not None:
                self.players_window.refresh()

    def mobile_catalogue_loaded(self, future, receiver):
        if self.closed or self.receiver is not receiver:
            return GLib.SOURCE_REMOVE
        try:
            receiver.room.update_catalogue(future.result())
        except (OSError, ValueError, sqlite3.Error) as error:
            self.tv_address.set_text(f'Bibliothèque inaccessible : {error}')
        return GLib.SOURCE_REMOVE

    def toggle_tv(self, button):
        if not button.get_active():
            if self.receiver is not None:
                self.receiver.close()
                self.receiver = None
                # Les identités liées aux téléphones sont valables pour cette
                # salle uniquement. Les joueurs créés sur PC sont préservés.
                active = self.party.active
                self.party.players = [p for p in self.party.players
                                      if p.mobile_id is None or p is active]
                self.mobile_players = ({active.mobile_id: active}
                                       if active is not None and active.mobile_id else {})
                if active is not None and active.mobile_id:
                    self.mobile_leaving.add(active.mobile_id)
                self.party_ready = False
                if self.players_window is not None:
                    self.players_window.refresh()
            self.tv_row.set_visible(False)
            return
        try:
            self.receiver = start_receiver(
                on_mobile=self.mobile_event,
                reserved_names=(p.name for p in self.party.players if p.mobile_id is None),
                diagnostics=self.blackbox, commands=self.remote_party.dispatch,
                imports=self.mobile_imports, audio=self.room_audio)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.tv_address.set_text(str(error))
            self.tv_copy.set_visible(False)
        else:
            self.tv_address.set_text(
                f"TV : {self.receiver.url} · Joueurs : {self.receiver.join_url}")
            if self.receiver.qr:
                try:
                    qr_texture = Gdk.Texture.new_from_bytes(GLib.Bytes.new(self.receiver.qr))
                    self.tv_qr_image.set_paintable(qr_texture)
                except GLib.Error:
                    self.tv_qr_image.set_paintable(None)
            else:
                self.tv_qr_image.set_paintable(None)
            self.tv_qr_link.set_text(self.receiver.join_url)
            self.next_tv_update = 0.0
            self.tv_copy.set_visible(True)
            receiver = self.receiver
            self.tag_reader.submit(catalogue, COLLECTION, LIBRARY.resolve()).add_done_callback(
                lambda future: GLib.idle_add(self.mobile_catalogue_loaded, future, receiver))
        self.tv_row.set_visible(True)

    def copy_tv_url(self, _button):
        if self.receiver is not None:
            self.get_display().get_clipboard().set(self.receiver.join_url)

    def refresh_tv_display(self, _button):
        if self.receiver is None:
            self.tv_address.set_text("Active d’abord Salle / TV pour actualiser l’écran.")
            return
        self.receiver.request_tv_reload()
        self.tv_refresh_button.set_label("Demande envoyée ✓")
        GLib.timeout_add(1800, self.reset_tv_refresh_button)

    def reset_tv_refresh_button(self):
        if not self.closed:
            self.tv_refresh_button.set_label("↻ Actualiser TV")
        return GLib.SOURCE_REMOVE

    def close_tv_display(self, _button):
        if self.receiver is None:
            self.tv_address.set_text("Active d’abord Salle / TV pour fermer l’écran.")
            return
        self.receiver.request_tv_close()
        self.tv_close_button.set_label("Fermeture demandée ✓")
        GLib.timeout_add(1800, self.reset_tv_close_button)

    def reset_tv_close_button(self):
        if not self.closed:
            self.tv_close_button.set_label("Fermer TV")
        return GLib.SOURCE_REMOVE

    def update_tv(self, position, now):
        if self.receiver is None or now < self.next_tv_update:
            return
        self.next_tv_update = now + 0.12
        self.receiver.room.set_mode(
            locked=((self.validating and not self.preparation_only) or self.party.active is not None or self.game_score.requested
                    or self.remote_party.locked),
            game_mode=self.game_toggle.get_active() or self.party_ready,
            current=(self.party.active.name if self.party.active is not None else self.title.get_label()),
            editable=self.remote_party.editable_players())
        connected = self.receiver.room.public_roster()
        self.remote_party.publish()
        if self.validating and not self.preparation_only:
            self.receiver.update({
                "title": "Chargement de la partie", "artist": "", "score": None,
                "lines": ["", "", "", ""], "progress": self.align_fraction, "notice": " ",
                "status": self.align_status, "players": self.party.board(),
                "connected": connected, "recording": self.blackbox.status()["active"],
                "party_phase": self.remote_party.phase,
            })
            return
        active = bisect_right(self.times, position) - 1
        lines = [self.lyrics[i] if 0 <= i < len(self.lyrics) else "" for i in range(active - 1, active + 3)]
        fraction = self.display_progress(position, active, utf16=True) if active >= 0 else 0.0
        if (self.track, active, self.playback_state) != self.bb_line:
            self.bb_line = self.track, active, self.playback_state
            self.tv_line_revision += 1
            self.blackbox.emit("lyrics", "tv-line", turn=self.bb_turn, position=position,
                               revision=self.tv_line_revision, line=active, lines=lines, playback=self.playback_state)
        if self.title.get_label():
            notice = "Paroles minutées indisponibles" if not self.times else " "
        else:
            notice = "En attente de Strawberry…"
        self.receiver.update({
            "title": self.title.get_label(), "artist": self.artist.get_label(),
            "score": self.game_score.score, "lines": lines, "progress": fraction, "notice": notice,
            "status": self.game_status or ("Partie prête" if self.party_ready and self.party.next_player() else ""),
            "players": self.party.board(), "connected": connected,
            "recording": self.blackbox.status()["active"],
            "party_phase": self.remote_party.phase, "turn": self.bb_turn, "turn_phase": self.turn_phase,
            "countdown": self.countdown(),
            "current_player": self.party.active.name if self.party.active else "",
            "current_song": self.party.active.song.title if self.party.active else "",
            "next_turns": [{"player": player.name, "song": song.title}
                           for player, song in list(self.remote_party.queue)[:5]],
            "preparing_count": len(self.active_plan) if self.validating else 0,
            "recent_result": self.remote_party.latest_result(),
            "line_revision": self.tv_line_revision,
            "ranking": self.remote_party.ranking() if self.remote_party.phase == "finished" else [],
        })

    def close_window(self, _window, *, wait=True):
        if self.closed:
            return False
        if self.party.active is not None:
            self.finish_turn(pause=True)
        self.vocal_effect.disable()
        self.game_toggle.set_active(False)
        self.tv_toggle.set_active(False)
        # Managed workers own their leases and write their own result. Closing
        # the window stops scheduling and leaves any admitted import recoverable.
        if self.maintenance:
            self.maintenance.close()
        self.album_import.closing = True
        self.album_import.cancel_search()
        self.music_sync.close()
        self.stop_blackbox("window-close", wait=wait)
        self.closed = True
        if self.align_job is not None:
            self.align_job.send_signal(signal.SIGTERM)
        if self.stem_job is not None:
            self.stem_job[1].send_signal(signal.SIGTERM)
        for timer in self.timers:
            GLib.source_remove(timer)
        self.bus.signal_unsubscribe(self.seek_signal)
        self.tag_reader.shutdown(wait=False, cancel_futures=True)
        return False

    def clear_player(self):
        self.title.set_label("")
        self.artist.set_label("")
        self.playback_state = 'Stopped'
        self.media_play.set_label('▶ Lecture')
        self.media_clock.set_text('0:00 / 0:00')
        self.rate = 0.0
        self.set_track(None)
        self.sync_game()
        self.show_empty("Lance un morceau local dans Strawberry.")

    def set_track(self, track):
        if track == self.track:
            return
        self.track = track
        self.active_reference = None
        self.vocal_effect.set_song(track)
        self.update_vocal_effect()
        self.file_token = None
        self.tag_token = None
        self.tag_text = ""
        self.fetch_message = ""
        self.set_lines([])

    def request_player(self):
        if not self.polling:
            self.polling = True
            self.poll_started = time.monotonic()
            self.bus.call(PLAYER, OBJECT, "org.freedesktop.DBus.Properties", "GetAll",
                          GLib.Variant("(s)", (INTERFACE,)), GLib.VariantType.new("(a{sv})"),
                          Gio.DBusCallFlags.NO_AUTO_START, 700, None, self.player_reply)
        return GLib.SOURCE_CONTINUE

    def player_reply(self, bus, result):
        self.polling = False
        if self.closed:
            return
        try:
            properties, = bus.call_finish(result).unpack()
        except GLib.Error:
            if self.turn_phase == "playing":
                if self.record_turn:
                    self.game_score.record_turn()
                    self.record_turn = False
                self.turn_phase = "finishing"
                self.turn_deadline = time.monotonic() + 3.0
            self.clear_player()
            return
        now = time.monotonic()
        self.player_seen = now
        previous_track, previous_duration, previous_times = self.track, self.duration, self.times
        previous_word_times, previous_word_ends, previous_rate = self.word_times, self.word_ends, self.rate
        previous_source = self.scoring_source()
        previous_position = self.base_position + (now - self.updated) * self.rate
        metadata = properties.get("Metadata", {})
        volume = properties.get("Volume")
        if self.turn_music_restore is None and type(volume) in (int, float) and isfinite(volume) and volume >= 0:
            self.music_volume = volume
        title = metadata.get("xesam:title", "")
        self.title.set_label(title)
        self.artist.set_label(" · ".join(metadata.get("xesam:artist", [])))
        self.base_position = properties.get("Position", 0) / 1_000_000
        self.updated = (self.poll_started + now) / 2
        self.duration = metadata.get("mpris:length", 0) / 1_000_000
        playback = properties.get("PlaybackStatus", "Stopped")
        self.playback_state = playback
        self.media_play.set_label('⏸ Pause' if playback == 'Playing' else '▶ Lecture')
        # Ne pas changer de chanson au milieu du tour d'un joueur.
        navigation = self.party.active is None
        self.media_previous.set_sensitive(navigation)
        self.media_next.set_sensitive(navigation)
        self.rate = properties.get("Rate", 1.0) if playback == "Playing" else 0.0
        if self.music_window is not None:
            self.music_window.update_current(metadata.get('mpris:trackid'), playback)
        self.set_track(local_track(metadata.get("xesam:url")))
        self.load_lines()
        if self.vocal_effect.active:
            position = self.base_position + (time.monotonic() - self.updated) * self.rate
            self.vocal_effect.sync(self.track, position, self.rate > 0)
        self.observe_turn(playback, previous_track, previous_position, previous_duration, previous_times,
                          previous_word_times, previous_word_ends, previous_rate, previous_source, now)
        self.sync_game()

    def load_lines(self):
        if self.track is None:
            self.show_empty("Lance un morceau de ~/Music dans Strawberry.", fetch=False)
            return
        path = self.track.with_suffix(".lrc")
        try:
            source_token = lrc_token(path)
            audio_token = file_token(self.track)
            try:
                cache_token = (file_token(self.references.folder(self.track) / "prepared.json"),
                               file_token(self.references.model))
            except FileNotFoundError:
                cache_token = None
        except (OSError, ValueError):
            self.show_lrc_error("Le morceau ou son fichier LRC est illisible.")
            return
        show_original = (self.original_timing.get_active() and self.party.active is None
                         and not self.game_toggle.get_active())
        token = (source_token, audio_token, cache_token, show_original, self.party.active is not None)
        if token != self.file_token:
            self.file_token = token
            self.active_reference = self.references.cached(self.track, verify=False) if cache_token else None
            if self.active_reference:
                lines = (parse_lrc(self.active_reference["source_lrc"]) if show_original else
                         [(line["source_start"], line["text"]) for line in self.active_reference["lines"]])
                self.set_lines(lines)
            elif source_token is not None:
                try:
                    lines = read_lrc(path)
                except (OSError, ValueError):
                    lines = []
                self.set_lines(lines if any(text for _, text in lines) else [])
            else:
                self.set_lines([])
        if not self.rows:
            notice = ("Recherche des paroles minutées…" if self.fetching == self.track else
                      self.fetch_message or "Les paroles minutées de ce morceau sont absentes.")
            self.show_fallback(notice, fetch=source_token is None)

    def show_lrc_error(self, message):
        self.file_token = None
        self.active_reference = None
        if self.rows:
            self.set_lines([])
        self.show_fallback(message, fetch=False)

    def load_embedded(self):
        try:
            info = self.track.stat()
        except OSError:
            return ""
        token = (self.track, info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns, info.st_size)
        if self.tag_job is not None:
            pending, future = self.tag_job
            if future.done():
                self.tag_job = None
                if pending == token:
                    self.tag_text = future.result()
                    self.tag_token = token
        if token == self.tag_token:
            return self.tag_text
        if self.tag_job is None:
            self.tag_job = token, self.tag_reader.submit(embedded_lyrics, self.track)
        return None

    def show_fallback(self, message, *, fetch=True):
        text = self.load_embedded()
        if not text:
            self.show_empty("Lecture des paroles intégrées…" if text is None else message, fetch=fetch)
            return
        if self.plain_label.get_text() != text or self.stack.get_visible_child_name() != "plain":
            self.plain_label.set_text(text)
            self.plain_scroll.get_vadjustment().set_value(0)
        status = "Paroles non synchronisées"
        if self.fetching == self.track or self.fetch_message or not fetch:
            status += f" · {message}"
        self.set_footer(status, fetch)
        self.stack.set_visible_child_name("plain")

    def set_footer(self, notice, fetch):
        self.notice.set_text(notice)
        self.notice.set_visible(bool(notice))
        self.button.set_visible(fetch)
        self.button.set_sensitive(self.fetching is None)
        self.footer.set_visible(bool(notice) or fetch)

    def show_empty(self, message, *, fetch=True):
        self.message.set_text(message)
        self.set_footer("", fetch and self.track is not None)
        self.stack.set_visible_child_name("empty")

    def fetch(self, _button):
        track = self.track
        if self.fetching is not None or track is None:
            return
        try:
            process = Gio.Subprocess.new(
                [str(BIN / "paroles-musique"), "--bibliotheque", str(LIBRARY), "--synchro", "--", str(track)],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error:
            self.fetch_message = "Impossible de lancer paroles-musique."
            self.load_lines()
            return
        self.fetch_message = ""
        self.fetching = track
        self.load_lines()
        process.communicate_utf8_async(None, None, self.fetch_complete, track)

    def fetch_complete(self, process, result, track):
        self.fetching = None
        if self.closed or track != self.track:
            return
        try:
            _, output, _ = process.communicate_utf8_finish(result)
        except GLib.Error:
            output = ""
        if not process.get_successful():
            self.fetch_message = "La recherche a échoué. Tu peux réessayer."
        elif "instrumental" in (output or "") and not self.tag_text:
            self.fetch_message = "La source indique un morceau instrumental."
        else:
            self.fetch_message = "Aucune source n’a fourni de paroles minutées vérifiables."
        self.load_lines()

    def set_lines(self, lines):
        for label in self.rows:
            self.box.remove(label)
        self.rows = []
        self.raw_lines = lines
        self.apply_timing()
        self.lyrics = [text for _, text in lines]
        if self.party.active is None:
            if self.lyrics:
                self.game_score.configure_voice(self.lyrics)
            self.game_score.reset()
        self.refresh_game()
        self.active = -1
        self.highlight = -1
        for text in self.lyrics:
            label = Gtk.Label(label=text, xalign=0.5, justify=Gtk.Justification.CENTER, wrap=True,
                              css_classes=["lyric"])
            self.box.append(label)
            self.rows.append(label)
        self.scroll.get_vadjustment().set_value(0)
        if self.rows:
            self.style_lines()
            self.set_footer("", False)
            self.stack.set_visible_child_name("lyrics")

    def style_lines(self):
        anchor = max(0, self.active)
        for index, row in enumerate(self.rows):
            classes = ["lyric"]
            if index == self.active:
                classes.append("active")
            else:
                distance = abs(index - anchor) + (1 if index < anchor else 0)
                if distance >= 2:
                    classes.append(LYRIC_FADES[min(distance - 2, len(LYRIC_FADES) - 1)])
            row.set_css_classes(classes)

    def log_playback_reference(self, original):
        session = self.blackbox.status()["session"]
        if not session or not self.blackbox.active():
            return
        context = dict(self.game_score.diagnostic_turn)
        scoring = self.scoring_source()
        backing = Path(scoring[0]) if scoring else None

        def identify():
            try:
                files = {"original": {"library_path": str(original.relative_to(LIBRARY.resolve())),
                                      "sha256": digest(original)}}
                if backing is not None:
                    files["instrumental"] = {"cache_generation": backing.parent.name, "sha256": digest(backing)}
                    guide = backing.with_name("vocals.flac")
                    files["original_voice"] = {"cache_generation": guide.parent.name, "sha256": digest(guide)}
            except (OSError, ValueError):
                self.blackbox.emit("audio", "error", **context, recording_session=session,
                                   operation="reference-identification")
            else:
                self.blackbox.emit("audio", "reference", **context, recording_session=session, files=files)

        self.tag_reader.submit(identify)

    def animate(self):
        now = time.monotonic()
        position = self.base_position + (now - self.updated) * self.rate
        if now >= self.media_updated:
            self.media_updated = now + .35
            def clock(seconds):
                whole = max(0,int(seconds))
                return f'{whole//60}:{whole%60:02d}'
            self.media_clock.set_text(f'{clock(position)} / {clock(self.duration)}')
        self.advance_turn(now)
        self.remote_party.tick(now)
        player = self.party.active
        context = self.game_score.diagnostic_turn
        if (os.environ.get("KARA_SILENT") != "1" and self.turn_phase == "playing"
                and player and self.track == player.song.path and self.rate > 0 and context):
            sink = self.room_audio.selected_sink()
            if not self.remote_party.opened_early or not player.mobile_id or self.room_audio.consented():
                self.acoustic.update(context, sink)
            else:
                self.acoustic.update()
            if now >= self.next_capture_clock and self.blackbox.active():
                self.next_capture_clock = now + 1.
                self.blackbox.emit("audio", "music-clock", **context, position=self.base_position,
                                   strawberry_monotonic_ns=round(self.updated * 1_000_000_000),
                                   playback_rate=self.rate)
        else:
            self.acoustic.update()
        if self.game_toggle.get_active() and self.turn_phase in ("", "playing"):
            self.game_score.tick(self.times, self.duration, position, self.rate, now,
                                 self.word_times, self.word_ends, source=self.scoring_source())
        self.update_tv(position, now)
        if not self.rows or not self.scroll.get_mapped():
            return GLib.SOURCE_CONTINUE
        active = bisect_right(self.times, position) - 1
        if active != self.active:
            if self.active >= 0:
                self.rows[self.active].set_text(self.lyrics[self.active])
            self.active = active
            self.highlight = -1
            self.style_lines()

        if active >= 0:
            self.progress_line(position, active)
            self.center_line(self.rows[active])
        else:
            adjustment = self.scroll.get_vadjustment()
            adjustment.set_value(adjustment.get_value() * 0.8)
        return GLib.SOURCE_CONTINUE

    def display_progress(self, position, active, *, utf16=False):
        text = self.lyrics[active]
        if not text:
            return 0.0
        marks = self.word_marks[active] if self.word_marks else None
        if not marks:
            start = self.times[active]
            end = self.times[active + 1] if active + 1 < len(self.times) else max(start + 1.0, self.duration)
            return lyric_progress(position, start, end)
        shown = max(0.0, min(len(text), highlighted_characters(marks, position - self.timing_offset)))
        if utf16:
            prefix = int(shown)
            units = len(text[:prefix].encode("utf-16-le")) / 2
            units += (shown - prefix) * (len(text[prefix:prefix + 1].encode("utf-16-le")) / 2)
            return units / (len(text.encode("utf-16-le")) / 2)
        return shown / len(text)

    def progress_line(self, position, active):
        text = self.lyrics[active]
        count = int(self.display_progress(position, active) * len(text) + 1e-8)
        if count != self.highlight:
            done = GLib.markup_escape_text(text[:count])
            pending = GLib.markup_escape_text(text[count:])
            self.rows[active].set_markup(
                f'<span background="#b4befe" foreground="#181825">{done}</span>{pending}'
            )
            self.highlight = count

    def pad_lyrics(self, adjustment):
        # La première et la dernière ligne peuvent aussi atteindre le point de lecture.
        page = round(adjustment.get_page_size())
        if page:
            top = round(page * LYRIC_FOCUS)
            if self.box.get_margin_top() != top or self.box.get_margin_bottom() != page - top:
                self.box.set_margin_top(top)
                self.box.set_margin_bottom(page - top)

    def center_line(self, row):
        adjustment = self.scroll.get_vadjustment()
        found, bounds = row.compute_bounds(self.box)
        if not found or not adjustment.get_page_size():
            return
        middle = bounds.get_y() + bounds.get_height() / 2
        desired = middle + self.box.get_margin_top() - adjustment.get_page_size() * LYRIC_FOCUS
        maximum = max(0.0, adjustment.get_upper() - adjustment.get_page_size())
        desired = min(maximum, max(0.0, desired))
        old = adjustment.get_value()
        adjustment.set_value(desired if abs(desired - old) < 1 else old + (desired - old) * 0.2)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None
        self.service_owner = False
        self.add_main_option("service", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Démarre le serveur Kara de la session sans afficher Parole", None)

    def do_command_line(self, command):
        service = command.get_options_dict().contains("service")
        if service and command.get_is_remote():
            command.printerr_literal("Parole possède déjà le serveur Kara.\n")
            return 0
        if self.window is None:
            style = Gtk.CssProvider()
            style.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), style,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.window = LyricsWindow(self)
            if service:
                window = self.window
                if not window.receiver or not window.receiver.https_listener:
                    command.printerr_literal("Écouteur HTTPS Kara indisponible. Vérifie les journaux et la configuration.\n")
                    window.close_window(window)
                    window.destroy()
                    return 1
                self.service_owner = True
                # The graphical-session service keeps the existing owner and
                # its maintenance queue alive before the first window is shown.
                window.start_maintenance(background=True)

                def hide(widget):
                    widget.set_visible(False)
                    return True

                # The same D-Bus application owns the controller in both
                # modes. Closing its optional window cannot close the room.
                window.disconnect_by_func(window.close_window)
                window.connect("close-request", hide)
                GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop_service)
            else:
                self.window.connect("close-request", self.release_window)
        if not service:
            self.window.open_parole()
        return 0

    def release_window(self, _window):
        self.window = None
        return False

    def stop_service(self):
        if self.window:
            self.window.close_window(self.window, wait=False)
            GLib.timeout_add(200, self.service_finalized)
        else:
            self.quit()
        return GLib.SOURCE_REMOVE

    def service_finalized(self):
        # Keep the owner alive until BlackBox finishes its disk verification.
        # Systemd still puts a deadline on an unresponsive storage device.
        maintenance = self.window.maintenance
        if (self.window.blackbox.status()["finalizing"]
                or maintenance and maintenance.thread and maintenance.thread.is_alive()):
            return GLib.SOURCE_CONTINUE
        self.window.destroy()
        self.quit()
        return GLib.SOURCE_REMOVE


if __name__ == "__main__":
    raise SystemExit(App().run(sys.argv))
