LYRICS_TAGS = ("lyrics", "unsyncedlyrics", "lyricseng", "lyricsxxx")
FADE_HEIGHT = 56
LYRIC_FOCUS = 0.33
LYRIC_FADES = ("fade-near", "fade-far", "fade-distant")
CSS = (BIN / "parole.css").read_bytes()


def local_track(url):
    address = urlsplit(url or "")
    if address.scheme != "file" or address.netloc not in ("", "localhost"):
        return None
    path = Path(unquote(address.path)).resolve()
    return path if path.is_relative_to(LIBRARY.resolve()) and path.is_file() else None


def lyric_progress(position, start, end):
    # Les LRC usuels ont un repère par ligne, sans temps par mot.
    duration = max(0.3, min(8.0, end - start))
    return min(1.0, max(0.0, (position - start) / duration))


def embedded_lyrics(track):
    try:
        tags, _ = probe(track)
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    return next((tags[key] for key in LYRICS_TAGS if tags.get(key)), "")


def read_lrc(path):
    with path.open("rb") as source:
        raw = source.read(MAX_LRC_BYTES + 1)
    return parse_lrc(raw.decode("utf-8-sig")) if len(raw) <= MAX_LRC_BYTES else []


def faded_scroll(scroll, *, top_share=0.18, bottom_share=0.30, height_limit=FADE_HEIGHT):
    overlay = Gtk.Overlay()
    overlay.set_child(scroll)
    top = Gtk.Box(valign=Gtk.Align.START, can_target=False, css_classes=["lyrics-fade-top"])
    bottom = Gtk.Box(valign=Gtk.Align.END, can_target=False, css_classes=["lyrics-fade-bottom"])
    overlay.add_overlay(top)
    overlay.add_overlay(bottom)

    def update_fades(adjustment):
        page = adjustment.get_page_size()
        position = adjustment.get_value()
        above = position - adjustment.get_lower() if page else 0
        below = adjustment.get_upper() - page - position if page else 0
        for fade, share, distance in ((top, top_share, above), (bottom, bottom_share, below)):
            height = max(1, round(page * share))
            if height_limit is not None:
                height = min(height, height_limit)
            if fade.get_size_request()[1] != height:
                fade.set_size_request(-1, height)
            fade.set_opacity(max(0.0, min(1.0, distance / height)))

    adjustment = scroll.get_vadjustment()
    adjustment.connect("changed", update_fades)
    adjustment.connect("value-changed", update_fades)
    update_fades(adjustment)
    return overlay


