#!/usr/bin/python3 -B
"""Récupère les pochettes de ~/Music/Artiste/Album en conservant l'existant."""
import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
from contextlib import nullcontext
from email.utils import parsedate_to_datetime
from io import BytesIO
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
from tempfile import NamedTemporaryFile
from threading import Lock
import time
from unicodedata import combining, normalize
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode, urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener
from uuid import UUID

from PIL import Image, ImageOps
from _kara_paths import catalogue_command
from _kara_import_resources import PROCESSING, defer_service, resource_slot, wait_service
from _kara_import_result import ImportIssue
from _musique_oz import (INBOX, SHARED_LIBRARY, UNKNOWN_ALBUM, UNKNOWN_ARTIST, audio_file,
                         probe, share_file, shared_mutation, title_pair)

COVER_NAMES = {"cover", "folder", "album", "albumart", "front"}
IMAGE_TYPES = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".tiff"}
MAX_IMAGE_BYTES = 12 * 1024 * 1024
ALBUM_WORKERS = 10
SOURCE_INTERVALS = {
    "musicbrainz.org": 1.1,
    "coverartarchive.org": 0.5,
    "api.deezer.com": 0.5,
    "itunes.apple.com": 3.1,
    "music.youtube.com": 0.8,
    "www.theaudiodb.com": 2.2,
}


class HttpsOnly(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urlsplit(newurl).scheme != "https":
            raise ValueError("redirection sans HTTPS")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


class Catalog:
    def __init__(self, registry=None):
        self.opener = build_opener(HttpsOnly)
        self.registry = registry
    def get(self, url, limit):
        host = urlsplit(url).hostname
        request = Request(url, headers={"User-Agent": "MusiquePochettes/1.1"})
        for delay in (2, 5, None):
            try:
                interval = SOURCE_INTERVALS.get(host, 0.15)
                if self.registry:
                    from _parole_sources import COVER_PROVIDERS, wait_provider

                    provider = COVER_PROVIDERS.get(host)
                    if provider is not None:
                        wait_provider(self.registry, provider, host, interval, max_wait=12)
                    else:
                        wait_service(host, interval, max_wait=30)
                else:
                    wait_service(host, interval, max_wait=30)
            except ImportIssue as error:
                raise OSError(str(error)) from error
            try:
                with self.opener.open(request, timeout=12) as response:
                    payload = response.read(limit + 1)
                if len(payload) > limit:
                    raise ValueError("réponse trop volumineuse")
                return payload
            except HTTPError as error:
                if error.code not in {429, 500, 502, 503, 504}:
                    raise
                retry_after = error.headers.get("Retry-After", "")
                pause = delay or 5
                try:
                    if retry_after:
                        requested = (int(retry_after) if retry_after.isdecimal()
                                     else parsedate_to_datetime(retry_after).timestamp() - time.time())
                        pause = max(pause, requested)
                except (ValueError, TypeError, OverflowError):
                    pass
                defer_service(host, pause)
                if delay is None or pause > 30:
                    raise
                continue
            except URLError as error:
                if delay is None or not isinstance(error.reason, (TimeoutError, socket.gaierror)):
                    raise
            except TimeoutError:
                if delay is None:
                    raise
            time.sleep(delay)

    def search(self, entity, artist, title):
        field = "releasegroup" if entity == "release-group" else "release"
        artists = " AND ".join(f"artist:{quoted(name)}" for name in artist_parts(artist))
        if not artists:
            return []
        query = f"{field}:{quoted(title)} AND {artists}"
        params = urlencode({"query": query, "fmt": "json", "limit": 50})
        url = f"https://musicbrainz.org/ws/2/{entity}/?{params}"
        result = json.loads(self.get(url, 1_000_000))
        return [
            entry for entry in result.get(f"{entity}s", [])
            if normalized(entry.get("title", "")) == normalized(title) and artist_matches(artist, entry)
        ]

    def find_group(self, artist, album):
        matches = {}
        for group in self.search("release-group", artist, album):
            group_id = identifier(group.get("id"))
            if group_id:
                matches[group_id] = group.get("primary-type")
        if len(matches) == 1:
            return next(iter(matches))

        albums = [group_id for group_id, kind in matches.items() if kind == "Album"]
        return albums[0] if len(albums) == 1 else None

    def edition_cover(self, artist, title, edition):
        candidates = [
            entry for entry in self.search("release", artist, title)
            if normalized(entry.get("disambiguation", "")) == normalized(edition)
            and entry.get("status") == "Official"
        ]
        # Les fichiers proviennent généralement de l’édition numérique.
        candidates.sort(key=lambda entry: not any(
            medium.get("format") == "Digital Media" for medium in entry.get("media", [])
        ))
        for entry in candidates[:5]:
            mbid = identifier(entry.get("id"))
            if mbid:
                payload = self.cover("release", mbid)
                if payload:
                    return payload
        return None

    def cover(self, entity, mbid):
        try:
            return self.get(f"https://coverartarchive.org/{entity}/{mbid}/front-500", MAX_IMAGE_BYTES)
        except HTTPError as error:
            if error.code != 404:
                raise
            return None


    def deezer_cover(self, artist, album, count):
        query = urlencode({"q": album, "limit": 30})
        data = json.loads(self.get(f"https://api.deezer.com/search/album?{query}", 1_000_000))
        candidates = (
            (entry.get("title"), (entry.get("artist") or {}).get("name"),
             entry.get("nb_tracks"), entry.get("cover_xl") or entry.get("cover_big"))
            for entry in data.get("data", [])
            if isinstance(entry, dict)
        )
        url = album_artwork(candidates, artist, album, count)
        if url and valid_artwork_url(url, "dzcdn.net"):
            return self.get(url, MAX_IMAGE_BYTES)
        return None

    def apple_cover(self, artist, album, count):
        query = urlencode({"term": album, "media": "music", "entity": "album", "country": "FR", "limit": 35})
        data = json.loads(self.get(f"https://itunes.apple.com/search?{query}", 1_000_000))
        candidates = (
            (entry.get("collectionName"), entry.get("artistName"),
             entry.get("trackCount"), entry.get("artworkUrl100"))
            for entry in data.get("results", [])
            if isinstance(entry, dict) and entry.get("collectionType") == "Album"
        )
        url = album_artwork(candidates, artist, album, count)
        if url and valid_artwork_url(url, "mzstatic.com"):
            parts = urlsplit(url)
            path = re.sub(r"/\d+x\d+[a-z]*\.[a-z]+$", "/600x600bb.jpg", parts.path, flags=re.I)
            if path != parts.path:
                return self.get(parts._replace(path=path, query="", fragment="").geturl(), MAX_IMAGE_BYTES)
        return None


    def youtube_music_cover(self, artist, album, count, urls):
        result = subprocess.run(
            catalogue_command("pochette", album, artist, str(count), *urls),
            capture_output=True, encoding="utf-8", timeout=55,
        )
        if result.returncode:
            detail = json.loads(result.stdout).get("error") if result.stdout else result.stderr.strip()
            raise OSError(detail or "catalogue YouTube Music indisponible")
        url = json.loads(result.stdout).get("data")
        if url and valid_artwork_url(url, "googleusercontent.com"):
            return self.get(url, MAX_IMAGE_BYTES)
        return None

    def audiodb_cover(self, artist, album, count, mbids):
        query = urlencode({"s": artist, "a": album})
        url = f"https://www.theaudiodb.com/api/v1/json/123/searchalbum.php?{query}"
        result = json.loads(self.get(url, 1_000_000))
        matches = set()
        for item in (result.get("album") or []):
            if normalized(item.get("strAlbum")) != normalized(album):
                continue
            if credit_key(item.get("strArtist")) != credit_key(artist):
                continue
            artwork = item.get("strAlbumThumb")
            if not isinstance(artwork, str) or not valid_artwork_url(artwork, "theaudiodb.com"):
                continue
            tracks = str(item.get("intTotalTracks") or "")
            if tracks.isdecimal() and int(tracks) > 0 and int(tracks) < count:
                continue
            mbid = identifier(item.get("strMusicBrainzID"))
            if mbids and mbid not in mbids:
                continue
            matches.add(artwork)
        return self.get(matches.pop(), MAX_IMAGE_BYTES) if len(matches) == 1 else None


def normalized(value):
    if not isinstance(value, str):
        return ""
    text = normalize("NFKD", value).casefold().replace("’", "'")
    text = "".join(char for char in text if not combining(char))
    return " ".join(re.sub(r"\.{2,}", " ", text).split())


def credit_key(value):
    return frozenset(normalized(piece) for piece in artist_parts(value or ""))


def valid_artwork_url(url, suffix):
    address = urlsplit(url)
    return address.scheme == "https" and (address.hostname or "").endswith("." + suffix)


def album_artwork(entries, artist, album, count):
    expected = credit_key(artist)
    found = set()
    for title, credit, tracks, url in entries:
        if not isinstance(url, str) or not isinstance(credit, str) or type(tracks) is not int:
            continue
        if normalized(title) == normalized(album) and credit_key(credit) == expected and tracks >= count:
            found.add((tracks == count, url))
    if not found:
        return None
    best = max(exact for exact, _ in found)
    choices = {url for exact, url in found if exact == best}
    return choices.pop() if len(choices) == 1 else None


def quoted(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def artist_parts(value):
    return tuple(part.strip() for part in re.split(r",\s+|\s+&\s+", value) if part.strip())


def artist_matches(artist, entry):
    credits = entry.get("artist-credit", [])
    for canonical in (False, True):
        names = [credit.get("artist", {}).get("name", "") if canonical else
                 credit.get("name", credit.get("artist", {}).get("name", "")) for credit in credits]
        full = "".join(name + credit.get("joinphrase", "") for name, credit in zip(names, credits))
        if normalized(artist) == normalized(full) or tuple(map(normalized, artist_parts(artist))) == tuple(map(normalized, names)):
            return True
    return False


def identifier(value):
    try:
        return str(UUID(value)) if value else None
    except (ValueError, TypeError, AttributeError):
        return None


def album_dirs(root, selected):
    if selected:
        for entry in selected:
            path = entry.expanduser()
            if not path.is_absolute():
                path = root / path
            album = path.resolve()
            if not album.is_dir() or not album.is_relative_to(root) or len(album.relative_to(root).parts) != 2:
                raise ValueError(f"dossier Artiste/Album attendu : {path}")
            yield album
        return
    for artist in sorted(root.iterdir()):
        if not artist.is_dir() or artist.is_symlink() or artist.name.startswith("."):
            continue
        if artist.name in {INBOX, "YouTube"}:
            continue
        for album in sorted(artist.iterdir()):
            if album.is_dir() and not album.is_symlink() and not album.name.startswith("."):
                yield album


def prepare_cover(payload):
    if len(payload) > MAX_IMAGE_BYTES:
        raise ValueError("image trop volumineuse")
    with Image.open(BytesIO(payload)) as source:
        if source.width * source.height > 30_000_000:
            raise ValueError("dimensions trop grandes")
        image = ImageOps.exif_transpose(source).convert("RGB")
        image.thumbnail((1000, 1000))
        with BytesIO() as prepared:
            image.save(prepared, format="JPEG", quality=90)
            return prepared.getvalue()


def save_cover(prepared, album):
    destination = album / "cover.jpg"
    with NamedTemporaryFile(dir=album, prefix=".pochette-") as draft:
        draft.write(prepared)
        draft.flush()
        share_file(draft.name, destination)
        try:
            os.link(draft.name, destination)
        except FileExistsError:
            return False
    return True


def embedded_cover(track, picture):
    return subprocess.run(
        ("ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "file,pipe", "-i", str(track),
         "-map", f"0:{picture['index']}", "-frames:v", "1", "-c:v", "copy", "-f", "image2pipe", "pipe:1"),
        capture_output=True, check=True, timeout=20).stdout


def has_cover(album):
    return any(path.stem.casefold() in COVER_NAMES and path.suffix.casefold() in IMAGE_TYPES
               and path.is_file() for path in album.iterdir())


def fetch_cover(album, catalog, shared_root=None):
    if has_cover(album):
        return "pochette déjà présente"
    version = album.stat() if shared_root is not None else None

    def processing():
        # Local media work shares the import slots. Supplier requests keep
        # their own cadence and run after the processing slot is returned.
        if shared_root is not None and os.environ.get("KARA_PAROLE_COVER") == "1":
            return resource_slot(shared_root / INBOX / ".kara-traitements", PROCESSING, timeout=12)
        return nullcontext()

    def persist(payload):
        # Decode and resize outside the shared lock. The directory identity
        # and competing cover are checked immediately before publication.
        with processing():
            prepared = prepare_cover(payload)
        with shared_mutation(shared_root):
            if version is not None:
                current = album.stat()
                if album.resolve() != album or (current.st_dev, current.st_ino) != (version.st_dev, version.st_ino):
                    raise ValueError("album déplacé pendant la recherche")
                if has_cover(album):
                    return False
            return save_cover(prepared, album)

    tracks = [path for path in sorted(album.iterdir()) if audio_file(path)]
    if not tracks:
        return None

    names, releases, groups, sources = set(), set(), set(), []
    for track in tracks:
        try:
            with processing():
                tags, pictures = probe(track)
        except ImportIssue:
            raise
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            print(f"Lecture de {track.name} impossible : {error}", file=sys.stderr)
            continue
        for picture in pictures:
            try:
                with processing():
                    payload = embedded_cover(track, picture)
                if persist(payload):
                    return "pochette intégrée extraite → cover.jpg"
                return "pochette déjà présente"
            except ImportIssue:
                raise
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                print(f"Pochette de {track.name} illisible : {error}", file=sys.stderr)
        url = tags.get("purl")
        if url and len(sources) < 30 and url not in sources:
            sources.append(url)
        artist, title = title_pair(tags)
        if artist and title:
            names.add((artist, title))
        for key, values in (("musicbrainzalbumid", releases), ("musicbrainzreleasegroupid", groups)):
            mbid = identifier(tags.get(key))
            if mbid:
                values.add(mbid)

    if catalog is None:
        return "aucune pochette intégrée (recherche web avec --en-ligne)"

    if len(names) > 1:
        return "tags d'artiste ou d'album discordants"
    artist, title = next(iter(names)) if names else (album.parent.name, album.name)
    if artist == UNKNOWN_ARTIST or title == UNKNOWN_ALBUM:
        return "artiste ou album manquant"

    def primary_cover():
        if len(releases) == 1:
            payload = catalog.cover("release", next(iter(releases)))
            if payload:
                return payload
        if len(groups) == 1:
            return catalog.cover("release-group", next(iter(groups)))
        if groups:
            return None
        edition = re.fullmatch(r"(.+)\s+\(((?:\d{4} )?remaster(?:ed)?[^()]*)\)", title, re.IGNORECASE)
        if edition:
            return catalog.edition_cover(artist, edition[1], edition[2])
        group = catalog.find_group(artist, title)
        return catalog.cover("release-group", group) if group else None

    errors = []
    for label, fetch in (
        ("Cover Art Archive", primary_cover),
        ("YouTube Music", lambda: catalog.youtube_music_cover(artist, title, len(tracks), sources)),
        ("Deezer", lambda: catalog.deezer_cover(artist, title, len(tracks))),
        ("TheAudioDB", lambda: catalog.audiodb_cover(artist, title, len(tracks), releases | groups)),
        ("Apple Music", lambda: catalog.apple_cover(artist, title, len(tracks))),
    ):
        try:
            payload = fetch()
            if payload:
                return f"pochette {label} → cover.jpg" if persist(payload) else "pochette déjà présente"
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            errors.append(f"{label} : {error}")
    if errors:
        raise OSError("aucune pochette vérifiable · " + " / ".join(errors))
    return "aucune pochette vérifiable trouvée"


def process_albums(albums, root, catalog, tracking=False, missing_only=False):
    if tracking:
        print(f"KARA_TOTAL {len(albums)}", flush=True)
    workers = min(1 if os.environ.get("KARA_IMPORT_PROCESSING") else ALBUM_WORKERS, len(albums))
    activity_lock = Lock()
    active = 0

    def activity(delta):
        nonlocal active
        if tracking:
            with activity_lock:
                active += delta
                print(f"KARA_ACTIVITE {active} {workers}", flush=True)

    def work(album):
        activity(1)
        try:
            return album, fetch_cover(album, catalog, root if missing_only or os.environ.get("KARA_IMPORT_PROCESSING") else None), False
        except (OSError, ValueError) as error:
            return album, f"erreur : {error}", True
        finally:
            activity(-1)

    added = unresolved = failures = 0
    if albums:
        with ThreadPoolExecutor(max_workers=workers) as pool:
            jobs = [pool.submit(work, album) for album in albums]
            for job in as_completed(jobs):
                album, result, failed = job.result()
                if result:
                    print(f"{album.relative_to(root)} · {result}",
                          file=sys.stderr if failed else sys.stdout, flush=True)
                elif missing_only and tracking:
                    print(f"{album.relative_to(root)} · album déplacé ou vide", flush=True)
                found = bool(result and result.endswith(" → cover.jpg"))
                added += found
                unresolved += bool(result and not found and result != "pochette déjà présente")
                failures += failed
    if missing_only:
        if tracking:
            print(f"KARA_POCHETTES {added} {unresolved}", flush=True)
        else:
            print(f"{added} pochette(s) ajoutée(s) · {unresolved} album(s) encore sans pochette.", flush=True)
    return int(bool(failures))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("albums", nargs="*", type=Path, help="albums ciblés, relatifs à la bibliothèque")
    parser.add_argument("--bibliotheque", type=Path, default=SHARED_LIBRARY)
    parser.add_argument("--en-ligne", action="store_true",
                        help="recherche les pochettes dans les catalogues en ligne")
    parser.add_argument("--manquantes", action="store_true",
                        help="traite uniquement les albums sans fichier pochette")
    parser.add_argument("--suivi-activite", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    root = args.bibliotheque.expanduser().resolve()
    if not root.is_dir():
        parser.error(f"bibliothèque absente : {root}")
    def select():
        try:
            return list(dict.fromkeys(album_dirs(root, args.albums)))
        except ValueError as error:
            parser.error(str(error))

    registry = None
    if args.en_ligne and os.environ.get("KARA_PAROLE_COVER") == "1":
        from _parole_index import Index

        os.environ["KARA_MUSIC_LIBRARY"] = str(root)
        registry = Index(root)
    catalog = Catalog(registry) if args.en_ligne else None
    if args.manquantes:
        os.environ.setdefault("KARA_SHARED_WAIT", "suivi" if args.suivi_activite else "texte")
        with shared_mutation(root):
            albums = [album for album in select() if not has_cover(album) and any(map(audio_file, album.iterdir()))]
        return process_albums(albums, root, catalog, args.suivi_activite, missing_only=True)
    if os.environ.get("KARA_IMPORT_PROCESSING") or root == SHARED_LIBRARY:
        os.environ.setdefault("KARA_IMPORT_PROCESSING", "1")
        os.environ.setdefault("KARA_SHARED_WAIT", "suivi" if args.suivi_activite else "texte")
        with shared_mutation(root):
            albums = select()
        return process_albums(albums, root, catalog, args.suivi_activite)
    with shared_mutation(root):
        albums = select()
        if not albums:
            print("Aucun album classé dans la bibliothèque.")
        return process_albums(albums, root, catalog, args.suivi_activite)


if __name__ == "__main__":
    raise SystemExit(main())
