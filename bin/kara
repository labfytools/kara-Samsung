DOWNLOAD_WORKERS = 2
# Both Parole and the CLI use this engine. A Kara-local update can fix the
# extractor independently of the system package and other yt-dlp callers.
KARA_DOWNLOADER = DATA / "kara" / "tools" / "yt-dlp"
YT_EXECUTABLE = str(KARA_DOWNLOADER) if KARA_DOWNLOADER.is_file() else "yt-dlp"
YT_COMMAND = (YT_EXECUTABLE, "--cookies-from-browser", "firefox", "--color", "never", "--socket-timeout", "15")
YOUTUBE_HOSTS = {"music.youtube.com", "www.youtube.com", "youtube.com", "youtu.be"}
PLAYLIST_ID = re.compile(r"[A-Za-z0-9_-]{1,128}")
VIDEO_ID = re.compile(r"[A-Za-z0-9_-]{11}")


YT_PROGRESS = (
    "--no-simulate", "--newline", "--progress", "--progress-delta", "0.35",
    "--print", "before_dl:KARA_ITEM %(kara_index|1)d %(title)j",
    "--progress-template",
    "download:KARA_BYTES %(info.kara_index|1)d %(progress.downloaded_bytes|0)d "
    "%(progress.total_bytes,progress.total_bytes_estimate|0)d %(progress.status|unknown)s",
    "--progress-template",
    "postprocess:KARA_CONVERT %(info.kara_index|1)d %(progress.status|unknown)s",
    "--print", "after_move:KARA_DONE %(kara_index|1)d",
)


class ImportProgress:
    def __init__(self, report=None, *, journal=None, json_output=True, url=None):
        self.report = report
        self.managed = False
        self.guard = ()
        self.output_lock = Lock()
        self.commit_result = None
        self.journal = journal
        self.json_output = json_output
        self.url = url
        self.total = 0
        self.titles = {}
        self.download_fraction = 0.0
        self.track_progress = {}
        self.selected = None
        self.finished_positions = set()
        self.download_lock = Lock()
        self.failures = []
        self.lyrics_added = 0
        self.lyrics_synced = 0
        self.cover_counts = (0, 0)
        self.measure_index = None
        self.transfers = {}

    def emit(self, message, fraction=None, *, event="progress", **fields):
        if self.report is not None:
            self.report(message, fraction)
            return
        payload = {"event": event, "message": message, "fraction": fraction, **fields}
        if self.journal and event != "progress":
            self.journal.write(payload)
        if self.commit_result is not None and event in {"success", "failure", "skip", "cancelled"}:
            terminal = {key: fields[key] for key in ("category", "detail", "interrupted") if key in fields}
            self.commit_result(event, message, terminal)
        if self.json_output:
            with self.output_lock:
                try:
                    print(json.dumps(payload, ensure_ascii=False), flush=True)
                except BrokenPipeError:
                    if not self.managed:
                        raise
                    # A managed worker can finish and commit even if GTK exits.
                    sys.stdout = open(os.devnull, "w", encoding="utf-8")
        elif event != "album":
            print(message, flush=True)
            if fields.get("detail"):
                print(fields["detail"], file=sys.stderr, flush=True)

    def log(self, stage, output, *, command=None):
        if self.journal:
            self.journal.write({"event": "output", "url": self.url, "stage": stage,
                                "command": command, "output": output})

    def issue(self, stage, category, detail, *, returncode=None, tool=None):
        diagnostic = {"stage": stage, "category": category, "detail": detail}
        if type(returncode) is int:
            diagnostic["returncode"] = returncode
        if tool:
            diagnostic["tool"] = Path(tool).name
        with self.download_lock:
            self.failures.append(diagnostic)
        return diagnostic

    def track_status(self, verb, index, finished=0.0):
        label = f"{verb} · piste {index}"
        if self.total:
            label += f"/{self.total}"
        if index in self.titles:
            label += f" — {self.titles[index]}"
        if self.selected:
            self.track_progress[index] = max(self.track_progress.get(index, 0.0), finished)
            measured = sum(self.track_progress.get(position, 0.0) for position in self.selected)
            self.download_fraction = 0.74 * measured / len(self.selected)
        elif self.total:
            measured = 0.74 * min(1.0, (index - 1 + finished) / self.total)
            self.download_fraction = max(self.download_fraction, measured)
        self.emit(label, self.download_fraction if self.selected or self.total else None)

    def yt_line(self, line):
        marker, _, payload = line.partition(" ")
        try:
            if marker == "KARA_ITEM":
                index, title = payload.split(maxsplit=1)
                index = max(1, int(index))
                title = " ".join(str(json.loads(title) or "").split())[:160]
                if title:
                    self.titles[index] = title
                self.track_status("Téléchargement", index)
            elif marker == "KARA_BYTES":
                index, downloaded, size, status = payload.split()
                index = max(1, int(index))
                transfer = self.transfers.get(index)
                if transfer is not None:
                    transfer.received(int(downloaded), monotonic())
                estimate = max(0.0, min(1.0, int(downloaded) / int(size))) if int(size) > 0 else 0.0
                if status == "finished":
                    self.track_status("Préparation de l’audio", index, 0.94)
                elif status == "downloading":
                    self.track_status("Téléchargement", index, estimate * 0.92)
            elif marker == "KARA_CONVERT":
                index, status = payload.split()
                if status != "finished":
                    self.track_status("Préparation de l’audio", int(index), 0.95)
            elif marker == "KARA_DONE":
                index = int(payload)
                self.finished_positions.add(index)
                self.track_status("Piste enregistrée", index, 1.0)
        except (ValueError, IndexError):
            return

    def finish_issue(self, issue):
        self.emit(CATEGORIES[issue.category], event="failure", category=issue.category, detail=str(issue))


def run(label, command, *, progress=None, fraction=None, download=False, announce=True,
        total=0, unit="pistes traitées", span=0.0, resource=None, disk=None):
    if announce:
        if progress is None:
            print(f"\n{label}", flush=True)
        else:
            progress.emit(label, fraction)
    env = {**os.environ, "KARA_SHARED_WAIT": "suivi" if progress else "texte"}
    if progress is None:
        return subprocess.run(command, env=env).returncode
    errors = deque(maxlen=32)
    tail = deque(maxlen=32)
    processed = 0
    active = None

    def report_activity():
        activity = f"{active[0]}/{active[1]} en cours · " if active is not None else ""
        progress.emit(f"{label} · {activity}{processed}/{total} {unit}", fraction + span * processed / total)

    def launch(extra=()):
        return subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                encoding="utf-8", errors="replace", env=env, cwd=BIN,
                                pass_fds=progress.guard + extra, start_new_session=True)

    if resource == "processing":
        directory = SHARED_LIBRARY / INBOX / ".kara-traitements"
        with resource_slot(directory, PROCESSING, lambda: progress.emit("En attente d’un traitement…")) as slot:
            return run(label, command, progress=progress, fraction=fraction, announce=False,
                       total=total, unit=unit, span=span, resource=(slot,))
    try:
        if resource and not download:
            env["KARA_IMPORT_PROCESSING"] = "1"
        process = launch(resource or ())
    except OSError as error:
        category = "dependency" if isinstance(error, FileNotFoundError) else "path"
        progress.issue(label, category, f"{command[0]} : {error}")
        return 1
    finished = Event()
    abort = []

    def watch():
        deadline = monotonic() + (360 if download else 1800)
        interval = 1 if disk else max(0., deadline - monotonic())
        while not finished.wait(interval):
            try:
                if disk is not None:
                    check_space(disk)
                if monotonic() < deadline:
                    continue
                abort.append(("network" if download else "processing", "Délai maximal du sous-processus dépassé."))
            except (ImportIssue, OSError) as error:
                abort.append((getattr(error, "category", "path"), str(error)))
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            return

    watchdog = Thread(target=watch, daemon=True)
    watchdog.start()
    with process:
        for raw in iter(lambda: process.stdout.readline(65536), ""):
            line = raw.rstrip("\r\n")
            if line == "KARA_ATTENTE_BIBLIOTHEQUE":
                progress.emit(f"En attente de la bibliothèque · {label}", fraction)
                continue
            if line == "KARA_BIBLIOTHEQUE_DISPONIBLE":
                progress.emit(label, fraction)
                continue
            if download and line.startswith(("KARA_ITEM ", "KARA_BYTES ", "KARA_CONVERT ", "KARA_DONE ")):
                with progress.download_lock:
                    progress.yt_line(line)
                continue
            if line.startswith("KARA_TOTAL "):
                count = line.removeprefix("KARA_TOTAL ").strip()
                if count.isdecimal():
                    total = int(count)
                    if total:
                        report_activity()
                continue
            if line.startswith("KARA_POCHETTES "):
                counts = line.split()[1:]
                if len(counts) == 2 and all(value.isdecimal() for value in counts):
                    progress.cover_counts = tuple(map(int, counts))
                continue
            if total and line.startswith("KARA_ACTIVITE "):
                parts = line.split()
                if len(parts) == 3 and all(part.isdecimal() for part in parts[1:]):
                    amount, capacity = map(int, parts[1:])
                    if 0 <= amount <= capacity:
                        active = amount, capacity
                        report_activity()
                continue
            progress.log(label, line, command=command[0])
            if not progress.json_output and line:
                print(line, flush=True)
            if total and " · " in line:
                processed = min(total, processed + 1)
                report_activity()
            if label == "Paroles pour Strawberry" and " · paroles intégrées · " in line:
                progress.lyrics_added += 1
            if label == "Paroles synchronisées pour le karaoké" and " · paroles synchronisées · fichier .lrc · " in line:
                progress.lyrics_synced += 1
            if line:
                tail.append(line)
            if line.startswith(("ERROR:", "WARNING:", "Erreur pour ")) or " · erreur :" in line:
                errors.append(line)
        result = process.wait()
    finished.set()
    watchdog.join()
    if result:
        detail = "\n".join(errors or tail) or f"{command[0]} a retourné le code {result}."
        category = failure_category(detail, "download" if download else "processing")
        if abort:
            category, reason = abort[0]
            detail = f"{reason}\n{detail}"
        if download and category == "network":
            defer_service("youtube", 60 if "429" in detail else 12)
        progress.issue(label, category, detail, returncode=result, tool=command[0])
    return result


def fetch_covers(cover_args, progress, *, start, span):
    cover_count = len(cover_args) - 1 if cover_args[:1] == ["--"] else 0
    activity = ["--suivi-activite"] if progress else []
    return run("Pochettes", [str(BIN / "musique-pochettes"), "--en-ligne",
                           "--bibliotheque", str(SHARED_LIBRARY), *activity, *cover_args],
               progress=progress, fraction=start, total=cover_count, unit="albums traités", span=span, resource="processing")


def enrich(cover_args, lyric_args, progress=None):
    if progress is None:
        covers = fetch_covers(cover_args, progress, start=0.82, span=0.06)
        lyrics = fetch_lyrics(lyric_args, progress, start=0.89, synced_start=0.95)
    else:
        with ThreadPoolExecutor(max_workers=2) as pool:
            covers_job = pool.submit(fetch_covers, cover_args, progress, start=0.82, span=0.06)
            lyrics = fetch_lyrics(lyric_args, progress, start=0.89, synced_start=0.95)
            covers = covers_job.result()
    return int(any((covers, lyrics)))


def fetch_lyrics(lyric_args, progress, *, start, synced_start):
    activity = ["--suivi-activite"] if progress else []
    base = [str(BIN / "paroles-musique"), "--bibliotheque", str(SHARED_LIBRARY), *activity]
    track_count = len(lyric_args) - 1 if lyric_args[:1] == ["--"] else 0
    lyrics = run("Paroles pour Strawberry", [*base, *lyric_args], progress=progress, fraction=start,
                 total=track_count, span=synced_start - start, resource="processing")
    timed = run("Paroles synchronisées pour le karaoké", [*base, "--synchro", *lyric_args],
                progress=progress, fraction=synced_start, total=track_count, span=0.99 - synced_start, resource="processing")
    return int(any((lyrics, timed)))


def find_missing_lyrics(progress=None):
    if not SHARED_LIBRARY.is_dir():
        raise ImportIssue("path", f"Bibliothèque introuvable : {SHARED_LIBRARY}")
    code = fetch_lyrics(["--tout"], progress, start=0.0, synced_start=0.5)
    if progress:
        message = (f"Recherche terminée · {progress.lyrics_added} piste(s) enrichie(s) · "
                   f"{progress.lyrics_synced} fichier(s) .lrc ajouté(s).")
        if code:
            message += " Erreur pendant la recherche."
        progress.emit(message, 1.0, event="failure" if code else "success", diagnostics=progress.failures)
    return code


def find_missing_covers(progress=None):
    if not SHARED_LIBRARY.is_dir():
        raise ImportIssue("path", f"Bibliothèque introuvable : {SHARED_LIBRARY}")
    code = fetch_covers(["--manquantes"], progress, start=0.0, span=1.0)
    if progress:
        added, unresolved = progress.cover_counts
        message = (f"Recherche terminée · {added} pochette(s) ajoutée(s) · "
                   f"{unresolved} album(s) encore sans pochette.")
        if code:
            message += " Erreur pendant la recherche."
        progress.emit(message, 1.0, event="failure" if code else "success", diagnostics=progress.failures)
    return code


def revise():
    if not SHARED_LIBRARY.is_dir():
        raise SystemExit(f"Bibliothèque partagée introuvable : {SHARED_LIBRARY}")
    print(f"Révision de {SHARED_LIBRARY}", flush=True)
    return enrich([], ["--tout"])


def require_commands(*commands):
    for command in commands:
        if which(str(command)) is None:
            raise ImportIssue("dependency", f"Commande introuvable ou non exécutable : {command}")


def bounded_metadata(command, guard, timeout):
    # Metadata is consumed one album at a time. Stop a malformed extractor
    # response before it can fill RAM or the filesystem with captured output.
    deadline = monotonic() + timeout
    with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=BIN,
                          pass_fds=guard, start_new_session=True) as process, DefaultSelector() as reader:
        output, errors = bytearray(), bytearray()
        reader.register(process.stdout, EVENT_READ, output)
        reader.register(process.stderr, EVENT_READ, errors)
        try:
            while reader.get_map():
                remaining = deadline - monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(command, timeout, stderr=bytes(errors))
                for key, _ in reader.select(remaining):
                    block = os.read(key.fd, 65536)
                    if not block:
                        reader.unregister(key.fileobj)
                        continue
                    key.data.extend(block)
                    if len(output) + len(errors) > 8 * 1024**2:
                        raise ImportIssue("processing", "Réponse de catalogue ou de playlist trop volumineuse.")
            return subprocess.CompletedProcess(command, process.wait(timeout=max(0., deadline - monotonic())),
                                               output.decode("utf-8", "replace"), errors.decode("utf-8", "replace"))
        except (ImportIssue, subprocess.TimeoutExpired):
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            raise


def youtube_metadata(command, progress, timeout):
    directory = SHARED_LIBRARY / INBOX / ".kara-catalogue"
    with resource_slot(directory, CATALOGUE) as slot:
        if command[0] == YT_EXECUTABLE:
            wait_service("youtube", 0.5)
        try:
            result = bounded_metadata(command, progress.guard + (slot,), timeout)
        except subprocess.TimeoutExpired:
            defer_service("youtube", 12)
            raise
        detail = result.stderr + (result.stdout if result.returncode else "")
        if failure_category(detail, "processing") == "network":
            defer_service("youtube", 60 if "429" in detail else 12)
        return result


def album_preflight(url, root, progress):
    parsed = urlsplit(url)
    playlist = parse_qs(parsed.query).get("list", [""])[0]
    if not parsed.path.startswith("/browse/MPRE") and not playlist.startswith("OLAK5uy_"):
        return None
    try:
        command = catalogue_command("preparer", url, str(root))
        require_commands(command[0])
        if not Path(command[2]).is_file():
            raise ImportIssue("dependency", f"Catalogue introuvable : {command[2]}", stage="catalogue")
        result = youtube_metadata(command, progress, 70)
    except subprocess.TimeoutExpired as error:
        raise ImportIssue("network", f"Délai dépassé pendant la recherche de cet album : {url}", stage="catalogue") from error
    if result.stderr:
        progress.log("Catalogue YouTube Music", result.stderr)
    try:
        report = json.loads(result.stdout)
        if not isinstance(report, dict):
            raise ValueError("Réponse du catalogue invalide.")
    except ValueError as error:
        detail = result.stderr or result.stdout or str(error)
        raise ImportIssue(failure_category(detail, "processing"), detail, stage="catalogue",
                          returncode=result.returncode, tool="ytmusicapi") from error
    if result.returncode or "data" not in report:
        category = report.get("category")
        detail = report.get("error") or result.stderr or f"Réponse du catalogue invalide : {url}"
        raise ImportIssue(category if category in CATEGORIES else "processing", detail, stage="catalogue",
                          returncode=result.returncode, tool="ytmusicapi")
    album = report["data"]
    if album is not None and (not isinstance(album, dict) or not isinstance(album.get("title"), str)
                              or not isinstance(album.get("url"), str) or not isinstance(album.get("tracks"), list)
                              or any(not isinstance(track, dict) or not isinstance(track.get("id"), str)
                                     or not isinstance(track.get("title"), str) for track in album["tracks"])):
        progress.log("Catalogue YouTube Music", result.stdout)
        raise ImportIssue("processing", "Données d’album invalides dans la réponse du catalogue.", stage="catalogue")
    return album


@dataclass(frozen=True)
class SourceTrack:
    url: str
    position: int
    album: str = ""


def playlist_entries(playlist, progress, snapshot):
    # Resolve a playlist once. Each transfer later uses the exact watch ID from
    # this snapshot, even if YouTube responds differently to a second tab request.
    if snapshot.is_file():
        return {int(index): entry for index, entry in json.loads(snapshot.read_text(encoding="utf-8")).items()}
    url = f"https://www.youtube.com/playlist?list={playlist}"
    try:
        result = youtube_metadata(
            [*YT_COMMAND, "--yes-playlist", "--flat-playlist", "--skip-download",
             "--print", "%(.{playlist_index,id,title,playlist_title,playlist_count})j", "--", url],
            progress, 45)
    except subprocess.TimeoutExpired as error:
        stderr = (error.stderr or b"").decode("utf-8", errors="replace")
        if stderr:
            progress.log("Résolution de la playlist", stderr)
        raise ImportIssue("network", f"Délai dépassé : {url}\n{stderr}".strip(), stage="playlist") from error
    if result.stderr:
        progress.log("Résolution de la playlist", result.stderr)
    if result.returncode:
        detail = result.stderr or result.stdout or f"yt-dlp a retourné le code {result.returncode}."
        raise ImportIssue(failure_category(detail, "playlist"), f"{url}\n{detail.rstrip()}", stage="playlist",
                          returncode=result.returncode, tool="yt-dlp")
    entries = {}
    try:
        for line in result.stdout.splitlines():
            entry = json.loads(line)
            index = entry["playlist_index"]
            if type(index) is not int or index < 1 or index in entries:
                raise ValueError("position de piste invalide ou dupliquée")
            if any(entry.get(key) is not None and not isinstance(entry[key], str)
                   for key in ("id", "title", "playlist_title")):
                raise ValueError("métadonnées de piste invalides")
            entries[index] = entry
    except (KeyError, TypeError, ValueError) as error:
        progress.log("Résolution de la playlist", result.stdout)
        raise ImportIssue("processing", f"Réponse de playlist invalide : {url}\n{error}", stage="playlist") from error
    if not entries:
        raise ImportIssue("playlist", f"La playlist ne renvoie aucune piste : {url}\n{result.stderr}".strip(), stage="playlist")
    expected = playlist_length(entries)
    if (len(entries) == expected and all(isinstance(entry.get("id"), str) and VIDEO_ID.fullmatch(entry["id"])
                                         for entry in entries.values())):
        # Preserve a complete selection on restart. An incomplete response is
        # retried with the provider so a temporarily missing entry can return.
        write_checkpoint(snapshot, entries)
    return entries


def title_key(value):
    folded = " ".join(normalize("NFKC", value or "").casefold().replace("’", "'").split())
    # YouTube Music can add featured credits to catalogue titles only.
    return re.sub(r"\s*[\[(](?:avec|feat\.?|ft\.?|featuring|with)\s+[^)\]]+[\])]$", "", folded)


def available_tracks(paths, root):
    valid = []
    for value in paths:
        if not isinstance(value, str):
            continue
        path = Path(value)
        if (path.is_absolute() and path.is_relative_to(root) and len(path.relative_to(root).parts) >= 3
                and path.relative_to(root).parts[0] not in {INBOX, "YouTube"}
                and path.resolve() == path and audio_file(path)):
            valid.append(str(path))
    return sorted(set(valid))


def known_video_ids(paths):
    videos = set()
    for path in paths:
        try:
            tags, _ = probe(path)
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
        if video := source_video(tags.get("purl")):
            videos.add(video)
    return videos


def playlist_length(entries):
    advertised = (entry.get("playlist_count") for entry in entries.values())
    return max(max(entries), max((count for count in advertised if type(count) is int), default=0))


def missing_sources(item, playlist, album, recovered, snapshot):
    entries = playlist_entries(playlist, item.progress, snapshot)
    expected = playlist_length(entries)
    if len(entries) < expected:
        item.progress.issue("Résolution de la playlist", "playlist",
                            f"YouTube a renvoyé {len(entries)} piste(s) pour {expected} positions annoncées.")
    catalogue = (album or {}).get("tracks", [])
    aligned = sorted(entries) == list(range(1, len(catalogue) + 1)) and all(
        track["id"] == entries[index].get("id")
        or title_key(track["title"]) == title_key(entries[index].get("title"))
        for index, track in enumerate(catalogue, 1)
    )
    published = known_video_ids(item.tracks)
    if not aligned:
        published.update(track["id"] for track in catalogue if track.get("path"))
    videos = [entry.get("id") for entry in entries.values()]
    repeated = {video for video, count in Counter(videos).items() if count > 1}
    for index, entry in sorted(entries.items()):
        video = entry.get("id")
        if ((index, video) in recovered or (aligned and catalogue[index - 1].get("path"))
                or (video in published and video not in repeated)):
            continue
        if not isinstance(video, str) or not VIDEO_ID.fullmatch(video):
            item.progress.issue("Résolution de la playlist", "playlist",
                                f"Piste {index} sans identifiant vidéo utilisable : {entry.get('title') or playlist}")
            continue
        playlist_title = entry.get("playlist_title")
        fallback = re.sub(r"^Album\s*-\s*", "", playlist_title) if isinstance(playlist_title, str) else ""
        album_title = (album or {}).get("title") or fallback
        if not album and album_title:
            item.title = album_title
        item.sources.append(SourceTrack(f"https://www.youtube.com/watch?v={video}", index, album_title))
    return expected


def checked_link(url):
    try:
        parsed = urlsplit(url)
        if (parsed.scheme == "https" and parsed.hostname in YOUTUBE_HOSTS
                and parsed.username is None and parsed.port in {None, 443}):
            query = parse_qs(parsed.query, keep_blank_values=True)
            if "list" not in query or (len(query["list"]) == 1 and PLAYLIST_ID.fullmatch(query["list"][0])):
                return parsed, query.get("list", [""])[0]
    except ValueError:
        pass
    raise ImportIssue("path", f"Lien HTTPS YouTube Music ou YouTube invalide : {url}")


def literal_metadata(value, field):
    # Keep catalogue text literal in yt-dlp's FROM:TO template. Delimiters
    # force single-word titles to be interpreted as text, rather than a field.
    value = " ".join(value.split()).replace("%", "%%").replace(":", r"\:")
    return f"={value}!:=%({field})s!"


def download_track(source, folder, progress):
    position = source.position
    label = f"Téléchargement · piste {position}"
    metadata = ["--parse-metadata", f"{position}:%(kara_index)s",
                "--parse-metadata", "%(track_number,kara_index)s:%(meta_track)s"]
    if source.album:
        metadata += ["--parse-metadata", literal_metadata(source.album, "kara_album"),
                     "--parse-metadata", "%(album,kara_album)s:%(meta_album)s"]
    # yt-dlp moves a file to the visible batch only after post-processing. The
    # sorter ignores its private work directory and never publishes its drafts.
    command = [
        *YT_COMMAND, "--no-playlist", "--continue", "--abort-on-error", "--retries", "2", "--extractor-retries", "1",
        "--retry-sleep", "http:exp=2:15", "--retry-sleep", "extractor:exp=2:15",
        "--limit-rate", "512K", "--concurrent-fragments", "1",
        "--max-filesize", str(MAX_MEDIA), "--postprocessor-args", "ffmpeg:-threads 1",
        "-f", "bestaudio", "-x", "--audio-format", "best", "--embed-metadata", *metadata,
        "-P", str(folder), "-P", f"temp:{folder / '.download'}",
        "-o", f"{position:02d} - %(title).150B [%(id)s].%(ext)s",
        *YT_PROGRESS, "--", source.url,
    ]
    directory = folder.parent / ".kara-transferts"
    with resource_slot(directory, DOWNLOADS, lambda: progress.emit("En attente d’un téléchargement…")) as slot:
        check_space(folder, extra=WORKING_RESERVE)
        wait_service("youtube", 0.5)
        with progress.download_lock:
            transfer = progress.transfers[position] = Transfer(monotonic())
        result = run(label, command, progress=progress, download=True, announce=False, resource=(slot,), disk=folder)
        if not result and progress.measure_index is not None:
            observe(progress.measure_index, YOUTUBE, transfer.measurements())
        return result


def sort_audio(batch, progress, album_artist, receipt, *, preserve_tags=False):
    if not any(audio_files(batch)):
        return 0, []
    with TemporaryDirectory(prefix="kara-rapport-") as temporary:
        report = Path(temporary) / "pistes.json"
        credit = ["--artiste-album", album_artist] if album_artist else []
        code = run("Tri dans l’audiothèque",
                   [str(BIN / "musique-tri"), "--bibliotheque", str(SHARED_LIBRARY),
                    "--rapport", str(report), "--rapport-detaille", "--reprise-interne", str(receipt),
                    *credit, *(["--garder-tags-import"] if preserve_tags else ()), "--", str(batch)],
                   progress=progress, fraction=0.76, resource="processing")
        if not report.is_file():
            if not code:
                progress.issue("Tri dans l’audiothèque", "processing", "Rapport du tri absent.")
            return 0, []
        data = json.loads(report.read_text(encoding="utf-8"))
        tracks = available_tracks(data["tracks"], SHARED_LIBRARY)
        if len(tracks) != len(data["tracks"]):
            progress.issue("Tri dans l’audiothèque", "path", "Une destination publiée est inaccessible.")
    return data["added"], tracks


def enrich_tracks(tracks, progress):
    albums = sorted({str(Path(track).parent) for track in tracks})
    return enrich(["--", *albums], ["--", *tracks], progress)


def close_batch(batch):
    work = batch / ".download"
    if work.is_dir() and not any(work.iterdir()):
        work.rmdir()
    if any(batch.iterdir()):
        return batch
    batch.rmdir()
    return None


@dataclass
class BatchAlbum:
    url: str
    title: str
    progress: ImportProgress
    identity: str = ""
    sources: list[SourceTrack] = field(default_factory=list)
    tracks: list[str] = field(default_factory=list)
    artist: str | None = None
    folder: Path | None = None
    fraction: float = 0.0
    added: int = 0
    audio_complete: bool = False
    status: str = ""
    processed: int = 0
    remaining: Path | None = None
    provenance: list[dict] = field(default_factory=list)
    provider: str = ""


def record_error(progress, stage, error, default="processing"):
    if isinstance(error, ImportIssue):
        progress.issue(error.stage or stage, error.category, str(error), returncode=error.returncode, tool=error.tool)
        return
    if isinstance(error, OSError):
        category = failure_category(str(error), "path")
    else:
        category = default
    progress.issue(stage, category, str(error))


def album_diagnostics(item):
    return sorted(item.progress.failures, key=lambda entry: (entry["stage"], entry["detail"]))


STAGED_TRACK = re.compile(r"^(\d+) - .* \[([A-Za-z0-9_-]{11})\]\.[^.]+$")


def staged_key(name):
    match = STAGED_TRACK.fullmatch(name)
    return (int(match[1]), match[2]) if match else None


def published_tracks(receipt, root):
    found = {}
    if not receipt.is_file():
        return found
    with receipt.open(encoding="utf-8") as journal:
        for line in journal:
            try:
                filename, target, video, disc, track = json.loads(line)
                key = staged_key(filename)
                if not key or key[1] != video or not available_tracks([target], root):
                    continue
                tags, _ = probe(target)
                if source_video(tags.get("purl")) != video:
                    continue
                actual_disc = (tags.get("disc") or tags.get("discnumber") or "1").split("/")[0]
                actual_track = (tags.get("track") or tags.get("tracknumber") or "0").split("/")[0]
                if int(actual_disc) == disc and int(actual_track) == track:
                    found[key] = target
            except (OSError, TypeError, ValueError, subprocess.SubprocessError):
                continue
    return found


def write_checkpoint(path, payload):
    # Persist the selection or published audio paths under the album lease
    # before moving to the next stage. An interrupted write leaves the old file.
    with NamedTemporaryFile(dir=path.parent, mode="w", encoding="utf-8", delete=False) as draft:
        draft_path = Path(draft.name)
        try:
            json.dump(payload, draft)
            draft.flush()
            os.fsync(draft.fileno())
            os.replace(draft_path, path)
            fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        finally:
            draft_path.unlink(missing_ok=True)


def checkpoint_tracks(path, root):
    if not path.is_file():
        return [], None
    data = json.loads(path.read_text(encoding="utf-8"))
    tracks = available_tracks(data["tracks"], root)
    return (tracks if len(tracks) == len(data["tracks"]) else []), data.get("title")


def local_receipts(receipt):
    published = {}
    if receipt.is_file():
        with receipt.open(encoding="utf-8") as source:
            for line in source:
                try:
                    filename, destination, _, _, _ = json.loads(line)
                    published.setdefault(filename, []).append(destination)
                except (TypeError, ValueError):
                    continue
    return published


def file_sha(path):
    with Path(path).open("rb") as source:
        return file_digest(source, "sha256").hexdigest()


def local_destination(record, candidates, root):
    # The sorter journals the intended target before publishing with an
    # exclusive link. An occupied name or a torn publication proves nothing.
    # Check exact file bytes on first recovery and exact PCM after enrichment.
    for value in reversed(candidates):
        if not available_tracks([value], root):
            continue
        target = Path(value)
        try:
            revision = stamp(target.stat())
            known = value == record.get("path")
            if known and revision == record.get("published_revision"):
                return target
            matches = file_sha(target) == record["sha256"]
            if known and not matches:
                with resource_slot(root / INBOX / ".kara-traitements", PROCESSING):
                    matches = pcm_digest(target) == record["pcm"]
            if matches:
                record.update(path=value, published_revision=revision)
                return target
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
    return None


def local_sidecars(tracks, entries, root, progress):
    albums = {}
    for name, track in tracks.items():
        albums.setdefault(Path(name).parent, set()).add(track.parent)
    with shared_mutation(root, wait=True):
        for name, track in tracks.items():
            if not available_tracks([str(track)], root):
                continue
            source = Path(name)
            assets = [(str(source.with_suffix(".lrc")), track.with_suffix(".lrc"))]
            if albums[source.parent] == {track.parent}:
                assets.append((str(source.parent / "cover.jpg"), track.parent / "cover.jpg"))
            for member, destination in assets:
                if member in entries:
                    try:
                        publish_sidecar(entries[member], destination)
                    except (OSError, ValueError, BadZipFile, RuntimeError) as error:
                        record_error(progress, f"Fichier local associé · {member}",
                                     ImportIssue("path", str(error)))


def import_local(item, root, inbox, previous, stop, seen, selection):
    path, item.provider, reference, license_url = selection
    resolved = path.resolve()
    if resolved.is_relative_to(root) or root.is_relative_to(resolved):
        raise ImportIssue("path", "Sélectionne un dossier ou un ZIP en dehors de la bibliothèque.")
    item.identity = "local:" + digest(path.as_uri())
    item.title = path.stem if path.suffix.lower() in (AUDIO | {".zip"}) else path.name
    if item.provider != LOCAL:
        import_provider_index(root, item.provider)
    verification = "manual" if reference else "file"
    import_entries(item, root, inbox, previous, stop, seen, local_entries(path),
                   reference or path.as_uri(), reference, license_url, verification)


def import_provider_index(root, provider):
    from _parole_index import Index
    from _parole_sources import seed

    provider_index = Index(root)
    seed(provider_index)
    if not provider_index.source_enabled(provider):
        raise ImportIssue("path", "Ce fournisseur est désactivé dans Parole.")
    return provider_index


def import_internet_archive(item, root, inbox, previous, stop, seen, identity):
    item.provider = ARCHIVE
    item.identity = "archive:" + identity
    item.tracks = available_tracks(previous.get("tracks", []), root)
    index = import_provider_index(root, item.provider)
    if item.identity in seen:
        item.status = "duplicate"
        return
    with resource_slot(inbox / ".kara-catalogue", CATALOGUE):
        album = archive.item(index, identity)
    item.title, item.artist = album.title, album.artist
    source = archive.release_url(identity)
    import_entries(item, root, inbox, previous, stop, seen, archive.entries(index, inbox, album),
                   source, source, album.license, "catalogue")


def import_jamendo(item, root, inbox, previous, stop, seen, selection):
    kind, identity = selection
    item.provider = JAMENDO
    item.identity = f"jamendo:{kind}:{identity}"
    item.tracks = available_tracks(previous.get("tracks", []), root)
    index = import_provider_index(root, item.provider)
    if item.identity in seen:
        item.status = "duplicate"
        return
    with resource_slot(inbox / ".kara-catalogue", CATALOGUE):
        release = jamendo.item(index, kind, identity)
    item.title, item.artist = release.title, release.artist
    source = jamendo.release_url(kind, identity)
    import_entries(item, root, inbox, previous, stop, seen, jamendo.entries(index, inbox, release),
                   source, source, "", "catalogue")


def import_entries(item, root, inbox, previous, stop, seen, reader, source, reference, license_url, verification):
    progress = item.progress
    item.tracks = available_tracks(previous.get("tracks", []), root)
    if item.identity in seen:
        item.status = "duplicate"
        return
    progress.log("Fournisseur", item.provider)
    workspace = inbox / ".kara-reprises" / digest(item.identity)
    receipt = workspace / "publications.jsonl"
    manifest = workspace / "originaux.json"
    folder = inbox / f".kara-local-{digest(item.identity)}"
    with lease(workspace / "verrou") as guard:
        progress.guard += (guard,)
        try:
            with reader as entries:
                audio = sorted(entry for entry in entries if Path(entry).suffix.lower() in AUDIO)
                if not audio:
                    raise ImportIssue("path", "Aucun fichier audio pris en charge dans la sélection.")
                records = json.loads(manifest.read_text(encoding="utf-8")) if manifest.is_file() else {}
                published = local_receipts(receipt)
                targets = {}
                active = {}
                for number, name in enumerate(audio, 1):
                    if stop.is_set():
                        break
                    entry = entries[name]
                    # Each revision has a different staging name. The source
                    # only becomes eligible once a full read and PCM check end.
                    stage = digest(json.dumps([name, entry.revision])) + Path(name).suffix.lower()
                    record = records.get(name, {})
                    if record.get("stage") == stage:
                        target = local_destination(record, published.get(stage, []), root)
                        if target:
                            targets[name] = target
                            continue
                    action = "Téléchargement" if entry.external_id else "Copie locale"
                    progress.emit(f"{item.provider} · {action} · piste {number}/{len(audio)}",
                                  0.72 * (number - 1) / len(audio))
                    draft = None
                    try:
                        if folder.is_symlink():
                            raise ImportIssue("path", "Dossier de réception symbolique.")
                        folder.mkdir(mode=0o770, exist_ok=True)
                        item.folder = folder
                        draft = folder / stage
                        if draft.is_symlink():
                            raise ImportIssue("path", "Fichier de réception symbolique.")
                        checksum = file_sha(draft) if draft.is_file() else read_entry(entry, draft, stop)
                        if not checksum:
                            break
                        with resource_slot(inbox / ".kara-traitements", PROCESSING):
                            tags, _ = probe(draft, include_codec=bool(entry.format))
                            if not (tags.get("title") and (tags.get("album") or len(audio) == 1)
                                    and (tags.get("albumartist") or tags.get("artist"))):
                                raise ImportIssue("path", "Métadonnées titre, album ou artiste manquantes.")
                            if entry.format and tags["codec"] != entry.format:
                                raise ImportIssue("processing", "Le fichier reçu ne correspond pas au format demandé.")
                            records[name] = {"stage": stage, "sha256": checksum, "pcm": pcm_digest(draft)}
                        active[stage] = name
                        item.processed += 1
                    except (OSError, ValueError, BadZipFile, RuntimeError, subprocess.SubprocessError) as error:
                        if draft is not None and not draft.is_symlink():
                            draft.unlink(missing_ok=True)
                        record_error(progress, f"{action} · piste {number} · {name}",
                                     error if isinstance(error, ImportIssue) else ImportIssue("path", str(error)))
                        if progress.failures[-1]["category"] == "space":
                            break
                if active:
                    # Store source proof before sorting so a restart after an
                    # audio publication can recover its exact destination.
                    write_checkpoint(manifest, records)
                    # The shared sorter sees only the current selection.
                    # Old staging from a different revision stays out of it.
                    for candidate in audio_files(folder):
                        if candidate.parent == folder and candidate.name not in active:
                            candidate.unlink()
                    check_space(folder, extra=MAX_MEDIA * PROCESSING)
                    item.added, _ = sort_audio(folder, progress, None, receipt, preserve_tags=True)
                    published = local_receipts(receipt)
                    for stage, name in active.items():
                        record = records[name]
                        target = local_destination(record, published.get(stage, []), root)
                        if target:
                            targets[name] = target
                        else:
                            progress.issue("Tri local", "processing", f"Publication non vérifiée : {name}")
                if targets:
                    write_checkpoint(manifest, records)
                    item.tracks = sorted(set(item.tracks).union(map(str, targets.values())))
                    item.provenance = [
                        {"provider": item.provider, "external_id": entries[name].external_id or records[name]["sha256"],
                         "sha256": records[name]["sha256"], "member": name, "source": source, "path": str(track),
                         "edition_ref": reference, "verification": verification,
                         **({"license": entries[name].license or license_url}
                            if entries[name].license or license_url else {})}
                        for name, track in sorted(targets.items())
                    ]
                    local_sidecars(targets, entries, root, progress)
                    enrich_tracks(item.tracks, progress)
                item.audio_complete = len(targets) == len(audio)
                if item.audio_complete and not progress.failures:
                    seen.add(item.identity)
        except BadZipFile as error:
            raise ImportIssue("path", str(error), stage="Archive ZIP") from error
        finally:
            if item.folder is not None:
                item.remaining = close_batch(item.folder)
            progress.guard = progress.guard[:-1]


def import_album(item, root, inbox, previous, stop, seen):
    progress = item.progress
    parsed, playlist = checked_link(item.url)
    item.provider = YOUTUBE
    known = previous.get("tracks", [])
    item.tracks = available_tracks(known, root)
    item.title = previous.get("title") or item.title
    item.identity = previous.get("identity", "")
    if previous.get("audio_complete") and item.tracks and len(item.tracks) == len(known):
        item.audio_complete = True
        enrich_tracks(item.tracks, progress)
        return
    require_commands(YT_EXECUTABLE)
    check_space(inbox, extra=WORKING_RESERVE)
    # A browse ID resolves to the exact playlist before taking the album
    # lease. Other URL forms of that playlist share one staging directory.
    album = None
    if not playlist and parsed.path.startswith("/browse/"):
        album = album_preflight(item.url, root, progress)
        _, playlist = checked_link(album["url"])
    if playlist:
        item.identity = f"playlist:{playlist}"
    else:
        video = source_video(item.url)
        if not video and parsed.path.startswith(("/shorts/", "/live/")):
            video = parsed.path.split("/")[2]
        if not VIDEO_ID.fullmatch(video):
            raise ImportIssue("path", f"Lien sans playlist ou vidéo YouTube utilisable : {item.url}")
        item.identity = f"video:{video}"
    if item.identity in seen:
        item.status = "duplicate"
        return
    identity = digest(item.identity)
    workspace = inbox / ".kara-reprises" / identity
    with lease(workspace / "verrou") as guard:
        if stop.is_set():
            return
        progress.guard += (guard,)
        try:
            receipt = workspace / "publications.jsonl"
            checkpoint = workspace / "audio.json"
            checked, title = checkpoint_tracks(checkpoint, root)
            if checked:
                item.tracks, item.title, item.audio_complete = checked, title or item.title, True
                # Each enrichment command checks the existing files and tags.
                enrich_tracks(item.tracks, progress)
                if not progress.failures:
                    seen.add(item.identity)
                return
            recoverable = published_tracks(receipt, root)
            if recoverable:
                item.tracks = sorted(set(item.tracks).union(recoverable.values()))
            if album is None and playlist.startswith("OLAK5uy_"):
                album = album_preflight(item.url, root, progress)
            if album:
                item.title = album["title"] or item.title
                item.artist = album.get("artist")
                item.tracks = sorted(set(item.tracks).union(
                    available_tracks([track.get("path") for track in album["tracks"]], root)))
                if album["present"] and not recoverable and not previous:
                    item.audio_complete = True
                    seen.add(item.identity)
                    return
            if playlist:
                progress.total = missing_sources(item, playlist, album, recoverable, workspace / "playlist.json")
            elif video not in known_video_ids(item.tracks):
                progress.total = 1
                item.sources.append(SourceTrack(f"https://www.youtube.com/watch?v={video}", 1))
            folder = inbox / f".kara-reprise-{identity}"
            if item.sources or folder.is_dir():
                if folder.is_symlink():
                    raise ImportIssue("path", "Dossier de réception symbolique.")
                folder.mkdir(mode=0o770, exist_ok=True)
                item.folder = folder
                staged = {staged_key(track.name) for track in audio_files(folder)}
                tasks = [source for source in item.sources if (source.position, source_video(source.url)) not in staged]
                progress.selected = tuple(source.position for source in tasks)

                def transfer(source):
                    try:
                        code = download_track(source, folder, progress)
                        if not code and source.position not in progress.finished_positions:
                            raise ImportIssue("download", "Le téléchargeur n’a publié aucun fichier pour cette piste.")
                    except (OSError, ValueError, subprocess.SubprocessError) as error:
                        record_error(progress, f"Téléchargement · piste {source.position}", error, "download")
                    finally:
                        with progress.download_lock:
                            item.processed += 1
                            progress.track_status("Piste traitée", source.position, 1.0)

                if tasks:
                    with ThreadPoolExecutor(max_workers=min(DOWNLOAD_WORKERS, len(tasks))) as pool:
                        # Only this album supplies work. A discography never
                        # allocates a future for every track of every release.
                        list(pool.map(transfer, tasks))
                if any(audio_files(folder)):
                    check_space(folder, extra=MAX_MEDIA * PROCESSING)
                    item.added, sorted_tracks = sort_audio(folder, progress, item.artist, receipt)
                    item.tracks = sorted(set(item.tracks).union(sorted_tracks))
                if not item.tracks and not progress.failures:
                    raise ImportIssue("download", "Aucune piste complète n’a été reçue.")
            item.audio_complete = bool(item.tracks) and not progress.failures
            if item.audio_complete:
                write_checkpoint(checkpoint, {"tracks": item.tracks, "title": item.title})
            if item.tracks:
                enrich_tracks(item.tracks, progress)
            if item.audio_complete and not progress.failures:
                seen.add(item.identity)
        finally:
            try:
                if item.folder is not None:
                    item.remaining = close_batch(item.folder)
            except OSError as error:
                record_error(progress, "Dossier de réception", error)
                item.remaining = item.folder
            finally:
                progress.guard = progress.guard[:-1]


def prepare_batch(urls, progress, stop, previous, *, titles=None, on_album=None):
    root = SHARED_LIBRARY
    inbox = root / INBOX
    if not root.is_dir() or not inbox.is_dir() or inbox.is_symlink():
        raise ImportIssue("path", f"Bibliothèque ou dossier de réception absent ou symbolique : {inbox}")
    require_commands("ffmpeg", "ffprobe", BIN / "musique-tri")
    from _parole_index import Index

    try:
        metrics = Index(root)
    except (OSError, sqlite3.Error):
        metrics = None
    counts = Counter()
    added = 0
    details = []
    seen = set()
    urls = list(dict.fromkeys(urls))
    for index, url in enumerate(urls, 1):
        child = ImportProgress(journal=progress.journal, json_output=progress.json_output, url=url)
        child.guard = progress.guard
        child.download_lock = RLock()
        child.measure_index = metrics
        item = BatchAlbum(url, (titles or {}).get(url) or f"Album {index}", child)
        started = monotonic()

        def report(message, fraction):
            with child.download_lock:
                if fraction is not None:
                    item.fraction = max(item.fraction, fraction)
                progress.emit(f"{index}/{len(urls)} · {item.title} · {message}",
                              (index - 1 + item.fraction) / len(urls), url=url,
                              album_fraction=item.fraction, processed=item.processed)

        child.report = report
        if not stop.is_set():
            try:
                if local_url(url):
                    selection = local_selection(url)
                    provider = selection[1]
                    progress.emit(f"{provider} · import de la sélection", event="provider", provider=provider)
                    report("Vérification dans la collection", 0)
                    import_local(item, root, inbox, previous.get(url, {}), stop, seen, selection)
                elif external := archive_identifier(urlsplit(url)):
                    progress.emit(f"{ARCHIVE} · vérification de la fiche", event="provider", provider=ARCHIVE)
                    report("Vérification dans la collection", 0)
                    import_internet_archive(item, root, inbox, previous.get(url, {}), stop, seen, external)
                elif external := jamendo_identifier(urlsplit(url)):
                    progress.emit(f"{JAMENDO} · vérification de la fiche", event="provider", provider=JAMENDO)
                    report("Vérification dans la collection", 0)
                    import_jamendo(item, root, inbox, previous.get(url, {}), stop, seen, external)
                else:
                    progress.emit(f"{YOUTUBE} · vérification du lien", event="provider", provider=YOUTUBE)
                    report("Vérification dans la collection", 0)
                    import_album(item, root, inbox, previous.get(url, {}), stop, seen)
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                record_error(child, "Import de l’album", error)
        if item.status != "duplicate":
            if child.failures:
                item.status = "partial" if item.tracks else "failure"
            elif item.audio_complete:
                item.status = "success" if item.added or url in previous else "present"
            else:
                item.status = "pending"
        diagnostics = album_diagnostics(item)
        category = ("partial" if item.status == "partial" else diagnostics[0]["category"] if diagnostics
                    else "present" if item.status == "present" else None)
        message = CATEGORIES.get(category) or {
            "success": "Import terminé", "duplicate": "Lien en double", "pending": "Arrêté avant téléchargement",
        }[item.status]
        outcome = dict(url=url, title=item.title, status=item.status, category=category, diagnostics=diagnostics,
                       added=item.added, tracks=item.tracks, audio_complete=item.audio_complete,
                       remaining=str(item.remaining) if item.remaining else None, identity=item.identity,
                       processed=item.processed, message=message, artist=item.artist or "")
        if item.provenance:
            outcome["provenance"] = item.provenance
        if item.provider:
            outcome["provider"] = item.provider
        if metrics is not None and item.provider and item.status not in {"pending", "duplicate"}:
            failures = [value for value in diagnostics if value["category"] in {"network", "download", "audio_unavailable"}
                        and not value["stage"].startswith(("Paroles", "Pochettes"))]
            if item.audio_complete and (item.processed or item.added) or failures:
                observe(metrics, item.provider, {TOTAL: monotonic() - started, SUCCEEDED: int(item.audio_complete)})
            if item.provider == YOUTUBE:
                for value in failures:
                    code = re.search(r"\bhttp(?: error)?[ :]+(429|5\d\d)\b", value["detail"], re.I)
                    if code:
                        limited(metrics, YOUTUBE, 60 if code[1] == "429" else 12, int(code[1]))
            try:
                measured = snapshot(metrics).get(item.provider, {}).get(THROUGHPUT)
            except sqlite3.Error:
                measured = None
            if measured:
                outcome["measured_bytes_per_second"] = measured["mean"]
        if on_album is not None:
            on_album(outcome)
        progress.emit(fraction=index / len(urls), event="album", **outcome)
        counts[item.status] += 1
        added += item.added
        if not progress.json_output:
            details.extend(f"{item.title} · {entry['stage']}\n{entry['detail']}" for entry in diagnostics)
        if any(diagnostic["category"] == "space" for diagnostic in diagnostics):
            break

    failed = bool(counts["failure"] or counts["partial"])
    if len(urls) == 1:
        if item.status == "failure":
            category = album_diagnostics(item)[0]["category"]
            message = f"{CATEGORIES[category]} · {item.title}"
        elif item.status == "partial":
            message = f"Importation partielle · {item.title} · {added} piste(s) ajoutée(s)."
        elif item.status == "present":
            message = f"Album déjà présent · {item.title}."
        elif item.status == "pending":
            message = "Import arrêté avant téléchargement."
        else:
            message = f"Import terminé · {added} piste(s) ajoutée(s)."
    else:
        summary = [f"{counts['success']} album(s) importé(s)", f"{counts['present']} déjà en collection"]
        for status, label in (("partial", "importation(s) partielle(s)"), ("failure", "échec(s)"),
                              ("duplicate", "lien(s) en double"), ("pending", "arrêté(s) avant téléchargement")):
            if counts[status]:
                summary.append(f"{counts[status]} {label}")
        message = " · ".join(summary)
    event = ("failure" if failed else "cancelled" if stop.is_set() else
             "skip" if not counts["success"] and counts["present"] else "success")
    fields = {"interrupted": True} if stop.is_set() else {}
    if not progress.json_output and failed:
        fields["detail"] = "\n\n".join(details)
    progress.emit(message, 1.0, event=event, **fields)
    return int(failed)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("url", nargs="?", help="lien d’album ou URI file:// d’un fichier, dossier ou ZIP local")
    mode.add_argument("--lot", nargs="+", help=argparse.SUPPRESS)
    mode.add_argument("--import-file", metavar="LOT", help=argparse.SUPPRESS)
    mode.add_argument("--chercher-archives", metavar="ARTISTE_OU_ALBUM", help="recherche Internet Archive")
    mode.add_argument("--chercher-jamendo", metavar="ARTISTE_OU_ALBUM", help="recherche Jamendo")
    parser.add_argument("--import-lease", type=int, help=argparse.SUPPRESS)
    mode.add_argument("--revision", action="store_true",
                      help="recherche les pochettes et les paroles manquantes dans toute la bibliothèque")
    mode.add_argument("--paroles-manquantes", action="store_true",
                      help="cherche uniquement les paroles absentes de la bibliothèque")
    mode.add_argument("--pochettes-manquantes", action="store_true",
                      help="cherche uniquement les pochettes absentes de la bibliothèque")
    parser.add_argument("--suivi-json", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--reprendre", metavar="JOURNAL", help="relance les liens en échec depuis ce journal")
    args = parser.parse_args()
    if args.chercher_archives is not None or args.chercher_jamendo is not None:
        try:
            provider, adapter, query = ((ARCHIVE, archive, args.chercher_archives) if args.chercher_archives is not None
                                        else (JAMENDO, jamendo, args.chercher_jamendo))
            provider_index = import_provider_index(SHARED_LIBRARY, provider)
            inbox = SHARED_LIBRARY / INBOX
            if not inbox.is_dir() or inbox.is_symlink():
                raise ImportIssue("path", "Dossier de réception absent ou symbolique.")
            with resource_slot(inbox / ".kara-catalogue", CATALOGUE):
                started = monotonic()
                try:
                    results = adapter.search(provider_index, query)
                finally:
                    observe(provider_index, provider, {LOOKUP: monotonic() - started})
                print(json.dumps({"data": results}, ensure_ascii=False))
            return 0
        except (OSError, ValueError) as error:
            print(json.dumps({"category": getattr(error, "category", "network"), "error": str(error)}, ensure_ascii=False))
            return 1
    maintenance = (find_missing_lyrics if args.paroles_manquantes else
                   find_missing_covers if args.pochettes_manquantes else revise if args.revision else None)
    if args.reprendre and maintenance:
        parser.error("--reprendre demande un ou plusieurs liens d’album")
    if args.suivi_json and args.revision:
        parser.error("--suivi-json ne prend pas en charge --revision")
    if args.lot and not args.suivi_json:
        parser.error("--lot demande --suivi-json")
    os.umask(0o007)
    progress = ImportProgress(json_output=args.suivi_json)
    urls = args.lot or ([args.url] if args.url is not None else [])
    stop = Event()
    queue = job = None
    titles = {}
    if args.import_file:
        queue = ImportQueue()
        job = queue.job(args.import_file)
        if job is None or job["state"] != "running" or args.import_lease is None:
            parser.error("lot absent ou non réservé")
        lock = queue.directory / f"{job['id']}.lock"
        if not os.path.samestat(os.fstat(args.import_lease), lock.stat()):
            parser.error("réservation de lot invalide")
        progress.guard = (args.import_lease,)
        progress.managed = True
        titles = {url: title for title, url in job["targets"]}
        urls = list(titles)
        maintenance = {"--paroles-manquantes": find_missing_lyrics,
                       "--pochettes-manquantes": find_missing_covers}.get(job["option"])
    if args.lot or job:
        signal.signal(signal.SIGUSR1, lambda *_: stop.set())
    if job:
        # Publish the local diagnostic first. The worker then commits the
        # final state before notifying GTK, including if GTK has closed.
        progress.commit_result = lambda event, message, terminal: queue.finish(job["id"], event, message, terminal)
    try:
        with ImportLog() as journal:
            progress.journal = journal
            journal.write({"event": "header", "version": 1, "library": str(SHARED_LIBRARY), "urls": urls,
                           "queue_job": job["id"] if job else None})
            if job:
                queue.set_journal(job["id"], journal.path)
            progress.emit(f"Journal : {journal.path}", event="journal", path=str(journal.path))
            try:
                if args.revision:
                    return revise()
                if maintenance:
                    return maintenance(progress)
                check_space(progress.journal.path.parent, state=True)
                previous = queue.outcomes(job["id"]) if job else {}
                legacy = args.reprendre or (job["journal"] if job and not previous else None)
                if legacy:
                    original, outcomes = retry_albums(legacy, SHARED_LIBRARY)
                    if not set(urls) <= original:
                        raise ImportIssue("path", "Les liens à reprendre doivent provenir du journal sélectionné.")
                    previous = {url: item for url, item in outcomes.items() if item["status"] in {"failure", "partial"}}
                    # Allow unfinished links after a fatal error, but never run an
                    # already successful, skipped or deliberately stopped album.
                    urls = [url for url in urls if url not in outcomes or url in previous]
                    if not urls:
                        progress.emit("Aucun import en échec dans cette sélection.", 1.0, event="skip")
                        return 0
                if job:
                    urls = [url for url in urls if previous.get(url, {}).get("status") not in COMPLETE]
                    if not urls:
                        progress.emit("Les albums du lot sont déjà terminés.", 1., event="skip")
                        return 0
                return prepare_batch(urls, progress, stop, previous, titles=titles,
                                     on_album=(lambda outcome: queue.album(job["id"], outcome)) if job else None)
            except ImportIssue as error:
                progress.finish_issue(error)
            except KeyboardInterrupt:
                progress.emit("Import interrompu.", event="cancelled", interrupted=True)
                return 130
            except OSError as error:
                progress.finish_issue(ImportIssue("path", str(error)))
            except (ValueError, subprocess.SubprocessError) as error:
                progress.finish_issue(ImportIssue("processing", str(error)))
    except OSError as error:
        progress.journal = None
        progress.finish_issue(ImportIssue("path", f"Journal d’import inaccessible : {error}"))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
