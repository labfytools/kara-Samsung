class ServiceUnavailable(Exception):
    def __init__(self, message, reason="unavailable"):
        super().__init__(message)
        self.reason = reason


class AmbiguousLyrics(ValueError):
    pass


class NoRedirect(HTTPRedirectHandler):
    # Les titres recherchés restent sur le domaine du fournisseur choisi.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def command(args, description):
    try:
        result = subprocess.run(args, capture_output=True, timeout=40)
    except subprocess.TimeoutExpired as error:
        raise ValueError(f"{description} (délai dépassé)") from error
    if result.returncode:
        raise ValueError(description)
    return result.stdout


def retry_delay(header, fallback):
    if not header:
        return fallback
    try:
        indicated = int(header) if header.isdecimal() else parsedate_to_datetime(header).timestamp() - time.time()
    except (ValueError, TypeError, OverflowError):
        return fallback
    return max(fallback, indicated)


class RequestGate:
    def __init__(self, interval):
        self.interval = interval
        self.lock = Lock()
        self.next_request = 0.0
        self.paused = False
        self.provider = None
        self.deadline = None
        self.requests = 0
        self.audit = None

    def remaining(self, limit):
        return limit if self.deadline is None else max(0., min(limit, self.deadline - time.monotonic()))

    def wait(self, host):
        if self.provider is not None:
            from _parole_sources import ProviderUnavailable, wait_provider

            try:
                wait_provider(*self.provider, host, self.interval, max_wait=self.remaining(3), lyrics=True)
                return True
            except ProviderUnavailable as error:
                reason = "limited" if "quotidienne" in str(error) or "suspendu" in str(error) else "unavailable"
                raise ServiceUnavailable(str(error), reason) from error
        if host == "lrclib.net" or os.environ.get("KARA_IMPORT_PROCESSING"):
            try:
                wait_service(host, self.interval, max_wait=30)
                return True
            except ImportIssue:
                return False
        while True:
            with self.lock:
                if self.paused:
                    return False
                now = time.monotonic()
                delay = self.next_request - now
                if delay <= 0:
                    self.next_request = now + self.interval
                    return True
            time.sleep(delay)

    def defer(self, host, delay, status=429):
        if host == "lrclib.net" or self.provider is not None or os.environ.get("KARA_IMPORT_PROCESSING"):
            if self.provider:
                from _parole_sources import provider_backoff

                delay = provider_backoff(*self.provider, host, delay, status,
                                         lookup_access=status in ACCESS_DENIED)
            defer_service(host, delay)
            return
        with self.lock:
            if delay > 30:
                self.paused = True
            else:
                self.next_request = max(self.next_request, time.monotonic() + delay)

    @contextmanager
    def open(self, opener, request, timeout):
        if self.audit is None:
            with self.transport(opener, request, timeout) as response:
                yield response
            return
        before = self.requests
        event = {"type": "request", "url": request.full_url}
        try:
            with self.transport(opener, request, timeout) as response:
                event["http"] = getattr(response, "status", 200)
                yield response
        except HTTPError as error:
            event.update(http=error.code, retry_after=(error.headers or {}).get("Retry-After"))
            raise
        except (ServiceUnavailable, OSError) as error:
            event["reason"] = str(error)
            raise
        finally:
            event["sent"] = self.requests > before
            self.audit(event)

    @contextmanager
    def transport(self, opener, request, timeout):
        host = urlsplit(request.full_url).hostname
        if host == "lrclib.net":
            from _parole_sources import request_slot

            # Two searches may queue behind the serialized remote
            # cadence. Leave room for that wait within the form budget.
            slot = request_slot(host, self.remaining(20))
        else:
            slot = (resource_slot(RATE_DIRECTORY / "lyrics" / sha256(self.provider[1].encode()).hexdigest(),
                                  1, timeout=self.remaining(3)) if self.provider else nullcontext())
        try:
            with slot:
                if not self.remaining(timeout) or not self.wait(host) or not (budget := self.remaining(timeout)):
                    raise ServiceUnavailable("Budget de temps ou créneau fournisseur indisponible")
                self.requests += 1
                try:
                    with opener.open(request, timeout=budget) as response:
                        if self.provider:
                            from _parole_sources import record_quota

                            record_quota(*self.provider, response.headers)
                        yield response
                except HTTPError as error:
                    if self.provider:
                        from _parole_sources import record_quota

                        record_quota(*self.provider, error.headers or {})
                    error.close()
                    if error.code in ACCESS_DENIED:
                        # An access refusal says nothing about a track. Apply
                        # the provider's existing gate before any other lookup.
                        self.defer(host, retry_delay(error.headers.get("Retry-After"), ACCESS_REVIEW_DELAY),
                                   error.code)
                    elif self.provider and (error.code == 429 or error.code >= 500):
                        self.defer(host, retry_delay(error.headers.get("Retry-After"), 5), error.code)
                    raise
                except (URLError, TimeoutError):
                    if self.provider:
                        self.defer(host, 5, 503)
                    raise
        except ImportIssue as error:
            raise ServiceUnavailable(str(error)) from error


def candidate_evidence(record, text, decision):
    metadata = {key: record[key][:240] for key in ("trackName", "artistName", "albumName")
                if isinstance(record.get(key), str)}
    duration = record.get("duration")
    if type(duration) in (int, float) and 0 < duration <= 3603:
        metadata["duration"] = duration
    identity = record.get("id")
    if type(identity) is int and 0 < identity < 2**63:
        metadata["catalogue_id"] = identity
    elif isinstance(identity, str) and re.fullmatch(r"[A-Za-z0-9]{1,64}", identity):
        metadata["catalogue_id"] = identity
    return dict(cache_value(text, metadata), decision=decision)


class LrcLib:
    def __init__(self):
        self.opener = build_opener(NoRedirect)
        self.gate = RequestGate(0.75)
        self.answers = None
        self.edition_candidate = False
        self.candidates = []
        self.exact_complements = {}

    def get(self, endpoint, **params):
        url = f"https://lrclib.net/api/{endpoint}?{urlencode(params)}"
        if self.answers is not None and url in self.answers:
            return self.answers[url]
        response = self.fetch(url)
        if self.answers is not None and len(self.answers) < MAX_LRC_SEARCHES + 1:
            self.answers[url] = response
        return response

    def fetch(self, url):
        request = Request(url, headers={
            "Accept": "application/json",
            "User-Agent": "ParolesMusique/1.0 (https://github.com/labfytools/kara-Samsung)",
        })
        for delay in ((None,) if self.gate.provider else (2, 5, None)):
            last_attempt = delay is None
            try:
                with self.gate.open(self.opener, request, 6 if self.gate.provider else 10) as response:
                    if response.headers.get_content_type() != "application/json":
                        raise ServiceUnavailable("réponse LRCLIB inattendue")
                    raw = response.read(MAX_RESPONSE + 1)
                if len(raw) > MAX_RESPONSE:
                    raise ServiceUnavailable("réponse LRCLIB trop volumineuse")
                try:
                    return json.loads(raw)
                except ValueError as error:
                    raise ServiceUnavailable("réponse LRCLIB illisible") from error
            except HTTPError as error:
                if error.code == 404:
                    return None
                if error.code not in {429, 500, 502, 503, 504}:
                    raise ServiceUnavailable(f"LRCLIB a répondu HTTP {error.code}", "limited" if error.code == 429 else "unavailable") from error
                delay = retry_delay(error.headers.get("Retry-After"), delay or 5)
                if not self.gate.provider:
                    self.gate.defer(urlsplit(request.full_url).hostname, delay, error.code)
                if delay > 30:
                    raise ServiceUnavailable("LRCLIB demande d’attendre avant de réessayer", "limited") from error
                if last_attempt:
                    raise ServiceUnavailable(f"LRCLIB a répondu HTTP {error.code}", "limited" if error.code == 429 else "unavailable") from error
            except (URLError, TimeoutError) as error:
                if delay is None:
                    raise ServiceUnavailable(f"LRCLIB inaccessible : {error}", "network") from error
            time.sleep(delay)

    def find(self, title, artist, album, duration, album_artist, *, synced=False):
        self.edition_candidate = False

        def observe(record, text, status):
            if self.gate.audit:
                item = candidate_evidence(record, text, status)
                self.gate.audit({"type": "candidate", **{k: v for k, v in item.items() if k != "text"}})
            if text and status == "other-edition":
                self.edition_candidate = True
            if text and status in ("compatible", "other-edition"):
                item = candidate_evidence(record, text, status)
                if item not in self.candidates and len(self.candidates) < 12:
                    self.candidates.append(item)
                    self.candidates.sort(key=lambda row: row["decision"] != "compatible")

        code = getattr(self, "isrc", "")
        original_lrc = getattr(self, "original_lrc", False)
        signature = title, artist, album, duration, album_artist
        exact = dict(track_name=title, artist_name=artist, duration=duration)
        if album:
            exact["album_name"] = album
        record = self.get("get", **exact)
        scores = []
        def assess(record):
            score = recording_score(record, *signature, isrc=code, synced=synced,
                                    on_reject=lambda item, reason: observe(
                                        item, transcript(item, duration, synced, original_lrc=original_lrc), reason))
            if score is None:
                return None
            text = transcript(record, duration, synced, original_lrc=original_lrc)
            observe(record, text, "compatible" if text is not None else "format-indisponible")
            if text is not None:
                scores.append((score, text, record))
            return text

        result = assess(record)
        # One exact response may establish both forms. Validate the timed
        # identity independently before sharing either native or legacy data.
        if recording_score(record, *signature, isrc=code, synced=True) is not None:
            forms = ((False, False),) if synced else ((True, True), (True, False))
            for timed, native in forms:
                if companion := transcript(record, duration, timed, original_lrc=native):
                    self.exact_complements[timed, native] = cache_value(
                        companion, candidate_evidence(record, companion, "")["metadata"])
            if result is not None:
                return result

        for label, credit, edition in lyric_queries(title, artist, album, album_artist,
                                                   timed=synced)[:MAX_LRC_SEARCHES]:
            query = {"track_name": label, "artist_name": credit}
            if edition:
                query["album_name"] = edition
            try:
                records = self.get("search", **query)
            except ServiceUnavailable as error:
                if not scores:
                    raise
                self.failure = error
                break
            for record in records[:20] if isinstance(records, list) else ():
                assess(record)
            if scores:
                # Once discovery yields competing top candidates, keep the
                # conflict and move to an independent provider.
                best = max(score for score, _, _ in scores)
                contenders = [(text, record) for score, text, record in scores if score == best]
                editions = {record.get("albumName") for _, record in contenders}
                if synced or edition or album in editions or result is not None:
                    return choose_transcript(contenders, synced, getattr(self, "strict", False))
                result = scores[0][1]
        if scores:
            best = max(score for score, _, _ in scores)
            return choose_transcript([(text, record) for score, text, record in scores if score == best],
                                     synced, getattr(self, "strict", False))
        return None


class LyricsOvh:
    def __init__(self):
        self.opener = build_opener(NoRedirect)
        self.gate = RequestGate(0.5)

    def get(self, path):
        request = Request(f"https://api.lyrics.ovh/{path}", headers={
            "Accept": "application/json", "User-Agent": "ParolesMusique/1.1",
        })
        try:
            with self.gate.open(self.opener, request, 6) as response:
                if response.headers.get_content_type() != "application/json":
                    self.failure = ServiceUnavailable("Réponse JSON attendue")
                    return None
                raw = response.read(MAX_RESPONSE + 1)
            if len(raw) > MAX_RESPONSE:
                self.failure = ServiceUnavailable("Réponse trop volumineuse")
                return None
            return json.loads(raw)
        except HTTPError as error:
            if error.code != 404:
                self.failure = ServiceUnavailable(f"Service HTTP {error.code}", "limited" if error.code == 429 else "unavailable")
            if not self.gate.provider and (error.code == 429 or error.code >= 500):
                self.gate.defer(urlsplit(request.full_url).hostname,
                                retry_delay(error.headers.get("Retry-After"), 5), error.code)
            return None
        except (OSError, ValueError):
            self.failure = ServiceUnavailable("Service indisponible", "network")
            return None

    def find(self, title, artist, album, duration, album_artist):
        # La recherche Deezer associée fournit l’identité et la durée. L’API
        # des paroles, elle, ne répond qu’avec du texte.
        base_title, _ = split_feature(clean_title(without_track_number(title)))
        query = quote(getattr(self, "search_terms", None) or f"{album_artist or artist} {base_title}", safe="")
        response = self.get(f"suggest/{query}")
        if not isinstance(response, dict):
            return None
        candidates = set()
        for track in response.get("data") or []:
            if not isinstance(track, dict):
                continue
            name = (track.get("artist") or {}).get("name")
            track_title = track.get("title")
            metadata = dict(trackName=track_title, artistName=name,
                            albumName=(track.get("album") or {}).get("title"),
                            duration=track.get("duration"))
            score = audit_score(self, metadata, title, artist, album, duration, album_artist, synced=False)
            if score is not None:
                candidates.add((score, name, track_title))
        if not candidates:
            return None
        top = max(score for score, _, _ in candidates)
        keys = {(name, track) for score, name, track in candidates if score == top}
        def fetch(key):
            name, track = key
            response = self.get(f"v1/{quote(name, safe='')}/{quote(track, safe='')}")
            return usable_text(response.get("lyrics"), 32_000) if isinstance(response, dict) else None

        return available_transcript(dict.fromkeys(sorted(keys)[:4], top), fetch, self)


class PublicLyrics:
    USER_AGENT = "ParolesMusique/1.2 (client local pour Strawberry)"

    def __init__(self):
        self.opener = build_opener(NoRedirect)
        self.gate = RequestGate(0.5)

    def get(self, url, *, html=False, referer=None):
        headers = {
            "Accept": "text/html" if html else "application/json",
            "User-Agent": self.USER_AGENT,
        }
        if referer:
            headers["Referer"] = referer
        request = Request(url, headers=headers)
        try:
            with self.gate.open(self.opener, request, 6) as response:
                raw = response.read(MAX_RESPONSE + 1)
            if len(raw) <= MAX_RESPONSE:
                return raw.decode("utf-8") if html else json.loads(raw)
            self.failure = ServiceUnavailable("Réponse trop volumineuse")
        except HTTPError as error:
            if error.code != 404:
                self.failure = ServiceUnavailable(f"Service HTTP {error.code}", "limited" if error.code == 429 else "unavailable")
            if not self.gate.provider and (error.code == 429 or error.code >= 500):
                self.gate.defer(urlsplit(request.full_url).hostname,
                                retry_delay(error.headers.get("Retry-After"), 5), error.code)
            return None
        except (OSError, ValueError):
            self.failure = ServiceUnavailable("Service indisponible", "network")
            return None


class NetEase(PublicLyrics):
    def find(self, title, artist, album, duration, album_artist, *, synced):
        if synced and not album:
            return None
        base_title, _ = split_feature(clean_title(without_track_number(title)))
        params = urlencode({"s": getattr(self, "search_terms", None) or f"{album_artist or artist} {base_title}", "type": 1, "limit": 12})
        response = self.get(f"https://music.163.com/api/search/get?{params}")
        if not isinstance(response, dict):
            return None
        if response.get("code", 200) != 200:
            self.failure = ServiceUnavailable("NetEase a refusé la recherche")
            return None
        songs = (response.get("result") or {}).get("songs") or []
        candidates = {}
        for song in songs:
            milliseconds = song.get("duration")
            song_id = song.get("id")
            if type(milliseconds) not in (int, float) or type(song_id) is not int:
                continue
            metadata = dict(trackName=song.get("name"),
                            artistName=", ".join(a["name"] for a in song.get("artists", []) if a.get("name")),
                            albumName=(song.get("album") or {}).get("name"),
                            duration=milliseconds / 1000)
            score = audit_score(self, metadata, title, artist, album, duration, album_artist, synced=synced)
            if score is not None:
                candidates[song_id] = score
        def fetch(song_id):
            response = self.get(f"https://music.163.com/api/song/lyric?id={song_id}&lv=1")
            if isinstance(response, dict) and response.get("code", 200) not in (200, 404):
                self.failure = ServiceUnavailable("NetEase a refusé l’accès au texte")
                return None
            lrc = (response.get("lrc") or {}) if isinstance(response, dict) else {}
            raw = lrc.get("lyric") if isinstance(lrc, dict) else None
            return catalog_transcript(raw, duration, synced=synced,
                                      original_lrc=getattr(self, "original_lrc", False))

        return available_transcript(candidates, fetch, self)


class QQMusic(PublicLyrics):
    REFERER = "https://y.qq.com/"
    USER_AGENT = "ParolesMusique/1.3"
    EXPLICIT = re.compile(r"\s*(?:\[explicit\]|\(explicit\))\s*$", re.I)

    def remove_explicit(self, value):
        return self.EXPLICIT.sub("", value) if isinstance(value, str) else ""

    def find(self, title, artist, album, duration, album_artist, *, synced):
        if synced and not album:
            return None
        base_title, _ = split_feature(clean_title(without_track_number(title)))
        service = "music.search.SearchCgiService"
        search = {
            service: {
                "module": service,
                "method": "DoSearchForQQMusicDesktop",
                "param": {"search_type": 0, "query": getattr(self, "search_terms", None) or f"{album_artist or artist} {base_title}",
                          "page_num": 1, "num_per_page": 8},
            },
        }
        params = urlencode({"data": json.dumps(search, ensure_ascii=False, separators=(",", ":")),
                            "format": "json"})
        result = self.get(f"https://u.y.qq.com/cgi-bin/musicu.fcg?{params}", referer=self.REFERER)
        if not isinstance(result, dict):
            return None
        if result.get("code", 0) != 0 or (result.get(service) or {}).get("code", 0) != 0:
            self.failure = ServiceUnavailable("QQ Music a refusé la recherche")
            return None
        body = ((result.get(service) or {}).get("data") or {}).get("body") or {}
        songs = (body.get("song") or {}).get("list") or []
        candidates = {}
        for song in songs:
            if not isinstance(song, dict):
                continue
            song_id = song.get("mid")
            if not isinstance(song_id, str) or not re.fullmatch(r"[A-Za-z0-9]{8,32}", song_id):
                continue
            label = song.get("title") or song.get("name")
            album_label = (song.get("album") or {}).get("name")
            strict = getattr(self, "strict", False)
            metadata = dict(
                trackName=label if strict else self.remove_explicit(label),
                artistName=", ".join(singer["name"] for singer in song.get("singer") or []
                                     if isinstance(singer, dict) and isinstance(singer.get("name"), str)),
                albumName=album_label if strict else self.remove_explicit(album_label),
                duration=song.get("interval"),
            )
            score = audit_score(self, metadata, title if strict else self.remove_explicit(title), artist,
                                album if strict else self.remove_explicit(album), duration, album_artist, synced=synced)
            if score is not None:
                candidates[song_id] = score

        def fetch(song_id):
            params = urlencode({"songmid": song_id, "format": "json", "nobase64": 1})
            response = self.get(f"https://c.y.qq.com/lyric/fcgi-bin/fcg_query_lyric_new.fcg?{params}",
                                referer=self.REFERER)
            if not isinstance(response, dict):
                return None
            if response.get("code") != 0:
                self.failure = ServiceUnavailable("QQ Music a refusé l’accès au texte")
                return None
            raw = response.get("lyric")
            original_lrc = getattr(self, "original_lrc", False)
            if isinstance(raw, str) and not original_lrc:
                raw = unescape(raw)
            return catalog_transcript(raw, duration, synced=synced, original_lrc=original_lrc)

        return available_transcript(candidates, fetch, self)


class GeniusLyrics(HTMLParser):
    def __init__(self):
        super().__init__()
        self.fragments = []
        self.divs = 0
        self.excluded = []

    def handle_starttag(self, tag, attrs):
        attributes = dict(attrs)
        if not self.divs:
            if tag == "div" and attributes.get("data-lyrics-container") == "true":
                self.divs = 1
            return
        if tag == "div":
            self.divs += 1
        if tag in {"br", "hr", "img", "input", "wbr", "area", "embed", "source"}:
            if tag == "br" and not self.excluded:
                self.fragments.append("\n")
        elif self.excluded or "data-exclude-from-selection" in attributes or tag in {"script", "style", "button", "svg"}:
            self.excluded.append(tag)

    def handle_endtag(self, tag):
        if not self.divs:
            return
        if self.excluded and self.excluded[-1] == tag:
            self.excluded.pop()
        if tag == "div":
            self.divs -= 1
            if not self.divs:
                self.excluded.clear()
                self.fragments.append("\n")

    def handle_data(self, data):
        if self.divs and not self.excluded:
            self.fragments.append(data)


class Genius(PublicLyrics):
    def find(self, title, artist, album, duration, album_artist):
        base_title, _ = split_feature(clean_title(without_track_number(title)))
        params = urlencode({"q": getattr(self, "search_terms", None) or f"{album_artist or artist} {base_title}"})
        response = self.get(f"https://genius.com/api/search/song?{params}")
        if not isinstance(response, dict):
            return None
        sections = (response.get("response") or {}).get("sections") or []
        hits = next((section.get("hits") or [] for section in sections if section.get("type") == "song"), [])
        candidates = {}
        for hit in hits[:6]:
            song = hit.get("result") or {}
            found_title, _ = split_feature(clean_title(normalized(song.get("title"))))
            singer = (song.get("primary_artist") or {}).get("name")
            song_id = song.get("id")
            if (type(song_id) is not int or title_key(found_title) != title_key(base_title)
                    or credits(singer) not in (credits(album_artist), credits(artist))):
                continue
            details = self.get(f"https://genius.com/api/songs/{song_id}")
            if not isinstance(details, dict):
                continue
            song = (details.get("response") or {}).get("song") or {}
            apple_id = str(song.get("apple_music_id") or "")
            url = urlsplit(song.get("url") or "")
            if (not apple_id.isdecimal()
                    or url.scheme != "https" or url.netloc != "genius.com"):
                continue
            params = urlencode({"id": apple_id, "country": "fr"})
            catalog = self.get(f"https://itunes.apple.com/lookup?{params}")
            if not isinstance(catalog, dict):
                continue
            for track in catalog.get("results") or []:
                milliseconds = track.get("trackTimeMillis")
                if str(track.get("trackId")) != apple_id or type(milliseconds) not in (int, float):
                    continue
                metadata = dict(trackName=track.get("trackName"), artistName=track.get("artistName"),
                                albumName=track.get("collectionName"), duration=milliseconds / 1000)
                score = audit_score(self, metadata, title, artist, album, duration, album_artist, synced=False)
                if score is not None:
                    candidates[url.geturl()] = score
        def fetch(url):
            markup = self.get(url, html=True)
            if not markup:
                return None
            parser = GeniusLyrics()
            parser.feed(markup)
            parser.close()
            return usable_text("".join(parser.fragments), 32_000)

        return available_transcript(candidates, fetch, self)


class LyricDownPage(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []
        self.lrc = []
        self.records = []
        self.lyric_block = False
        self.script = None

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "a":
            path = urlsplit(attrs.get("href") or "").path
            if re.fullmatch(r"/(?:lyrics|lrc)/[a-z0-9-]+-\d+", path):
                self.links.append(path.replace("/lyrics/", "/lrc/", 1))
        elif tag == "pre" and "lrc-box" in (attrs.get("class") or "").split():
            self.lyric_block = True
        elif tag == "script" and attrs.get("type") == "application/ld+json":
            self.script = []

    def handle_data(self, data):
        if self.lyric_block:
            self.lrc.append(data)
        if self.script is not None:
            self.script.append(data)

    def handle_endtag(self, tag):
        if tag == "pre":
            self.lyric_block = False
        elif tag == "script" and self.script is not None:
            try:
                data = json.loads("".join(self.script))
            except ValueError:
                data = None
            if isinstance(data, dict):
                records = data.get("@graph", [data])
                self.records.extend(record for record in records
                                    if isinstance(record, dict) and record.get("@type") == "MusicRecording")
            self.script = None


def timed_local_lyrics(local, reference, duration, *, strict=False):
    def tokens(line):
        return re.findall(r"[^\W_]+", folded(line), flags=re.UNICODE)

    local_lines = [(line.strip(), tokens(line)) for line in local.splitlines()
                   if not re.fullmatch(r"\s*\[[^\]]+\]\s*", line)]
    local_lines = [(line, words) for line, words in local_lines if words]
    remote_lines = [(stamp, tokens(line)) for stamp, line in parse_lrc(reference)]
    remote_lines = [(stamp, words) for stamp, words in remote_lines if words]
    if len(remote_lines) < 3 or not duration * 0.6 <= remote_lines[-1][0] <= duration + 3:
        return None
    if [word for _, words in local_lines for word in words] != [word for _, words in remote_lines for word in words]:
        return None

    remote_index = 0
    offset = 0
    result = []
    for line, words in local_lines:
        start, remote_words = remote_lines[remote_index]
        if strict and (offset or len(words) != len(remote_words)):
            # V3 keeps measured/external line boundaries. The established
            # manual display may reconstruct split lines as before.
            return None
        if offset and remote_index + 1 < len(remote_lines):
            end = remote_lines[remote_index + 1][0]
            start += (end - start) * offset / len(remote_words)
        seconds = round(start * 100)
        minute, seconds = divmod(seconds, 6000)
        second, fraction = divmod(seconds, 100)
        result.append(f"[{minute:02}:{second:02}.{fraction:02}]{line}")

        offset += len(words)
        while remote_index < len(remote_lines) and offset >= len(remote_lines[remote_index][1]):
            offset -= len(remote_lines[remote_index][1])
            remote_index += 1
    return catalog_transcript("\n".join(result), duration, synced=True)


class LyricDown(PublicLyrics):
    BASE = "https://www.lyricdown.com"

    def page(self, path):
        contents = self.get(self.BASE + path, html=True)
        if contents:
            parsed = LyricDownPage()
            parsed.feed(contents)
            parsed.close()
            return parsed
        return None

    def find(self, title, artist, album, duration, album_artist, local_text):
        if not album or not usable_text(local_text, 32_000):
            return None
        base, _ = split_feature(clean_title(without_track_number(title)))
        prefixes = []
        for credit in (artist, artist_parts(title, artist, album_artist)[0]):
            slug = re.sub(r"[^a-z0-9]+", "-", folded(credit)).strip("-")
            if slug:
                prefixes.append("/lrc/" + slug + "-")
        if not prefixes:
            return None
        index = self.page("/search/" + quote(base, safe="") + "/")
        if index is None:
            return None
        candidates = dict.fromkeys(path for path in index.links if path.startswith(tuple(prefixes)))
        exact, regional = set(), set()
        for path in list(candidates)[:5]:
            page = self.page(path)
            if page is None or len(page.records) != 1:
                continue
            record = page.records[0]
            if title_key(split_feature(record.get("name") or "")[0]) != title_key(base):
                continue
            if credits((record.get("byArtist") or {}).get("name")) not in (credits(artist), credits(album_artist)):
                continue
            found_album = normalized((record.get("inAlbum") or {}).get("name"))
            region_free = re.sub(r"\s*\((?:u\.?k\.?|u\.?s\.?)(?: only)?\)$", "", found_album)
            if title_key(region_free) != title_key(album):
                continue
            result = timed_local_lyrics(local_text, "".join(page.lrc), duration, strict=getattr(self, "strict", False))
            if result:
                (exact if title_key(found_album) == title_key(album) else regional).add(result)
        selected = exact or regional
        if hasattr(self, "candidates"):
            self.candidates.extend(candidate_evidence({}, text, "compatible") for text in sorted(selected))
        return choose_transcript([(text, {}) for text in selected], True, getattr(self, "strict", False)) if selected else None


class LyricsSources:
    def __init__(self, *, persistent=False):
        self.lrc = LrcLib()
        self.ovh = LyricsOvh()
        self.netease = NetEase()
        self.qqmusic = QQMusic()
        self.genius = Genius()
        self.lyricdown = LyricDown()
        self.clients = (self.lrc, self.ovh, self.netease, self.qqmusic, self.genius, self.lyricdown)
        self.cache_hits = 0
        self.catalogue_requests = 0
        self.providers = set()
        if persistent:
            for client in self.clients:
                client.opener = KeepAlive(client.opener, MAX_RESPONSE)

    def new_track(self):
        self.lrc.answers = {}

    def start_form(self):
        # Waiting for a shared lookup or finishing the previous form must
        # not consume the provider budget of the form about to start.
        deadline = time.monotonic() + 35
        for client in self.clients:
            client.gate.deadline = deadline

    def close(self):
        for client in self.clients:
            if isinstance(client.opener, KeepAlive):
                client.opener.close()

    def find(self, title, artist, album, duration, album_artist, *, synced, local_text="",
             registry=None, strict=False, context=(), provider_only=None, isrc=None, recording=None,
             refresh=False, audit=None, original_lrc=False):
        from _parole_import_metrics import LOOKUP, snapshot
        from _parole_lrc_credit import CREDITED, RED, UNISON, save_links
        from _parole_sources import COMMUNITY_LRC, KUGOU, LYRICS_BROKER_UPSTREAMS, lyrics_rows, ready_sources

        signature = (title, artist, album, duration, album_artist)
        code = normalize_isrc(isrc)
        self.original_lrc = original_lrc
        prefer_words = synced and original_lrc
        choice = (None, None)
        entries = []
        from _parole_lrclib_local import candidates, configured_snapshot

        if provider_only is None and (snapshot_path := configured_snapshot()):

            try:
                records = candidates(snapshot_path, *signature)
                if value := best_transcript(records, *signature, synced=synced, strict=True, original_lrc=original_lrc):
                    matches = [row for row in records
                               if transcript(row, duration, synced, original_lrc=original_lrc) == value]
                    identity = matches[0]["id"] if len(matches) == 1 else None
                    entries.append(dict(cache_value(value, {"catalogue_id": identity}),
                                        provider="LRCLIB local", decision="compatible"))
                    if not prefer_words or has_word_timing(value):
                        if registry:
                            entries[0]["decision"] = "selected"
                            save_candidates(registry, recording, entries, synced=synced)
                        return value, "LRCLIB local"
                    choice = value, "LRCLIB local"
            except (OSError, sqlite3.Error, ValueError):
                # A stale, damaged or missing mirror leaves the normal
                # network path available with its own quota and evidence.
                pass
        if self.lrc.answers is None:
            self.new_track()
        if all(client.gate.deadline is None for client in self.clients):
            self.start_form()
        clients = {
            "LRCLIB": (self.lrc, {"synced": synced}),
            "NetEase": (self.netease, {"synced": synced}),
            "QQ Music": (self.qqmusic, {"synced": synced}),
            "LyricDown": (self.lyricdown, None),
            "Genius": (self.genius, {}),
            "lyrics.ovh": (self.ovh, {}),
        }
        names = (["LRCLIB", "NetEase", "QQ Music", "LyricDown"] if synced
                 else ["LRCLIB", "NetEase", "QQ Music", "Genius", "lyrics.ovh"])
        if "LyricDown" in names and (original_lrc or not local_text and provider_only != "LyricDown"):
            names.remove("LyricDown")
        providers, available, profiles, measured = {}, {}, {}, {}
        if registry:
            rows = lyrics_rows(registry)
            providers = {row["id"]: row for row in rows if row["state"] == "active"}
            if synced and original_lrc:
                if RED in providers and providers[RED]["availability"] != "configuration":
                    names.insert(1, RED)
                if code:
                    names.append(UNISON)
                names.extend(COMMUNITY_LRC)
                names.append(KUGOU)
            if audit:
                for row in rows:
                    if row["id"] in names and row["state"] != "active":
                        audit({"type": "provider", "provider": row["id"], "outcome": row["state"]})
            available = ready_sources(registry, time.time())
            measured = snapshot(registry)
            profiles = provider_profiles(registry, (name for name in names if name in providers), synced, context)
            names += [name for name, row in providers.items() if row["adapter"] == "lrclib"
                      and row["decoded"].get("validated")
                      and ("lrc" if synced else "lyrics") in row["category"].split(",")]

            def rank(item):
                i, name = item
                row = providers.get(name)
                sample = measured.get(name, {}).get(LOOKUP)
                if name == "lyrics.ovh":
                    return (3, 0, i)  # Broker of already-listed upstreams.
                if row and (priority := row["decoded"].get("lyrics_priority")) is not None:
                    return (0, priority, i)
                if name == "LRCLIB":
                    return (1, 0, i)  # Native word timing when present.
                if evidence := profiles.get(name):
                    costs = [m["seconds"] / max(.1, m["rate"]) for m in evidence]
                    return (2, sum(costs) / len(costs), i)
                if row is None or not sample or sample["samples"] < 5:
                    return (2, i + 2., i)
                success = (row["successes"] + 2) / (row["attempts"] + 4)
                return (2, sample["mean"] / success, i)

            names = [name for _, name in sorted(enumerate(names), key=rank)]
        if provider_only is not None:
            names = [name for name in names if name == provider_only]

        instrumental, failed, ambiguous = None, None, False
        quota = None
        for name in names:
            if prefer_words and choice[0] and not self.lrc.gate.remaining(1):
                break
            if not prefer_words and choice[0] and not ambiguous and name != "LRCLIB":
                continue
            if registry and name not in providers:
                continue
            row = providers.get(name)
            search_version = LRC_SEARCH_VERSION + int(name == UNISON)
            identity = cache_identity(name, (*signature, code), synced,
                                      local_text if name == "LyricDown" else "",
                                      strict, row["config"], original_lrc=original_lrc) if row is not None else None
            # LRCLIB transmits both forms together. They share the lookup
            # lease to let a concurrent text search reuse a verified LRC hit.
            lock_key = (cache_identity(name, (*signature, code), False, "", strict, row["config"])
                        if identity and name == "LRCLIB" else identity)
            try:
                with lookup_slot(registry, lock_key) if lock_key else nullcontext():
                    hit, result = cached(registry, identity) if identity and not refresh else (False, None)
                    if (hit and synced and original_lrc and result["text"] is None
                            and result.get("metadata", {}).get("search_version") != search_version):
                        hit = False

                    def note(event):
                        if audit:
                            audit({**event, "provider": name, "form": "lrc" if synced else "lyrics"})

                    if hit:
                        self.cache_hits += 1
                        review = result.get("metadata", {}).get("unverified")
                        if review:
                            entries.append(dict(review, provider=name))
                        note({"type": "provider", "outcome": "cache-review" if review else
                              "cache-hit" if result["text"] is not None else "cache-miss"})
                    elif registry and (name not in available or "limited_until" in measured.get(name, {})
                                       or name == "lyrics.ovh" and not set(LYRICS_BROKER_UPSTREAMS).issubset(
                                           ready_sources(registry, time.time()))):
                        reason = row["availability"]
                        status = row["last_http"]
                        quota_reached = row["remaining"] == 0 or status == 429
                        if reason == "upstream":
                            upstreams = [providers[n] for n in LYRICS_BROKER_UPSTREAMS if n in providers]
                            quota_reached = any(up["remaining"] == 0 or up["last_http"] == 429 for up in upstreams)
                        error = ServiceUnavailable("Fournisseur en pause ou quota atteint",
                                                   "limited" if quota_reached else "unavailable")
                        if quota_reached:
                            quota = error
                        else:
                            failed = error
                        note({"type": "provider", "outcome": reason, "remaining": row["remaining"],
                              "http": status, "retry_at": row["next_available"]})
                        continue
                    else:
                        result, error, conflict, candidates = self.query(
                            name, clients, row, signature, local_text, synced, registry, strict, context, code,
                            audit=note if audit else None,
                        )
                        if error and getattr(error, "reason", None) == "limited":
                            quota = error
                        else:
                            failed = error or failed
                        # An optional word-timing search cannot invalidate
                        # the compatible result already available as fallback.
                        ambiguous |= conflict and (not prefer_words or not choice[0])
                        entries.extend(dict(item, provider=name) for item in candidates)
                        if identity:
                            if not error and not conflict:
                                if synced and original_lrc and result["text"] is None:
                                    result["metadata"]["search_version"] = search_version
                                remember(registry, identity, result)
                            elif error:
                                temporary(registry, identity, name, str(error))
                            if name == "LRCLIB" and not conflict:
                                for (timed, native), value in self.lrc.exact_complements.items():
                                    other = cache_identity(name, (*signature, code), timed, "", strict, row["config"],
                                                           original_lrc=native)
                                    previous, old = cached(registry, other)
                                    if not previous or old["text"] is None:
                                        remember(registry, other, value)
            except ImportIssue as error:
                failed = ServiceUnavailable(str(error))
                if audit:
                    audit({"type": "provider", "provider": name, "outcome": "lock-timeout"})
                continue
            value = result["text"]
            if value:
                entries.append(dict(result, provider=name, decision="compatible"))
                if ambiguous:
                    continue
                if prefer_words:
                    if has_word_timing(value) and (not choice[0] or
                            choose_transcript([(choice[0], {}), (value, {})], True, False) == value):
                        choice = value, name
                        break
                    if not choice[0]:
                        choice = value, name
                    continue
                if choice[0] is None or WORD_STAMP.search(value):
                    choice = value, name
                # Ordered execution avoids fan-out against every catalogue.
                # LRCLIB still gets a chance to supply native word timing
                # before an explicitly preferred line result is returned.
                if not synced or WORD_STAMP.search(value) or name == "LRCLIB" or "LRCLIB" not in names:
                    break
                if (row and row["decoded"].get("lyrics_priority") is not None
                        and "LRCLIB" in available):
                    continue
                break
            if value == "":
                instrumental = name
        if ambiguous:
            choice = resolve_conflict(entries, synced, local_text)
        if registry and entries:
            selected = cache_value(choice[0])["sha256"]
            attribution = None
            for item in entries:
                if item["provider"] == choice[1] and item["sha256"] == selected:
                    item["decision"] = "selected"
                    attribution = item["metadata"].get("attribution") or attribution
                elif item["decision"] == "compatible":
                    item["decision"] = "alternative" if selected else "ambiguous"
            if choice[1] in CREDITED:
                save_links(registry, selected, choice[1], attribution)
            save_candidates(registry, recording, entries, synced=synced)
        if choice[0]:
            return choice
        if strict and ambiguous:
            raise AmbiguousLyrics("Correspondance ambiguë")
        if instrumental is not None:
            return "", instrumental
        if strict and quota:
            raise quota
        if strict and failed:
            if isinstance(failed, ServiceUnavailable):
                raise failed
            raise ServiceUnavailable("Au moins un fournisseur est indisponible")
        if strict and any(item["decision"] == "unverified" for item in entries):
            # The candidate is already available in the track details.
            # A provider's earlier retry horizon still wins over review.
            raise AmbiguousLyrics("Correspondance ambiguë")
        return None, None

    def query(self, name, clients, row, signature, local_text, synced, registry, strict, context, code, *, audit):
        from _parole_import_metrics import LOOKUP, SUCCEEDED, observe
        from _parole_lrc_catalogues import community_lookup, kugou_lookup, lookup
        from _parole_lrc_credit import CREDITED
        from _parole_sources import (COMMUNITY_LRC, KUGOU, LyricsEndpoint, ProviderUnavailable,
                                     lyrics_rows, record, record_lyrics)

        started = time.monotonic()
        candidates = []
        error, conflict, value = None, False, None
        client, kwargs = clients.get(name, (None, None))
        original_lrc = getattr(self, "original_lrc", False)
        if client:
            client.original_lrc = original_lrc
            client.failure = None
            client.candidates = []
            client.isrc = code
            client.strict = strict
            client.gate.provider = (registry, name) if registry else None
            client.gate.audit = audit
            requests = client.gate.requests
            if name == "LRCLIB":
                client.exact_complements = {}
            try:
                if kwargs is None:
                    value = client.find(*signature, local_text)
                elif name == "LRCLIB":
                    value = client.find(*signature, **kwargs)
                else:
                    title, artist, album, _, album_artist = signature
                    variants = lyric_queries(title, artist, album, album_artist, timed=synced)
                    # Catalogue queries need a fallback without the album
                    # and reserve one alternate for accents or artist aliases.
                    terms = list(dict.fromkeys(" ".join(filter(None, (credit, label, edition)))
                                               for label, credit, edition in variants))
                    for client.search_terms in terms[:3]:
                        value = client.find(*signature, **kwargs)
                        if value is not None or client.failure:
                            break
            except ServiceUnavailable as failure:
                client.failure = failure
            except AmbiguousLyrics:
                conflict = True
            finally:
                client.gate.audit = None
                client.search_terms = None
            error = client.failure
            contacted = requests != client.gate.requests
            candidates = client.candidates
        else:
            conf = row["decoded"]
            contacted = False

            def transport_event(event):
                nonlocal contacted
                contacted |= event["sent"]
                self.catalogue_requests += int(event["sent"])
                if audit:
                    audit(event)

            def candidate(record, text, decision):
                item = candidate_evidence(record, text, decision)
                if text and len(candidates) < 8:
                    candidates.append(item)
                if audit:
                    audit({"type": "candidate", **{key: value for key, value in item.items() if key != "text"}})

            try:
                title, artist, album, duration, album_artist = signature
                variants = lyric_queries(title, artist, album, album_artist, timed=synced)
                def score(item):
                    return recording_score(item, *signature, isrc=code,
                                           on_reject=lambda row, reason: candidate(row, None, reason))

                def native(raw):
                    return catalog_transcript(raw, duration, synced=True, original_lrc=True)

                if name in CREDITED:
                    label, credit, _ = next(iter(variants), (title, artist, album))
                    result = lookup(
                        name, signature, code, registry, transport_event,
                        score=score, validate=native,
                        search_text=f"{label} {credit}",
                    )
                    if result:
                        item, value, attribution = result
                        candidate(item, value, "compatible")
                        candidates[-1]["metadata"]["attribution"] = attribution
                elif name == KUGOU:
                    if result := kugou_lookup(signature, registry, transport_event, score=score, validate=native):
                        item, raw, verified = result
                        candidate(item, raw, "compatible" if verified else "unverified")
                        if verified:
                            value = raw
                elif name in COMMUNITY_LRC:
                    if result := community_lookup(name, signature, registry, transport_event,
                                                  score=score, validate=native, title_key=title_key):
                        item, value = result
                        candidate(item, value, "compatible")
                else:
                    variants = list(dict.fromkeys([(title, artist, album), *variants]))
                    endpoint = LyricsEndpoint(conf["host"], conf["path"])
                    for label, credit, edition in variants[:3]:
                        response = endpoint.search(label, credit, edition, registry=registry, provider=name,
                                                   audit=transport_event)
                        value = best_transcript(
                            response, *signature, synced=synced, strict=strict, isrc=code, original_lrc=original_lrc,
                            on_candidate=candidate, on_reject=lambda record, reason: candidate(record, None, reason),
                        )
                        if value is not None:
                            break
            except AmbiguousLyrics:
                conflict = True
            except (ProviderUnavailable, ValueError) as failure:
                error = failure
                if name in CREDITED or name == KUGOU or name in COMMUNITY_LRC:
                    current = next(row for row in lyrics_rows(registry) if row["id"] == name)
                    if current["last_http"] == 429 or current["remaining"] == 0:
                        error = ServiceUnavailable(str(failure), "limited")
        outcome = ("ambiguous" if conflict else "found" if value else "instrumental" if value == "" else
                   "error" if error else "different_edition" if candidates else "absent")
        if audit:
            audit({"type": "provider", "outcome": outcome, "contacted": contacted,
                   "reason": str(error) if error else None})
        if registry and contacted:
            self.providers.add(name)
            elapsed = time.monotonic() - started
            record(registry, name, "found" if outcome == "instrumental" else outcome,
                   elapsed, error=str(error) if error else "")
            if value:
                record_lyrics(registry, name, synced)
            observe(registry, name, {LOOKUP: elapsed, SUCCEEDED: int(value is not None)})
            record_profile(registry, name, synced, context, elapsed, value is not None)
        metadata = next((item["metadata"] for item in candidates if item["text"] == value), {})
        if unverified := next((item for item in candidates if item["decision"] == "unverified"), None):
            metadata = {"unverified": unverified}
        return cache_value(value, metadata), error, conflict, candidates


def clean_title(value):
    return REMASTER_SUFFIX.sub("", value).strip()


def normalized(value):
    if not isinstance(value, str):
        return ""
    return " ".join(normalize("NFKC", value).casefold().replace("’", "'").split())


def folded(value):
    value = "".join(char for char in normalize("NFKD", normalized(value)) if not combining(char))
    value = re.sub(r"\.{2,}", " ", value)
    return " ".join(re.sub(r"[-\u2010-\u2015]+", " ", value).split())


def split_feature(value):
    value = normalize("NFKC", value)
    match = re.fullmatch(r"(.+?)\s*[\[(](?:feat\.?|ft\.?|featuring)\s+(.+?)[\])]", value, re.I)
    if not match:
        match = re.fullmatch(r"(.+?)\s+(?:feat\.?|ft\.?|featuring)\s+(.+)", value, re.I)
    return (match[1], match[2]) if match else (value, "")


def credits(value):
    parts = re.split(r"\s*(?:,|;|&|\b(?:feat|ft|featuring)\.?\s+)\s*", normalized(value))
    return frozenset(folded(part) for part in parts if part)


def without_track_number(title):
    # A separator is required so a title such as "99 Problems" keeps its number.
    return re.sub(r"^\s*\d{1,3}\s*(?:[.\-–—_]\s*|\s+-\s+)(?=\S)", "", title)


def title_key(value):
    key = folded(clean_title(normalized(value))).strip(". !?¿¡")
    return re.sub(r"[, (]+(?:pt|part|partie)\.?\s+(\d+)\)?$", r" part \1", key)


def artist_parts(title, artist, album_artist):
    _, featured = split_feature(title)
    listed = re.split(r"\s*(?:[,;]|\s[&+]\s|\b(?:feat|ft|featuring)\.?\s+)\s*", artist)
    main = listed[0]
    if album_artist and credits(album_artist) and credits(album_artist) <= credits(artist):
        main = album_artist
    guests = dict.fromkeys([*listed[1:], *re.split(r"\s*[,;&]\s*", featured)])
    return main, [name for name in guests if name and credits(name) - credits(main)]


def lyric_queries(title, artist, album, album_artist, *, timed=False):
    numberless = without_track_number(title)
    base, _ = split_feature(clean_title(numberless))
    main, guests = artist_parts(title, artist, album_artist)
    folded_title = " ".join(re.findall(r"\w+", folded(base)))
    folded_artist = " ".join(re.findall(r"\w+", folded(main)))
    queries = [(base, main, None), (title, artist, album), (title, artist, None),
               (numberless, artist, None), (base, artist, None), (folded_title, folded_artist, None)]
    if timed and album:
        # Broad searches can fill the result window with releases that
        # cannot supply timing for this recording. Try the cleaned edition first.
        queries[:0] = [(base, main, album), (title, artist, album)]
    queries.extend((base, guest, None) for guest in guests[:2])
    return list(dict.fromkeys((t, a, ed) for t, a, ed in queries if t and a))


def recording_score(record, title, artist, album, duration, album_artist, *, on_edition=None, isrc="",
                    synced=True, on_reject=None):
    if not isinstance(record, dict):
        return None

    def reject(reason):
        if on_edition and reason == "other-edition":
            on_edition(record)
        if on_reject:
            on_reject(record, reason)
        return None

    actual_isrc = normalize_isrc(record.get("isrc"))
    own_raw = without_track_number(normalized(title))
    their_raw = without_track_number(normalized(record.get("trackName")))
    versions = (REMASTER_SUFFIX.search(own_raw), REMASTER_SUFFIX.search(their_raw))
    if bool(versions[0]) != bool(versions[1]) or (versions[0] and
            title_key(versions[0][0]) != title_key(versions[1][0])):
        return reject("version")
    own_title, own_feat = split_feature(clean_title(own_raw))
    their_title, their_feat = split_feature(clean_title(their_raw))
    if not own_title or title_key(their_title) != title_key(own_title):
        return reject("titre")
    their_album = record.get("albumName")
    length = record.get("duration")
    delta = abs(length - duration) if type(length) in (int, float) and 0 < length and isfinite(length) else float("inf")
    if delta > (3 if synced else max(8, duration * .05)):
        return reject("durée")
    expected = credits(artist) | credits(own_feat)
    actual = credits(record.get("artistName")) | credits(their_feat)
    primary = credits(artist_parts(title, artist, album_artist)[0])
    full_credit = actual == expected
    same_album = bool(album and title_key(their_album) == title_key(album))
    same_isrc = bool(isrc and actual_isrc == isrc)
    if not full_credit and not ((same_album or same_isrc) and primary and actual == primary and primary < expected):
        return reject("crédits")
    if isrc and actual_isrc and isrc != actual_isrc:
        return reject("other-edition")
    if synced and not (same_album or same_isrc):
        return reject("other-edition")
    if synced and album and not same_album:
        return reject("other-edition")
    if not synced and record.get("instrumental") is True and (not same_album or delta > 3):
        return reject("other-edition")
    return (same_isrc, full_credit, same_album, -delta, their_title == own_title)


def words_of(text, synced):
    if synced:
        text = "\n".join(line for _, line in parse_lrc(text))
    # Section headings are presentation, while repeated sung words remain
    # in order and contribute to the identity of a candidate.
    text = re.sub(r"^\s*\[[^\]\n]+\]\s*$", "", text, flags=re.M)
    return tuple(re.findall(r"\w+", folded(text)))


def choose_transcript(finalists, synced, strict):
    matches = {text for text, _ in finalists}
    if len(matches) == 1:
        return matches.pop()
    if synced:
        # Compare every corresponding line after parsing its effective
        # offset. A catalogue may hold several encodings of the same
        # alignment. Bound the spread across all variants to 100 ms;
        # identical words alone say nothing about their recorded timing.
        rows = [parse_lrc(text) for text in matches]
        words = {tuple(words_of(line, False) for _, line in variant) for variant in rows}
        word_stamps = {tuple(stamps) for text in matches if (stamps := WORD_STAMP.findall(text))}
        equivalent = (bool(matches) and all(rows) and len(words) == 1 and len(word_stamps) <= 1 and
                      all(round((max(t for t, _ in group) - min(t for t, _ in group)) * 1000) <= 100
                          for group in zip(*rows, strict=True)))
    else:
        equivalent = bool(matches) and "" not in matches and len({words_of(text, False) for text in matches}) == 1
    if equivalent:
        return min(matches, key=lambda text: (-len(WORD_STAMP.findall(text)) if synced else 0, text))
    if strict:
        raise AmbiguousLyrics("Textes ou repères divergents pour la même identité")
    return None


def audit_score(client, record, *signature, synced):
    def trace(item, reason):
        if client.gate.audit:
            client.gate.audit({"type": "candidate", **candidate_evidence(item, None, reason)})

    score = recording_score(record, *signature, synced=synced, isrc=getattr(client, "isrc", ""),
                            on_reject=trace)
    if score is not None:
        trace(record, "métadonnées-compatibles")
    return score


def resolve_conflict(entries, synced, local_text):
    # An exact lexical match to an existing local reference can eliminate
    # conflicting words. It cannot choose between different timings of
    # those same words. Corroboration needs two independent catalogues.
    groups = {}
    for item in entries:
        if item["decision"] != "compatible" or not item["text"]:
            continue
        text = item["text"]
        words = words_of(text, synced)
        if not words:
            continue
        timings = tuple((t, words_of(line, False)) for t, line in parse_lrc(text)) if synced else ()
        groups.setdefault((words, timings), []).append(item)
    if local_text:
        local_words = words_of(local_text, bool(parse_lrc(local_text)))
        matched = [group for (words, _), group in groups.items() if words == local_words]
        if len(matched) == 1:
            groups = {(): matched[0]}
        elif matched:
            return None, None
    supported = [group for group in groups.values()
                 if len({item["provider"] for item in group if item["provider"] != "lyrics.ovh"}) >= 2]
    if len(supported) != 1:
        if not local_text or len(groups) != 1 or () not in groups:
            return None, None
        supported = [groups[()]]
    chosen = min(supported[0], key=lambda item: -len(WORD_STAMP.findall(item["text"])) if synced else 0)
    return chosen["text"], chosen["provider"]


def usable_text(text, limit):
    if isinstance(text, str):
        text = text.strip()
        if text and "\x00" not in text and len(text.encode("utf-8")) <= limit:
            return text
    return None


def transcript(record, duration, synced, *, original_lrc=False):
    if record.get("instrumental") is True:
        return ""
    if synced and not original_lrc and record.get("hasWordSync") is True:
        if text := enhanced(record.get("lyricsfile"), duration):
            return text
    raw = record.get("syncedLyrics" if synced else "plainLyrics")
    text = usable_text(raw, MAX_LRC_BYTES if synced else 32_000)
    if synced and original_lrc and text is not None:
        # Validate the original bytes' length too: stripping whitespace may
        # have reduced the length of the string used for content validation.
        text = raw if len(raw.encode("utf-8")) <= MAX_LRC_BYTES else None
    if not synced and text is None:
        timed = transcript(record, duration, True)
        if timed:
            return usable_text("\n".join(line for _, line in parse_lrc(timed) if line), 32_000)
    if synced and text:
        timed = [stamp for stamp, line in parse_lrc(text) if line]
        if not timed or timed[-1] > duration + 3:
            return None
    return text


def catalog_transcript(raw, duration, *, synced, original_lrc=False):
    timed = transcript({"syncedLyrics": raw}, duration, True, original_lrc=original_lrc)
    if timed and not synced:
        return usable_text("\n".join(line for _, line in parse_lrc(timed) if line), 32_000)
    return timed


def available_transcript(candidates, fetch, client):
    ranked = sorted(candidates.items(), key=lambda item: item[1], reverse=True)
    for _, group in groupby(ranked[:8], key=lambda item: item[1]):
        found = [(identifier, lyrics) for identifier, _ in group if (lyrics := fetch(identifier))]
        if found:
            if hasattr(client, "candidates"):
                client.candidates.extend(candidate_evidence({"id": identifier}, lyrics, "compatible")
                                         for identifier, lyrics in found)
            return choose_transcript([(lyrics, {}) for _, lyrics in found],
                                     bool(parse_lrc(found[0][1])), getattr(client, "strict", False))
        if getattr(client, "failure", None):
            break
    return None


def verified_lyrics(record, title, artist, album, duration, album_artist, *, synced=False,
                    on_edition=None, isrc=""):
    if recording_score(record, title, artist, album, duration, album_artist,
                       on_edition=on_edition, isrc=isrc, synced=synced) is None:
        return None
    return transcript(record, duration, synced)


def best_transcript(records, title, artist, album, duration, album_artist, *, synced, strict=False,
                    on_edition=None, on_candidate=None, isrc="", on_reject=None, original_lrc=False):
    if not isinstance(records, list):
        return None
    candidates = []
    for record in records:
        score = recording_score(record, title, artist, album, duration, album_artist,
                                on_edition=on_edition, isrc=isrc, synced=synced, on_reject=on_reject)
        if score is not None:
            text = transcript(record, duration, synced, original_lrc=original_lrc)
            if text is not None:
                candidates.append((score, text, record))
            elif on_candidate:
                on_candidate(record, None, "format-indisponible")
    if not candidates:
        return None
    top = max(score for score, _, _ in candidates)
    finalists = [(text, record) for score, text, record in candidates if score == top]
    if on_candidate is not None:
        for text, record in finalists:
            on_candidate(record, text, "compatible")
    return choose_transcript(finalists, synced, strict)


def duration_seconds(path):
    output = command(
        ("ffprobe", "-v", "error", "-protocol_whitelist", "file,pipe",
         "-show_entries", "format=duration", "-of", "csv=p=0", str(path)),
        "durée illisible",
    )
    try:
        duration = round(float(output))
    except (ValueError, OverflowError) as error:
        raise ValueError("durée illisible") from error
    if not 1 <= duration <= 3600:
        raise ValueError("durée hors limites de LRCLIB")
    return duration


def track_version(path):
    info = path.lstat()
    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns


def stream_hashes(path):
    return command(
        ("ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "file,pipe",
         "-i", str(path), "-map", "0", "-c", "copy", "-f", "streamhash", "-hash", "sha256", "pipe:1"),
        "empreintes audio ou image indisponibles",
    )


def save_lyrics(path, version, tags, lyrics, publication_root=None, *, published=None):
    scope = "-metadata:s:a:0" if path.suffix.lower() in STREAM_TAGS else "-metadata"
    key = "lyrics-eng" if path.suffix.lower() == ".mp3" else "LYRICS"
    with TemporaryDirectory(dir=path.parent, prefix=".paroles-") as workspace:
        draft = Path(workspace) / path.name
        command(
            ("ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "file,pipe",
             "-i", str(path), "-map", "0", "-c", "copy", scope, f"{key}={lyrics}", str(draft)),
            "écriture du tag LYRICS échouée",
        )
        try:
            saved_tags, _ = probe(draft, include_duration=published is not None, include_codec=published is not None)
        except subprocess.CalledProcessError as error:
            raise ValueError("vérification des nouveaux tags impossible") from error
        if lyrics not in (saved_tags.get(key) for key in LYRICS_TAGS):
            raise ValueError("les paroles ne sont pas relues à l’identique")
        if any(saved_tags.get(key) != value for key, value in tags.items() if key != "encoder"):
            raise ValueError("des métadonnées existantes changeraient")
        original_hashes = stream_hashes(path)
        if not original_hashes or original_hashes != stream_hashes(draft):
            raise ValueError("les flux audio ou image changeraient")
        with shared_mutation(publication_root) if publication_root else nullcontext():
            if track_version(path) != version or path.resolve() != path:
                raise ValueError("fichier modifié pendant la recherche")
            shutil.copymode(path, draft)
            share_file(draft, path)
            os.replace(draft, path)
            current = track_version(path)
        if published is not None:
            published(current, saved_tags, version)
        return current


def save_lrc(path, lyrics, *, original=False):
    # The final create remains exclusive. In original mode the UTF-8
    # provider payload is the sidecar, including its existing newline bytes.
    with NamedTemporaryFile(dir=path.parent, prefix=".paroles-", mode="wb") as draft:
        draft.write((lyrics if original else lyrics + "\n").encode("utf-8"))
        draft.flush()
        os.fsync(draft.fileno())
        share_file(draft.name, path)
        try:
            os.link(draft.name, path)
        except FileExistsError:
            return False
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    return True


def currently_playing():
    output = command(("playerctl", "-p", "strawberry", "metadata", "xesam:url"),
                     "aucun morceau actif dans Strawberry")
    url = urlsplit(output.decode().strip())
    if url.scheme != "file" or url.netloc not in ("", "localhost"):
        raise ValueError("le morceau actif n’est pas un fichier local")
    return Path(unquote(url.path))


def selected_tracks(args, root):
    if args.tout:
        paths = [item for item in root.iterdir()
                 if item.name not in {INBOX, "YouTube"} and not item.name.startswith(".")]
    elif args.chemins:
        paths = [path.expanduser() for path in args.chemins]
        paths = [path if path.is_absolute() else root / path for path in paths]
    else:
        paths = [currently_playing()]

    tracks = set()
    for path in paths:
        if not path.exists() and not path.is_symlink() and path.is_relative_to(root):
            parts = path.relative_to(root).parts
            if len(parts) in (2, 3) and ".." not in parts:
                artist = canonical_album_artist(*parts[:2])
                if artist in {"Kurupt", "Wu-Tang Clan"} and artist != parts[0]:
                    path = root.joinpath(artist, *parts[1:])
        if path.is_symlink() or not path.exists() or not path.resolve().is_relative_to(root):
            raise ValueError(f"fichier ou dossier hors bibliothèque, symbolique ou introuvable : {path}")
        tracks.update(track.resolve() for track in audio_files(path))
    return sorted(tracks)


def retrieve_lyrics(path, client, tags, *, synced, registry=None):
    title, artist = tags.get("title"), tags.get("artist")
    if not title or not artist:
        raise ValueError("titre ou artiste manquant")
    local_text = next((tags[key] for key in LYRICS_TAGS if tags.get(key)), "")
    duration = round(tags.get("duration_seconds") or duration_seconds(path))
    if not 1 <= duration <= 3600:
        raise ValueError("durée hors limites de LRCLIB")
    client.new_track()
    client.start_form()
    return client.find(title, artist, tags.get("album"), duration, tags.get("albumartist"),
                       synced=synced, local_text=local_text, registry=registry, strict=bool(registry),
                       isrc=tags.get("isrc"), recording=(path, track_version(path)), original_lrc=synced)


def process_track(path, client, preview, synced=False, publication_root=None, registry=None):
    sidecar = path.with_suffix(".lrc")
    if synced and (sidecar.exists() or sidecar.is_symlink()):
        return "paroles synchronisées déjà présentes"
    if not synced and path.suffix.lower() not in STREAM_TAGS | FILE_TAGS:
        return "format non pris en charge"
    version = track_version(path)
    try:
        tags, _ = probe(path, include_duration=True)
    except subprocess.CalledProcessError as error:
        raise ValueError("lecture des tags échouée") from error
    if not synced and any(tags.get(key) for key in LYRICS_TAGS):
        return "paroles déjà intégrées"
    title = tags.get("title")
    artist = tags.get("artist")
    if not title or not artist:
        return "titre ou artiste manquant"
    if preview:
        return f"à rechercher · {artist} — {title}"
    lyrics, source = retrieve_lyrics(path, client, tags, synced=synced, registry=registry)
    if lyrics is None:
        return "aucune parole synchronisée vérifiable" if synced else "aucune parole vérifiable"
    if not lyrics:
        return "instrumental"
    if synced:
        with shared_mutation(publication_root) if publication_root else nullcontext():
            if track_version(path) != version or path.resolve() != path:
                raise ValueError("fichier modifié pendant la recherche")
            return (f"paroles synchronisées · fichier .lrc · {source}" if save_lrc(sidecar, lyrics, original=True)
                    else "paroles synchronisées déjà présentes")
    tags.pop("duration_seconds", None)
    save_lyrics(path, version, tags, lyrics, publication_root)
    return f"paroles intégrées · {source}"


def process_import_track(path, client, index, settings, excluded, locks, activity, strawberry, *,
                         notify=None, diagnostic=lambda _: None, audit=None):
    from _parole_index import SIDECAR, document, reference_proof, sidecar as read_sidecar
    from _parole_local_reference import SOURCE, local_reference

    version = track_version(path)
    with index.db() as db:
        row = db.execute("SELECT * FROM songs WHERE path=? AND token=?", (str(path), document(version))).fetchone()
    known = json.loads(row["info"]) if row else {}
    if known.get("file_tags") and not known.get("probe_error"):
        tags = {**known["tags"], "duration_seconds": row["duration"]}
        tags.pop("codec", None)
    else:
        tags, _ = probe(path, include_duration=True)
    duration = tags.pop("duration_seconds", 0.)
    title, artist, album, owner = (tags.get(key) for key in ("title", "artist", "album", "albumartist"))
    if audit:
        audit({"type": "metadata", "values": {key: (tags.get(key) or "")[:400]
               for key in ("title", "artist", "album", "albumartist", "isrc", "track")},
               "duration": duration if isfinite(duration) else None})
    if (owner or artist) in excluded:
        return "excluded", "excluded"
    if not title or not artist or not 1 <= duration <= 3600:
        diagnostic("métadonnées ou durée invalides")
        return "invalid", "invalid"
    duration = round(duration)
    local_text = next((tags[key] for key in LYRICS_TAGS if tags.get(key)), "")
    local_text = local_text or read_sidecar(path, ".txt")[1]
    if not local_text and strawberry and (version[2], version[3] // 10**9) == (strawberry["filesize"], strawberry["mtime"]):
        local_text = strawberry["lyrics"] or ""
    local_text = local_text or known.get("plain", "")
    lrc_path = path.with_suffix(".lrc")
    lrc_exists = lrc_path.exists() or lrc_path.is_symlink()
    lrc_text = read_sidecar(path, ".lrc")[1] if lrc_exists else ""
    lrc_present = bool(catalog_transcript(lrc_text, duration, synced=True))
    plain_present = bool(local_text.strip()) or lrc_present
    signature = (title, artist, album, duration, owner)
    context = contexts(tags)
    # The owner may process copies of the same recording in one batch.
    # Only the lookup is shared. Each publication checks its own file version.
    lock = locks[int.from_bytes(sha256(document(signature).encode()).digest()[:4]) % len(locks)]
    client.new_track()

    def lookup(synced, provider_only=None):
        if provider_only is None and row and (local := local_reference(index, row, synced=synced)):
            return "found", local.text, SOURCE, local
        with lock:
            client.start_form()
            activity(synced, 1)
            try:
                value, provider = client.find(*signature, synced=synced, local_text=local_text,
                                              registry=index, strict=True, context=context, provider_only=provider_only,
                                              isrc=tags.get("isrc"), recording=(path, version), audit=audit,
                                              original_lrc=synced)
            except ServiceUnavailable as error:
                diagnostic(error.reason)
                return ("limited" if error.reason == "limited" else "temporary"), None, None, None
            except AmbiguousLyrics:
                diagnostic("correspondance ambiguë")
                return "review", None, None, None
            finally:
                activity(synced, -1)
            return ("missing" if value is None else "found" if value else "instrumental"), value, provider, None

    def publish(suffix, text, provider, donor):
        try:
            with shared_mutation(index.root):
                if track_version(path) != version or path.resolve() != path or donor and not donor.current():
                    raise ValueError("fichier de référence modifié pendant la recherche")
                # Publishing by exclusive hard link keeps existing sidecars,
                # including one created by another worker during the lookup.
                timed = suffix == ".lrc"
                saved = save_lrc(path.with_suffix(suffix), text if timed else text.strip(), original=timed)
                proof = reference_proof(path, suffix, version, provider,
                                        external=suffix == ".lrc" and provider not in ("Strawberry", SOURCE))
            if saved and notify:
                notify(path, SIDECAR, proof)
            if saved and audit:
                audit({"type": "publication", "provider": provider, "form": "lrc" if suffix == ".lrc" else "lyrics"})
        except (OSError, ValueError) as error:
            diagnostic(str(error))
            return "temporary"
        if not saved:
            contents = read_sidecar(path, suffix)[1]
            valid = catalog_transcript(contents, duration, synced=True) if suffix == ".lrc" else contents.strip()
            return "present" if valid else "review"
        return "found"

    if lrc_exists:
        timed = "present" if lrc_present else "review"
    elif not settings["lrc"]:
        timed = "missing"
    elif embedded := catalog_transcript(local_text, duration, synced=True, original_lrc=True):
        timed = publish(".lrc", embedded, "Strawberry", None)
    else:
        timed, lrc, provider, donor = lookup(True)
        if lrc:
            timed = publish(".lrc", lrc, provider, donor)
    if plain_present:
        return "present", timed
    if timed in ("found", "present"):
        # A verified LRC already contains the complete lyric text.
        return timed, timed
    if not settings["lyrics"]:
        return "missing", timed
    text_path = path.with_suffix(".txt")
    if text_path.exists() or text_path.is_symlink():
        diagnostic("fichier texte existant à vérifier")
        return "review", timed
    plain, text, provider, donor = lookup(False)
    if not text and row:
        from _parole_unison import discover

        discover(index, row, tags.get("isrc"), lambda data: (
            normalized(data.get("song")) == normalized(title)
            and credits(data.get("artist")) == credits(artist)))
    if text:
        if not local_text and settings["lrc"] and not lrc_exists and index.source_enabled("LyricDown"):
            # LyricDown verifies its timed text against the supplied words.
            # This provider can only run after acquiring a usable text.
            local_text = text
            assisted, lrc, timed_provider, _ = lookup(True, provider_only="LyricDown")
            if lrc:
                timed = publish(".lrc", lrc, timed_provider, None)
                if timed in ("found", "present"):
                    return timed, timed
            elif assisted in ("limited", "temporary") and timed == "missing":
                timed = assisted
        plain = publish(".txt", text, provider, donor)
    return plain, timed


def run(tracks, root, preview, synced, tracking=False, publication_root=None):
    clients = local()
    registry = None if preview else registered_sources(root)
    workers = 1 if preview or publication_root else min(TRACK_WORKERS, len(tracks))
    activity_lock = Lock()
    active = 0

    def activity(delta):
        nonlocal active
        if tracking:
            with activity_lock:
                active += delta
                print(f"KARA_ACTIVITE {active} {workers}", flush=True)

    def work(track):
        activity(1)
        try:
            if not preview and not hasattr(clients, "source"):
                clients.source = LyricsSources()
            return track, process_track(track, getattr(clients, "source", None), preview, synced, publication_root, registry), False
        except ServiceUnavailable as error:
            return track, str(error), True
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            return track, f"erreur : {getattr(error, 'strerror', None) or error}", True
        finally:
            activity(-1)

    def publish(results):
        failures = 0
        for track, message, failed in results:
            print(f"{track.relative_to(root)} · {message}", file=sys.stderr if failed else sys.stdout, flush=True)
            failures += failed
        return int(bool(failures))

    if workers <= 1:
        return publish(map(work, tracks))
    with ThreadPoolExecutor(max_workers=workers) as pool:
        def batches():
            paths = iter(tracks)
            while batch := tuple(islice(paths, workers * 2)):
                yield from pool.map(work, batch)
        return publish(batches())


def registered_sources(root):
    from _parole_index import Index
    from _parole_sources import seed

    index = Index(root)
    seed(index)
    return index


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("chemins", nargs="*", type=Path,
                        help="fichiers ou dossiers dans ~/Music, morceau actif par défaut")
    parser.add_argument("--tout", action="store_true", help="parcourt toute la bibliothèque classée")
    parser.add_argument("--synchro", action="store_true", help="enregistre les paroles minutées dans un fichier .lrc")
    parser.add_argument("--apercu", "--dry-run", action="store_true", help="affiche les pistes, sans requête ni écriture")
    parser.add_argument("--bibliotheque", type=Path, default=LIBRARY)
    parser.add_argument("--suivi-activite", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--lrc-stdout", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.tout and args.chemins:
        parser.error("--tout ou des chemins explicites sont attendus")
    root = args.bibliotheque.expanduser().resolve()
    if not root.is_dir():
        parser.error(f"bibliothèque introuvable : {root}")
    if args.lrc_stdout:
        # Preparation retrieves a candidate without taking a mutation lock or
        # writing to the library. Turbo must still validate the exact recording.
        if args.tout or len(args.chemins) != 1 or not args.chemins[0].is_file():
            parser.error("un fichier audio est requis")
        path = args.chemins[0].resolve()
        if not path.is_relative_to(root):
            parser.error("le fichier est hors de la bibliothèque")
        try:
            tags, _ = probe(path, include_duration=True)
            lyrics, source = retrieve_lyrics(path, LyricsSources(), tags, synced=True, registry=registered_sources(root))
        except (OSError, ValueError, ServiceUnavailable, subprocess.SubprocessError) as error:
            parser.exit(1, f"{error}\n")
        if not lyrics:
            parser.exit(1, "Aucune parole minutée vérifiable.\n")
        print(json.dumps({"lyrics": lyrics, "provider": source}, ensure_ascii=False))
        return 0
    def process_selection(publication_root=None):
        try:
            with shared_mutation(publication_root) if publication_root else nullcontext():
                tracks = selected_tracks(args, root)
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            parser.error(str(error))
        if args.suivi_activite:
            print(f"KARA_TOTAL {len(tracks)}", flush=True)
        if not tracks:
            print("Aucune piste audio à traiter.")
            return 0
        return run(tracks, root, args.apercu, args.synchro, args.suivi_activite, publication_root)

    if args.apercu:
        return process_selection()
    if root == SHARED_LIBRARY:
        # Network and remuxing run outside the shared library critical section.
        os.environ.setdefault("KARA_SHARED_WAIT", "texte")
        os.environ.setdefault("KARA_IMPORT_PROCESSING", "1")
        return process_selection(root)

    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "paroles-musique"
    state.mkdir(parents=True, exist_ok=True)
    with (state / "lock").open("a") as lock:
        try:
            flock(lock, LOCK_EX | LOCK_NB)
        except BlockingIOError:
            parser.error("une recherche de paroles est déjà en cours")
        return process_selection()


if __name__ == "__main__":
    raise SystemExit(main())
